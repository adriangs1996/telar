+const std = @import("std");
+const core = @import("telar-core");
+const data = @import("model");
+const native = @import("../native/native.zig");
+const Renderer = @import("../render/TerminalRenderer.zig");
+const PanePaint = @import("../render/PanePaint.zig");
+
+// Every mutation gets two preparations: one rebuild, then one genuine cache hit.
+// The independent renderer disables only pane reuse and keeps the cell algorithm.
+test "pane cache preserves geometry through visual and identity invalidations and retries" {
+    var cached = Renderer.init(std.testing.allocator);
+    defer cached.deinit();
+    var reference = Renderer.init(std.testing.allocator);
+    defer reference.deinit();
+    const viewport: native.Viewport = .{ .width = 400, .height = 300, .scale = 1 };
+    const size = try cached.measure(viewport);
+    try std.testing.expect(cached.pane_draws.limit > 0);
+    _ = try reference.measure(viewport);
+    var pane = try data.Pane.init(std.testing.allocator, .{
+        .spec = .{
+            .pane_id = @enumFromInt(1),
+            .location = .{
+                .workspace = .{ .workspace = @enumFromInt(1) },
+                .tab_id = @enumFromInt(1),
+            },
+            .size = size,
+        },
+        .attached = true,
+    });
+    defer pane.deinit();
+    pane.attachment_generation = 1;
+    pane.applied_frame_id = 1;
+    pane.pending_frame_id = 1;
+    pane.cursor = .{ .visible = true };
+    for (pane.buffer.cells) |*cell| {
+        cell.bytes[0] = 'a';
+        cell.style.flags.italic = true;
+        cell.style.flags.underline = .single;
+    }
+
+    var paint: PanePaint = .{
+        .pane = &pane,
+        .view = .{
+            .pane_id = pane.id,
+            .outer = .{ .w = size.cols, .h = size.rows },
+            .content = .{ .w = size.cols, .h = size.rows },
+            .focused = true,
+            .display_index = 1,
+        },
+    };
+    const Change = enum { initial, cell, cursor, blink, window_focus, pane_focus, selection, scroll, hide, cursor_color, cursor_ink, palette, origin, geometry, attachment, generation, location, resources, shape, font, detached, reattached };
+    inline for (std.meta.tags(Change)) |change| {
+        switch (change) {
+            .initial => {},
+            .cell => {
+                pane.buffer.cells[0].bytes[0] = 'z';
+                pane.applied_frame_id += 1;
+            },
+            .cursor => pane.cursor.x = 1,
+            .blink => cached.cursor_on = false,
+            .window_focus => {
+                cached.cursor_on = true;
+                cached.focused = false;
+            },
+            .pane_focus => paint.view.focused = false,
+            .selection => {
+                paint.view.focused = true;
+                paint.copy = .{
+                    .cursor = .{ .x = 3, .y = 2 },
+                    .anchor = .{ .x = 0, .y = 0 },
+                    .linewise = false,
+                };
+            },
+            .scroll => pane.scroll.offset = 1,
+            .hide => paint.hide_cursor = true,
+            .cursor_color => {
+                paint.hide_cursor = false;
+                cached.theme.cursor_color = .{ 255, 0, 0 };
+            },
+            .cursor_ink => cached.theme.cursor_text_color = .{ 0, 0, 255 },
+            .palette => cached.theme.palette[0] = .{ 42, 42, 42 },
+            .origin => cached.origin[0] += 1,
+            .geometry => paint.view.content.w -= 1,
+            .attachment => {
+                pane.attachment_generation += 1;
+                pane.buffer.cells[0].bytes[0] = 'b';
+            },
+            .generation => pane.pane_generation += 1,
+            .location => pane.location.tab_id = @enumFromInt(2),
+            .resources => {
+                cached.retained.invalidate();
+                reference.retained.invalidate();
+            },
+            .shape => {
+                cached.focused = true;
+                paint.copy = null;
+                cached.config.cursor.style = .bar;
+            },
+            .font => {
+                cached.scale = 0;
+                reference.scale = 0;
+                cached.config.font.size = 15;
+                reference.config.font.size = 15;
+                const measured = try cached.measure(viewport);
+                _ = try reference.measure(viewport);
+                paint.view.content.w = @min(paint.view.content.w, measured.cols);
+                paint.view.content.h = @min(paint.view.content.h, measured.rows);
+            },
+            .detached => pane.attached = false,
+            .reattached => {
+                pane.attached = true;
+                pane.attachment_generation += 1;
+            },
+        }
+
+        reference.cursor_on = cached.cursor_on;
+        reference.focused = cached.focused;
+        reference.theme = cached.theme;
+        reference.origin = cached.origin;
+        reference.config.cursor = cached.config.cursor;
+        // Keep room for the selected cell's background as well as ink/underline.
+        try cached.pane_draws.reserve(@as(usize, size.cols) * size.rows * 2);
+        reference.pane_draws.limit = 0;
+        reference.pane_draws.counts = @splat(0);
+        for (0..2) |attempt| {
+            cached.begin();
+            reference.begin();
+            try cached.drawPane(paint);
+            try reference.drawPane(paint);
+            cached.seal();
+            reference.seal();
+            try std.testing.expectEqualSlices(u8, std.mem.sliceAsBytes(reference.quads.items()), std.mem.sliceAsBytes(cached.quads.items()));
+            try std.testing.expectEqualSlices(u8, reference.atlas.?.pixels, cached.atlas.?.pixels);
+            try std.testing.expectEqual(@as(usize, if (attempt == 1 and pane.attached) 1 else 0), cached.pane_draws.hits);
+            // Preparation and cache hits must never retire pending presentation.
+            try std.testing.expectEqual(@as(u64, 1), pane.pending_frame_id);
+        }
+    }
+
+    // A full destination must fail rather than drop geometry; the following
+    // preparation can rebuild/reuse safely without an acknowledgement.
+    cached.begin();
+    const saved_limit = cached.quads.limit;
+    cached.quads.limit = 0;
+    try std.testing.expectError(error.NativeQuadBudgetExceeded, cached.drawPane(paint));
+    try std.testing.expectEqual(@as(usize, 0), cached.quads.items().len);
+    cached.quads.limit = saved_limit;
+    cached.begin();
+    try cached.drawPane(paint);
+    try std.testing.expectEqualSlices(u8, std.mem.sliceAsBytes(reference.quads.items()), std.mem.sliceAsBytes(cached.quads.items()));
+}
