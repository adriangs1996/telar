+//! Optional renderer-owned copies of the previous preparation's pane quads.
+//! Two bounded buffers avoid retaining model pointers or any GPU frame storage.
+//! Missing entries and quota exhaustion always fall back to cell drawing.
+const std = @import("std");
+const core = @import("telar-core");
+const quad = @import("Quad.zig");
+const Key = @import("PaneDrawKey.zig");
+const Entry = @import("PaneDrawEntry.zig");
+const max_bytes_per_buffer = 4 * 1024 * 1024;
+const quads_per_cell = 2;
+const buffer_count = 2;
+
+const Cache = @This();
+
+allocator: std.mem.Allocator,
+quads: [buffer_count]std.ArrayList(quad.Quad) = @splat(.empty),
+entries: [buffer_count][core.max_panes_per_tab]Entry = undefined,
+counts: [buffer_count]usize = @splat(0),
+current: u1 = 0,
+limit: usize = 0,
+hits: usize = 0,
+copied_bytes: usize = 0,
+
+pub fn init(allocator: std.mem.Allocator) Cache {
+    return .{ .allocator = allocator };
+}
+
+pub fn deinit(self: *Cache) void {
+    for (&self.quads) |*items| {
+        items.deinit(self.allocator);
+    }
+}
+
+/// Only geometry changes reserve storage. Failure disables reuse until the next
+/// successful reservation; drawing remains usable. Example: `try cache.reserve(cells);`
+pub fn reserve(self: *Cache, cells: usize) !void {
+    const bounded_cells: usize = @min(cells, max_bytes_per_buffer / @sizeOf(quad.Quad) / quads_per_cell);
+    const limit = bounded_cells * quads_per_cell;
+    errdefer {
+        self.limit = 0;
+        self.counts = @splat(0);
+    }
+
+    for (&self.quads) |*items| {
+        try items.ensureTotalCapacityPrecise(self.allocator, limit);
+    }
+
+    self.limit = limit;
+}
+
+/// Advances preparation, including retries, without acknowledging delivery.
+/// Example: `cache.begin();`
+pub fn begin(self: *Cache) void {
+    self.current ^= 1;
+    self.quads[self.current].clearRetainingCapacity();
+    self.counts[self.current] = 0;
+    self.hits = 0;
+    self.copied_bytes = 0;
+}
+
+/// Borrows cached quads until the next begin/reserve/deinit. Example: `cache.find(key)`.
+pub fn find(self: *Cache, key: Key) ?[]const quad.Quad {
+    const previous = self.current ^ 1;
+    for (self.entries[previous][0..self.counts[previous]]) |entry| {
+        if (std.meta.eql(entry.key, key)) {
+            self.hits += 1;
+            self.copied_bytes += entry.len * @sizeOf(quad.Quad);
+            return self.quads[previous].items[entry.offset..][0..entry.len];
+        }
+    }
+
+    return null;
+}
+
+/// Copies successful pane output if it fits; a miss never grows storage.
+/// Example: `cache.store(key, renderer.quads.items()[first..]);`
+pub fn store(self: *Cache, key: Key, items: []const quad.Quad) void {
+    const index = self.current;
+    const target = &self.quads[index];
+    if (self.limit == 0 or self.counts[index] == core.max_panes_per_tab or items.len > self.limit -| target.items.len) {
+        return;
+    }
+
+    self.entries[index][self.counts[index]] = .{
+        .key = key,
+        .offset = target.items.len,
+        .len = items.len,
+    };
+    target.appendSliceAssumeCapacity(items);
+    self.counts[index] += 1;
+    self.copied_bytes += items.len * @sizeOf(quad.Quad);
+}
+
+test "cache is bounded, owns copies, and forgets absent panes after one preparation" {
+    var cache = Cache.init(std.testing.allocator);
+    defer cache.deinit();
+    try cache.reserve(1);
+    const location: core.TabLocation = .{ .workspace = .{ .workspace = @enumFromInt(1) }, .tab_id = @enumFromInt(1) };
+    const key = std.mem.zeroInit(Key, .{ .location = location });
+    var items = [_]quad.Quad{std.mem.zeroes(quad.Quad)};
+    cache.begin();
+    cache.store(key, &items);
+    items[0].x = 9;
+    cache.begin();
+    try std.testing.expectEqual(@as(f32, 0), cache.find(key).?[0].x);
+    cache.begin();
+    try std.testing.expect(cache.find(key) == null);
+    const oversized = [_]quad.Quad{items[0]} ** 3;
+    cache.store(key, &oversized);
+    cache.begin();
+    try std.testing.expect(cache.find(key) == null);
+    try cache.reserve(std.math.maxInt(usize));
+    for (cache.quads) |items_buffer| {
+        try std.testing.expect(items_buffer.capacity * @sizeOf(quad.Quad) <= max_bytes_per_buffer);
+    }
+}
+
+test "either reservation failure disables cache and releases partial allocations" {
+    try std.testing.checkAllAllocationFailures(std.testing.allocator, reserveWithFailures, .{});
+}
+
+fn reserveWithFailures(allocator: std.mem.Allocator) !void {
+    var cache = Cache.init(allocator);
+    defer cache.deinit();
+    cache.reserve(32) catch |err| {
+        try std.testing.expectEqual(@as(usize, 0), cache.limit);
+        try std.testing.expectEqual(@as(usize, 0), cache.counts[0] + cache.counts[1]);
+        return err;
+    };
+}
