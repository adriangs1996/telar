+var evict_scratch: ?[]u8 = null;
+var cold_spent_ns: u64 = 0;
+var cold_clock_ns: u64 = 0;
+var cold_flushes: u64 = 0;
+
+fn launder(pointer: anytype) @TypeOf(pointer) {
+    var value = pointer;
+    std.mem.doNotOptimizeAway(&value);
+    return value;
+}
+
+noinline fn evictCache(scratch: []u8) u64 {
+    var sum: u64 = 0;
+    var index: usize = 0;
+    while (index < scratch.len) : (index += 64) {
+        sum +%= scratch[index];
+    }
+
+    return sum;
+}
+
 fn runIdleDelivery(context: *IdleDeliveryContext, iterations: usize) !u64 {
+    if (evict_scratch) |scratch| {
+        var checksum: u64 = 0;
+        for (0..iterations) |_| {
+            checksum +%= evictCache(launder(scratch));
+            const start = timestamp(context.io);
+            try context.idle.flush();
+            cold_spent_ns += timestamp(context.io) - start;
+
+            checksum +%= evictCache(launder(scratch));
+            const empty = timestamp(context.io);
+            cold_clock_ns += timestamp(context.io) - empty;
+        }
+
+        cold_flushes += iterations;
+        std.mem.doNotOptimizeAway(checksum);
+        if (!context.idle.quiet()) {
+            return error.IdleDeliveryStartedWrite;
+        }
+
+        return iterations;
+    }
