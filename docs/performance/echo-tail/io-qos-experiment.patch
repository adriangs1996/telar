diff --git a/src/core/echo_trace.zig b/src/core/echo_trace.zig
index 47f8a35..6e6fd70 100644
--- a/src/core/echo_trace.zig
+++ b/src/core/echo_trace.zig
@@ -32,6 +32,26 @@ pub const Tag = enum {
     host_flush_done,
 };
 
+pub const ExperimentQos = struct {
+    previous: c_uint,
+    changed: bool,
+
+    extern "c" fn qos_class_self() c_uint;
+    extern "c" fn pthread_set_qos_class_self_np(qos: c_uint, priority: c_int) c_int;
+
+    pub fn enter() ExperimentQos {
+        const previous = qos_class_self();
+        const changed = previous != 0 and previous != 0x21 and pthread_set_qos_class_self_np(0x21, 0) == 0;
+        return .{ .previous = previous, .changed = changed };
+    }
+
+    pub fn restore(scope: ExperimentQos) void {
+        if (scope.changed) {
+            _ = pthread_set_qos_class_self_np(scope.previous, 0);
+        }
+    }
+};
+
 pub const Recorder = struct {
     const capacity = 16384;
     const Record = struct { ns: u64, tag: Tag };
