// Generated by CMakeLists.txt from the scripts that complete a line as each shell would, for the
// namespace the modules of telar.runtime.terminal.shell_completion declare around them.
inline constexpr std::string_view zsh = R"TELAR_SHELL(@TELAR_COMPLETION_ZSH@)TELAR_SHELL";
inline constexpr std::string_view bash = R"TELAR_SHELL(@TELAR_COMPLETION_BASH@)TELAR_SHELL";
inline constexpr std::string_view fish = R"TELAR_SHELL(@TELAR_COMPLETION_FISH@)TELAR_SHELL";
// What a host `ssh` reached runs to answer, before the script of its shell.
inline constexpr std::string_view remote = R"TELAR_SHELL(@TELAR_COMPLETION_REMOTE@)TELAR_SHELL";
