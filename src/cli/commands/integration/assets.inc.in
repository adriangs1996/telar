// Generated by cmake/integration.cmake from integration/assets: the files integration
// installs, for the namespace telar.cli.commands.integration.settings declares around them.
constexpr std::string_view pi_extension = R"TelarAsset(@TELAR_PI_INTEGRATION@)TelarAsset";
constexpr std::string_view opencode_extension = R"TelarAsset(@TELAR_OPENCODE_INTEGRATION@)TelarAsset";
constexpr std::string_view telar_skill = R"TelarAsset(@TELAR_AGENT_SKILL@)TelarAsset";
constexpr std::string_view coordinator_skill = R"TelarAsset(@TELAR_COORDINATOR_SKILL@)TelarAsset";
// What installs, removes or reports the Neovim telar provisions: a shell script, its action first.
constexpr std::string_view editor_installer = R"TelarAsset(@TELAR_EDITOR_INSTALLER@)TelarAsset";

// A file of telar's Neovim integration, by its path under Neovim's site directory.
struct NeovimFile {
  std::string_view path;
  std::string_view text;
};

inline constexpr NeovimFile neovim_files[]{
@TELAR_NEOVIM_FILES@};
