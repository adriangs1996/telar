# The configuration check validates icons with libghostty-vt.
include("${CMAKE_CURRENT_LIST_DIR}/../../../cmake/deps/ghostty.cmake")
file(REAL_PATH "${CMAKE_CURRENT_LIST_DIR}/../../../lib/config/bootstrap.lua" telar_window_config_bootstrap_file)
file(READ "${telar_window_config_bootstrap_file}" TELAR_WINDOW_CONFIG_BOOTSTRAP)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${telar_window_config_bootstrap_file}")
configure_file("${CMAKE_CURRENT_LIST_DIR}/../config/bootstrap.inc.in" "${CMAKE_CURRENT_BINARY_DIR}/generated/window_config_bootstrap.inc" @ONLY)
target_sources(telar PRIVATE window/window.cpp)
add_executable(telar-config-check config_check_main.cpp tab/config_check.cpp)
target_include_directories(telar-config-check PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated")
target_link_libraries(telar-config-check PRIVATE cli-window cli-tab telar::config deps::ghostty_vt)
set_target_properties(telar-config-check PROPERTIES RUNTIME_OUTPUT_DIRECTORY "$<TARGET_FILE_DIR:telar>")
add_dependencies(telar telar-config-check)
install(TARGETS telar-config-check RUNTIME DESTINATION bin)
