include_guard(GLOBAL)

# The module ABI, diagnostics layouts and toolchain are selected once per build.
# Importers cannot change a compiled interface with their own preprocessor flags.
set(CMAKE_CXX_STANDARD 23)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
set(CMAKE_CXX_SCAN_FOR_MODULES ON)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
foreach(legacy IN ITEMS TELAR_RUNTIME_DIAGNOSTICS)
  if(${legacy})
    set(TELAR_DIAGNOSTICS ON CACHE BOOL "Build-wide diagnostics variant" FORCE)
  endif()
endforeach()
foreach(legacy IN ITEMS TELAR_RUNTIME_SANITIZERS TELAR_GUI_SANITIZERS TELAR_AUTH_SANITIZERS WEBSOCK_SANITIZERS EBNF_SANITIZERS)
  if(${legacy})
    set(TELAR_SANITIZERS ON CACHE BOOL "Build-wide sanitizer variant" FORCE)
  endif()
endforeach()
option(TELAR_DIAGNOSTICS "Enable allocation and timing diagnostics outside Debug" OFF)
option(TELAR_SANITIZERS "Instrument all owned C++ targets with ASan/UBSan" OFF)

if(NOT CMAKE_GENERATOR STREQUAL "Ninja")
  message(FATAL_ERROR "Telar C++ modules require Ninja; run python3 tools/bootstrap-cpp.py and configure with -G Ninja")
endif()
if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang" OR CMAKE_CXX_COMPILER_VERSION VERSION_LESS 23.1.5)
  message(FATAL_ERROR "Telar requires LLVM Clang 23.1.5 or newer. Use the pinned tools/bootstrap-cpp.py toolchain (AppleClang cannot scan these modules).")
endif()

add_compile_definitions(TELAR_DEBUG=$<CONFIG:Debug>
  TELAR_DIAGNOSTICS=$<OR:$<CONFIG:Debug>,$<BOOL:${TELAR_DIAGNOSTICS}>>)
if(TELAR_SANITIZERS)
  add_compile_options("$<$<COMPILE_LANGUAGE:C,CXX>:-fsanitize=address,undefined;-fno-omit-frame-pointer>")
  add_link_options(-fsanitize=address,undefined)
endif()

# Keep the file set visible to CMake so scanning, transitive ordering and
# installed consumers use the native module graph rather than custom BMI rules.
function(telar_modules target)
  file(GLOB_RECURSE interfaces CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/*.cppm")
  list(FILTER interfaces EXCLUDE REGEX "/(tests|tools|vendor|out[^/]*|CMakeFiles)/")
  include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/module_platforms.cmake")
  get_filename_component(repository "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
  if(APPLE)
    set(excluded ${TELAR_LINUX_MODULES})
  else()
    set(excluded ${TELAR_MACOS_MODULES})
  endif()
  foreach(source IN LISTS excluded)
    list(REMOVE_ITEM interfaces "${repository}/${source}")
  endforeach()
  if(NOT interfaces)
    message(FATAL_ERROR "No module interfaces for ${target}")
  endif()
  target_sources(${target} PUBLIC FILE_SET CXX_MODULES BASE_DIRS "${CMAKE_CURRENT_SOURCE_DIR}" FILES ${interfaces})
  target_compile_features(${target} PUBLIC cxx_std_23)
  target_compile_definitions(${target} PUBLIC TELAR_DEBUG=$<CONFIG:Debug>
    TELAR_DIAGNOSTICS=$<OR:$<CONFIG:Debug>,$<BOOL:${TELAR_DIAGNOSTICS}>>)
  if(TELAR_SANITIZERS)
    target_compile_options(${target} PUBLIC -fsanitize=address,undefined -fno-omit-frame-pointer)
    target_link_options(${target} PUBLIC -fsanitize=address,undefined)
  endif()
  set_target_properties(${target} PROPERTIES POSITION_INDEPENDENT_CODE ON)
endfunction()
