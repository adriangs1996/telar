#!/usr/bin/env python3
"""One pinned toolchain entry point for development, CI and release builds.

    tools/cpp configure [PRESET] [-B DIR] [--headless] [-- CMAKE_ARGUMENT...]
    tools/cpp build [PRESET] [-B DIR] [-- BUILD_ARGUMENT...]
    tools/cpp test [PRESET] [-B DIR] [-- CTEST_ARGUMENT...]
    tools/cpp exec -- COMMAND ARGUMENT...

PRESET is a configure preset of CMakePresets.json, dev by default, and its tree is
out/PRESET unless -B names another. tbc in its place is the tbc linter, a project of
its own under lib/tbc whose build type --config selects.
"""
import argparse
import fcntl
import hashlib
import json
import os
import platform
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
PRESETS_FILE = ROOT / 'CMakePresets.json'
# The tree of the repository is configured by a preset of CMakePresets.json into
# out/<preset>; the tbc linter is a project of its own.
PRESETS = tuple(preset['name'] for preset in json.loads(PRESETS_FILE.read_text())['configurePresets']
                if not preset.get('hidden'))
TBC = 'tbc'
CACHE = ROOT / '.toolchain'
# The builds of every checkout of this user take their slots here.
SLOTS = Path(os.environ.get('XDG_CACHE_HOME') or Path.home() / '.cache') / 'telar/build-slots'
BUILD_SLOTS = 64


def run(*args, **kwargs):
    subprocess.run([str(arg) for arg in args], check=True, **kwargs)


def toolchain():
    expected = hashlib.sha256(b''.join((ROOT / name).read_bytes() for name in ('tools/toolchain/manifest.json', 'tools/bootstrap-cpp.py', 'tools/toolchain/source.py'))).hexdigest()
    stamp = CACHE / '.manifest'
    refresh = not stamp.exists() or stamp.read_text().strip() != expected
    if platform.system() == 'Darwin':
        sdk = ''.join(subprocess.check_output(['xcrun', '--sdk', 'macosx', option], text=True)
                      for option in ('--show-sdk-path', '--show-sdk-build-version'))
        sdk_stamp = CACHE / '.sdk'
        refresh = refresh or not sdk_stamp.exists() or sdk_stamp.read_text() != sdk
    if refresh:
        run(sys.executable, ROOT / 'tools/bootstrap-cpp.py')
    os.environ['PATH'] = str(CACHE / 'bin') + os.pathsep + os.environ['PATH']
    return CACHE / 'toolchain.cmake'


def vt():
    manifest = json.loads((ROOT / 'tools/toolchain/manifest.json').read_text())
    zig = CACHE / ('zig-' + manifest['versions']['zig'])
    CACHE.mkdir(exist_ok=True)
    with (CACHE / '.vt-lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        recipe = ROOT / 'src/runtime'
        identity = hashlib.sha256()
        for file in ('tools/build_ghostty.py', 'vendor/ghostty-vt-state.patch', 'vendor/wuffs-codec.json'):
            identity.update((recipe / file).read_bytes())
        identity.update(manifest['versions']['zig'].encode())
        identity.update((platform.system() + platform.machine()).encode())
        if platform.system() == 'Darwin':
            identity.update(subprocess.check_output(['xcrun', '--sdk', 'macosx', '--show-sdk-build-version']))
        build = ROOT / '.dependencies-cache/ghostty' / identity.hexdigest()
        prefix = build / 'install'
        os.environ['ZIG_GLOBAL_CACHE_DIR'] = str(CACHE / 'zig-cache')
        complete = build / '.complete'
        if not complete.exists() or not all((prefix / path).is_file() for path in
                                            ('lib/libghostty-vt.a', 'include/ghostty/vt.h', 'include/ghostty/wuffs-v0.4.h')):
            # Zig is needed only to build the library, so a cached build skips its download.
            if not (zig / '.complete').exists():
                run(ROOT / 'packaging/release/install-zig.sh', zig, manifest['versions']['zig'])
                (zig / '.complete').touch()
            run(sys.executable, recipe / 'tools/build_ghostty.py', '--zig', zig / 'zig', '--build-dir', build, '--prefix', prefix)
            complete.write_text(identity.hexdigest() + '\n')
        return prefix


def lock_build(directory):
    """Serialize builds of one tree until this process and its children exit.

    Two Ninja processes sharing a tree corrupt its deps log. Ninja keeps the bad
    record when it recovers, so every later build of the tree starts from nothing.
    """
    if not directory.is_dir():
        return
    lock = os.open(directory / '.telar-build-lock', os.O_CREAT | os.O_WRONLY, 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print(f'Waiting for another build of {directory}', file=sys.stderr, flush=True)
        fcntl.flock(lock, fcntl.LOCK_EX)
    os.set_inheritable(lock, True)


def build_slot(directory):
    """Take the lowest free build slot of this machine until this process and its children exit.

    A tree schedules its own compilations, one per core where memory allows, and knows nothing of
    the builds of other checkouts: three at once start three times the jobs the machine has cores
    for. A slot is a lock on a file of `directory`, which the checkouts of one user share, so the
    kernel frees it however the build ends. Returns the slot, 0 for a build that found none taken,
    and the descriptor that holds it; 0 and no descriptor where the directory cannot be used.
    """
    try:
        directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        for index in range(BUILD_SLOTS):
            slot = os.open(directory / str(index), os.O_CREAT | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
            try:
                fcntl.flock(slot, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                os.close(slot)
                continue
            os.set_inheritable(slot, True)
            return index, slot
    except OSError:
        pass
    return 0, None


def shared(arguments, slot, cores):
    """The arguments of a build in `slot`: its own when it is the first or names how many jobs it
    runs, and otherwise with the cores divided by its place among the builds that are running."""
    if slot == 0 or any(argument.startswith(('--parallel', '-j')) for argument in arguments):
        return arguments
    jobs = max(1, cores // (slot + 1))
    print(f'Other builds are running on this machine: {jobs} job{"s" if jobs > 1 else ""} at a time', file=sys.stderr, flush=True)
    at = arguments.index('--') if '--' in arguments else len(arguments)
    return [*arguments[:at], '--parallel', str(jobs), *arguments[at:]]


def main():
    if len(sys.argv) > 1 and sys.argv[1] == 'exec':
        extra = sys.argv[2:]
        if extra and extra[0] == '--':
            extra = extra[1:]
        if not extra:
            raise SystemExit('Use tools/cpp exec -- COMMAND ARG...')
        toolchain()
        if extra[:2] == ['cmake', '--build'] and len(extra) > 2:
            lock_build(Path(extra[2]))
        os.execvp(extra[0], extra)
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('command', choices=('bootstrap', 'vt', 'configure', 'build', 'test', 'exec'))
    parser.add_argument('preset', nargs='?', choices=(*PRESETS, TBC),
                        help='a configure preset of CMakePresets.json (default dev), or tbc for the linter project')
    parser.add_argument('-B', '--build-dir', type=Path, help='the tree; out/<preset> by default')
    parser.add_argument('--config', choices=('Debug', 'Release', 'RelWithDebInfo'), default='Debug',
                        help='the build type of the tbc project; a preset names its own')
    parser.add_argument('--headless', action='store_true', help='without the native clipboard and window')
    args, extra = parser.parse_known_args()
    if extra and extra[0] == '--':
        extra = extra[1:]
    chain = toolchain()
    if args.command == 'bootstrap':
        return
    if args.command == 'vt':
        print(vt())
        return
    if args.command == 'exec':
        if args.preset or not extra:
            parser.error('Use tools/cpp exec -- COMMAND ARG...')
        os.execvp(extra[0], extra)
    preset = args.preset or 'dev'
    if preset == TBC:
        source = ROOT / 'lib/tbc'
        build = (args.build_dir or source / 'out').resolve()
    else:
        source = ROOT
        build = (args.build_dir or ROOT / 'out' / preset).resolve()
    if args.command == 'configure':
        if preset == TBC:
            llvm = (CACHE / 'bin/clang').resolve().parents[1]
            options = ['-G', 'Ninja', '-DCMAKE_BUILD_TYPE=' + args.config, '-DCMAKE_TOOLCHAIN_FILE=' + str(chain),
                       '-DLLVM_DIR=' + str(llvm / 'lib/cmake/llvm'), '-DClang_DIR=' + str(llvm / 'lib/cmake/clang')]
        else:
            options = ['--preset', preset]
            if not any(arg.startswith('-DGHOSTTY_VT_ROOT=') for arg in extra):
                options.append('-DGHOSTTY_VT_ROOT=' + str(vt()))
        if args.headless:
            options += ['-DTELAR_CLIPBOARD_NATIVE=OFF', '-DTELAR_GUI_NATIVE=OFF']
        command = ['cmake', '-S', str(source), '-B', str(build), *options, *extra]
        # Ninja already regenerates a configured tree when its CMake inputs change,
        # so only a changed command line, preset or toolchain has to run CMake here.
        identity = hashlib.sha256('\0'.join(command).encode() + chain.read_bytes() + PRESETS_FILE.read_bytes()).hexdigest()
        stamp = build / '.telar-configure'
        if (build / 'build.ninja').exists() and stamp.exists() and stamp.read_text() == identity:
            return
        stamp.unlink(missing_ok=True)
        run(*command, cwd=source)
        stamp.write_text(identity)
    elif args.command == 'build':
        lock_build(build)
        slot, _ = build_slot(SLOTS)
        run('cmake', '--build', build, *shared(extra, slot, os.cpu_count() or 1))
    else:
        run('ctest', '--test-dir', build, '--output-on-failure', *extra)


if __name__ == '__main__':
    try:
        main()
    except subprocess.CalledProcessError as error:
        raise SystemExit(error.returncode)
