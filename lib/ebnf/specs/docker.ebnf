opt_env =
    "-e" : "Set environment variables" , @any | "--env" : "Set environment variables" , @any | "--env=" : "Set environment variables" ~ @any ;

opt_env_file =
    "--env-file" : "Read in a file of environment variables" , @file | "--env-file=" : "Read in a file of environment variables" ~ @file ;

opt_interactive =
    "-i" : "Keep STDIN open even if not attached" | "--interactive" : "Keep STDIN open even if not attached" ;

opt_link =
    "--link" : "Add link to another container" , @any | "--link=" : "Add link to another container" ~ @any ;

opt_memory =
    "-m" : "Memory limit" , @any | "--memory" : "Memory limit" , @any | "--memory=" : "Memory limit" ~ @any ;

opt_memory_reservation =
    "--memory-reservation" : "Memory soft limit" , @any | "--memory-reservation=" : "Memory soft limit" ~ @any ;

opt_name =
    "--name" : "Assign a name to the container" , @any | "--name=" : "Assign a name to the container" ~ @any ;

opt_pids_limit =
    "--pids-limit" : "Tune container pids limit (set -1 for unlimited)" , @any | "--pids-limit=" : "Tune container pids limit (set -1 for unlimited)" ~ @any ;

opt_platform =
    "--platform" : "Set platform if server is multi-platform capable" , @any | "--platform=" : "Set platform if server is multi-platform capable" ~ @any ;

opt_publish =
    "-p" : "Publish a container's port(s) to the host" , @any | "--publish" : "Publish a container's port(s) to the host" , @any | "--publish=" : "Publish a container's port(s) to the host" ~ @any ;

opt_restart =
    "--restart" : "Restart policy to apply when a container exits" , restart_policy | "--restart=" : "Restart policy to apply when a container exits" ~ restart_policy ;

opt_tty = "-t" : "Allocate a pseudo-TTY" | "--tty" : "Allocate a pseudo-TTY" ;

opt_ulimit = "--ulimit" : "Ulimit options" , @any | "--ulimit=" : "Ulimit options" ~ @any ;

opt_volume =
    "-v" : "Bind mount a volume" , @any | "--volume" : "Bind mount a volume" , @any | "--volume=" : "Bind mount a volume" ~ @any ;

opt_workdir =
    "-w" : "Working directory inside the container" , @any | "--workdir" : "Working directory inside the container" , @any | "--workdir=" : "Working directory inside the container" ~ @any ;

opt_detach =
    "-d" : "Run container in background and print container ID" | "--detach" : "Run container in background and print container ID" ;

opt_detach_keys =
    "--detach-keys" : "Override the key sequence for detaching a container" , @any | "--detach-keys=" : "Override the key sequence for detaching a container" ~ @any ;

opt_all = "-a" : "Show all containers" | "--all" : "Show all containers" ;

opt_filter =
    "-f" : "Filter output based on conditions provided" , @any | "--filter" : "Filter output based on conditions provided" , @any | "--filter=" : "Filter output based on conditions provided" ~ @any ;

opt_format =
