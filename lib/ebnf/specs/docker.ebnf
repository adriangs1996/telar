opt_no_trunc = "--no-trunc" : "Don't truncate output" ;

opt_size = "-s" : "Display total file sizes" | "--size" : "Display total file sizes" ;

opt_builder =
    "--builder" : "Override the configured builder instance" , @any | "--builder=" : "Override the configured builder instance" ~ @any ;

opt_call =
