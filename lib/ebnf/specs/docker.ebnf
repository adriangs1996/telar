  | "inspect" : "Return low-level information on Docker objects" , { inspect_option | @any }
  | "kill" : "Kill one or more running containers" , { kill_option | @any }
  | "load" : "Load an image from a tar archive or STDIN" , { load_option }
  | "logs" : "Fetch the logs of a container" , { logs_option | @any }
  | "pause" : "Pause all processes within one or more containers" , { @any }
  | "port" : "List port mappings or a specific mapping for the container" , { @any }
  | "rename" : "Rename a container" , { @any }
  | "restart" : "Restart one or more containers" , { restart_option | @any }
  | "rm" : "Remove one or more containers" , { rm_option | @any }
