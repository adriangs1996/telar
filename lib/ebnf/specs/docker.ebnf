opt_blkio_weight =
    "--blkio-weight" : "Block IO (relative weight), between 10 and 1000, or 0 to disable" , @any | "--blkio-weight=" : "Block IO (relative weight), between 10 and 1000, or 0 to disable" ~ @any ;

opt_cap_add =
    "--cap-add" : "Add Linux capabilities" , @any | "--cap-add=" : "Add Linux capabilities" ~ @any ;

opt_cap_drop =
    "--cap-drop" : "Drop Linux capabilities" , @any | "--cap-drop=" : "Drop Linux capabilities" ~ @any ;

opt_cpu_period =
