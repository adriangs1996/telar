(* docker: every command `docker --help` lists, checked against `docker <command> --help`
   of Docker 29.8 with Buildx 0.37 and Compose v5.5. The Docker Desktop plugins (mcp,
   model) and the swarm commands `docker --help` hides outside a swarm (service, stack,
   node, secret, config) are left out.

   Conventions:
   - Global options go before the command, compose options before its subcommand.
   - Options with a value accept `--name value` and `--name=value`; short ones accept
     `-x value` and `-xvalue` (the matcher decomposes short-option clusters itself).
   - Daily commands model every option. The rest list their options and accept any
     word after them, so a valid line is never marked invalid.
   - Container, image, network, volume and context names have no provider yet: @any.
   - run, create and exec stop reading options at the image or container; the words
     after it belong to the command run inside the container.
   - `opt_*` rules are options several commands share. *)

docker = { global_option } , [ command ] ;

global_option =
    "--config" : "Location of client config files" , @directory | "--config=" : "Location of client config files" ~ @directory
  | "-c" : "Name of the context to use to connect to the daemon" , @any | "--context" : "Name of the context to use to connect to the daemon" , @any | "--context=" : "Name of the context to use to connect to the daemon" ~ @any
  | "-D" : "Enable debug mode" | "--debug" : "Enable debug mode"
  | "-H" : "Daemon socket to connect to" , @any | "--host" : "Daemon socket to connect to" , @any | "--host=" : "Daemon socket to connect to" ~ @any
  | "-l" : "Set the logging level ('debug', 'info', 'warn', 'error', 'fatal')" , log_level | "--log-level" : "Set the logging level ('debug', 'info', 'warn', 'error', 'fatal')" , log_level | "--log-level=" : "Set the logging level ('debug', 'info', 'warn', 'error', 'fatal')" ~ log_level
  | "--tls" : "Use TLS"
  | "--tlscacert" : "Trust certs signed only by this CA" , @file | "--tlscacert=" : "Trust certs signed only by this CA" ~ @file
  | "--tlscert" : "Path to TLS certificate file" , @file | "--tlscert=" : "Path to TLS certificate file" ~ @file
  | "--tlskey" : "Path to TLS key file" , @file | "--tlskey=" : "Path to TLS key file" ~ @file
  | "--tlsverify" : "Use TLS and verify the remote"
  | "-v" : "Print version information and quit" | "--version" : "Print version information and quit" ;

create_option =
    "--add-host" : "Add a custom host-to-IP mapping (host:ip)" , @any | "--add-host=" : "Add a custom host-to-IP mapping (host:ip)" ~ @any
  | "--annotation" : "Add an annotation to the container (passed through to the OCI runtime)" , @any | "--annotation=" : "Add an annotation to the container (passed through to the OCI runtime)" ~ @any
  | "-a" : "Attach to STDIN, STDOUT or STDERR" , @any | "--attach" : "Attach to STDIN, STDOUT or STDERR" , @any | "--attach=" : "Attach to STDIN, STDOUT or STDERR" ~ @any
  | opt_blkio_weight
  | "--blkio-weight-device" : "Block IO weight (relative device weight)" , @any | "--blkio-weight-device=" : "Block IO weight (relative device weight)" ~ @any
  | opt_cap_add
  | opt_cap_drop
  | "--cgroup-parent" : "Optional parent cgroup for the container" , @any | "--cgroup-parent=" : "Optional parent cgroup for the container" ~ @any
  | "--cgroupns" : "Cgroup namespace to use (host or private)" , @any | "--cgroupns=" : "Cgroup namespace to use (host or private)" ~ @any
  | "--cidfile" : "Write the container ID to the file" , @file | "--cidfile=" : "Write the container ID to the file" ~ @file
  | opt_cpu_period
  | opt_cpu_quota
  | "--cpu-rt-period" : "Limit CPU real-time period in microseconds" , @any | "--cpu-rt-period=" : "Limit CPU real-time period in microseconds" ~ @any
  | "--cpu-rt-runtime" : "Limit CPU real-time runtime in microseconds" , @any | "--cpu-rt-runtime=" : "Limit CPU real-time runtime in microseconds" ~ @any
  | opt_cpu_shares
  | opt_cpus
  | opt_cpuset_cpus
  | opt_cpuset_mems
  | "--device" : "Add a host device to the container" , @any | "--device=" : "Add a host device to the container" ~ @any
  | "--device-cgroup-rule" : "Add a rule to the cgroup allowed devices list" , @any | "--device-cgroup-rule=" : "Add a rule to the cgroup allowed devices list" ~ @any
  | "--device-read-bps" : "Limit read rate (bytes per second) from a device" , @any | "--device-read-bps=" : "Limit read rate (bytes per second) from a device" ~ @any
  | "--device-read-iops" : "Limit read rate (IO per second) from a device" , @any | "--device-read-iops=" : "Limit read rate (IO per second) from a device" ~ @any
  | "--device-write-bps" : "Limit write rate (bytes per second) to a device" , @any | "--device-write-bps=" : "Limit write rate (bytes per second) to a device" ~ @any
  | "--device-write-iops" : "Limit write rate (IO per second) to a device" , @any | "--device-write-iops=" : "Limit write rate (IO per second) to a device" ~ @any
  | "--dns" : "Set custom DNS servers" , @any | "--dns=" : "Set custom DNS servers" ~ @any
  | "--dns-option" : "Set DNS options" , @any | "--dns-option=" : "Set DNS options" ~ @any
  | "--dns-search" : "Set custom DNS search domains" , @any | "--dns-search=" : "Set custom DNS search domains" ~ @any
  | "--domainname" : "Container NIS domain name" , @any | "--domainname=" : "Container NIS domain name" ~ @any
  | "--entrypoint" : "Overwrite the default ENTRYPOINT of the image" , @any | "--entrypoint=" : "Overwrite the default ENTRYPOINT of the image" ~ @any
  | opt_env
  | opt_env_file
  | "--expose" : "Expose a port or a range of ports" , @any | "--expose=" : "Expose a port or a range of ports" ~ @any
  | "--gpus" : "GPU devices to add to the container ('all' to pass all GPUs)" , @any | "--gpus=" : "GPU devices to add to the container ('all' to pass all GPUs)" ~ @any
  | "--group-add" : "Add additional groups to join" , @any | "--group-add=" : "Add additional groups to join" ~ @any
  | "--health-cmd" : "Command to run to check health" , @any | "--health-cmd=" : "Command to run to check health" ~ @any
  | "--health-interval" : "Time between running the check (ms|s|m|h)" , @any | "--health-interval=" : "Time between running the check (ms|s|m|h)" ~ @any
  | "--health-retries" : "Consecutive failures needed to report unhealthy" , @any | "--health-retries=" : "Consecutive failures needed to report unhealthy" ~ @any
  | "--health-start-interval" : "Time between running the check during the start period (ms|s|m|h)" , @any | "--health-start-interval=" : "Time between running the check during the start period (ms|s|m|h)" ~ @any
  | "--health-start-period" : "Start period before the health-retries countdown (ms|s|m|h)" , @any | "--health-start-period=" : "Start period before the health-retries countdown (ms|s|m|h)" ~ @any
  | "--health-timeout" : "Maximum time to allow one check to run (ms|s|m|h)" , @any | "--health-timeout=" : "Maximum time to allow one check to run (ms|s|m|h)" ~ @any
  | "-h" : "Container host name" , @any | "--hostname" : "Container host name" , @any | "--hostname=" : "Container host name" ~ @any
  | "--init" : "Run an init that forwards signals and reaps processes"
  | opt_interactive
  | "--ip" : "IPv4 address (e.g., 172.30.100.104)" , @any | "--ip=" : "IPv4 address (e.g., 172.30.100.104)" ~ @any
  | "--ip6" : "IPv6 address (e.g., 2001:db8::33)" , @any | "--ip6=" : "IPv6 address (e.g., 2001:db8::33)" ~ @any
  | "--ipc" : "IPC mode to use" , @any | "--ipc=" : "IPC mode to use" ~ @any
  | "--isolation" : "Container isolation technology" , @any | "--isolation=" : "Container isolation technology" ~ @any
  | "-l" : "Set meta data on a container" , @any | "--label" : "Set meta data on a container" , @any | "--label=" : "Set meta data on a container" ~ @any
  | "--label-file" : "Read in a line delimited file of labels" , @file | "--label-file=" : "Read in a line delimited file of labels" ~ @file
  | opt_link
  | "--link-local-ip" : "Container IPv4/IPv6 link-local addresses" , @any | "--link-local-ip=" : "Container IPv4/IPv6 link-local addresses" ~ @any
  | "--log-driver" : "Logging driver for the container" , @any | "--log-driver=" : "Logging driver for the container" ~ @any
  | "--log-opt" : "Log driver options" , @any | "--log-opt=" : "Log driver options" ~ @any
  | "--mac-address" : "Container MAC address (e.g., 92:d0:c6:0a:29:33)" , @any | "--mac-address=" : "Container MAC address (e.g., 92:d0:c6:0a:29:33)" ~ @any
  | opt_memory
  | opt_memory_reservation
  | "--memory-swap" : "Swap limit equal to memory plus swap: '-1' to enable unlimited swap" , @any | "--memory-swap=" : "Swap limit equal to memory plus swap: '-1' to enable unlimited swap" ~ @any
  | "--memory-swappiness" : "Tune container memory swappiness (0 to 100)" , @any | "--memory-swappiness=" : "Tune container memory swappiness (0 to 100)" ~ @any
  | "--mount" : "Attach a filesystem mount to the container" , @any | "--mount=" : "Attach a filesystem mount to the container" ~ @any
  | opt_name
  | "--network" : "Connect a container to a network" , network_mode | "--network=" : "Connect a container to a network" ~ network_mode
  | "--network-alias" : "Add network-scoped alias for the container" , @any | "--network-alias=" : "Add network-scoped alias for the container" ~ @any
  | "--no-healthcheck" : "Disable any container-specified HEALTHCHECK"
  | "--oom-kill-disable" : "Disable OOM Killer"
  | "--oom-score-adj" : "Tune host's OOM preferences (-1000 to 1000)" , @any | "--oom-score-adj=" : "Tune host's OOM preferences (-1000 to 1000)" ~ @any
  | "--pid" : "PID namespace to use" , @any | "--pid=" : "PID namespace to use" ~ @any
  | opt_pids_limit
  | opt_platform
  | "--privileged" : "Give extended privileges to this container"
  | opt_publish
  | "-P" : "Publish all exposed ports to random ports" | "--publish-all" : "Publish all exposed ports to random ports"
  | "--pull" : "Pull the image first ('always', 'missing', 'never')" , pull_value | "--pull=" : "Pull the image first ('always', 'missing', 'never')" ~ pull_value
  | "-q" : "Suppress the pull output" | "--quiet" : "Suppress the pull output"
  | "--read-only" : "Mount the container's root filesystem as read only"
  | opt_restart
  | "--rm" : "Remove the container and its anonymous volumes when it exits"
  | "--runtime" : "Runtime to use for this container" , @any | "--runtime=" : "Runtime to use for this container" ~ @any
  | "--security-opt" : "Security Options" , @any | "--security-opt=" : "Security Options" ~ @any
  | "--shm-size" : "Size of /dev/shm" , @any | "--shm-size=" : "Size of /dev/shm" ~ @any
  | "--stop-signal" : "Signal to stop the container" , @any | "--stop-signal=" : "Signal to stop the container" ~ @any
  | "--stop-timeout" : "Timeout (in seconds) to stop a container" , @any | "--stop-timeout=" : "Timeout (in seconds) to stop a container" ~ @any
  | "--storage-opt" : "Storage driver options for the container" , @any | "--storage-opt=" : "Storage driver options for the container" ~ @any
  | "--sysctl" : "Sysctl options" , @any | "--sysctl=" : "Sysctl options" ~ @any
  | "--tmpfs" : "Mount a tmpfs directory" , @any | "--tmpfs=" : "Mount a tmpfs directory" ~ @any
  | opt_tty
  | opt_ulimit
  | "--umask" : "Set umask for the container" , @any | "--umask=" : "Set umask for the container" ~ @any
  | "--use-api-socket" : "Bind mount Docker API socket and required auth"
  | "-u" : "Username or UID (format: <name|uid>[:<group|gid>])" , @any | "--user" : "Username or UID (format: <name|uid>[:<group|gid>])" , @any | "--user=" : "Username or UID (format: <name|uid>[:<group|gid>])" ~ @any
  | "--userns" : "User namespace to use" , @any | "--userns=" : "User namespace to use" ~ @any
  | "--uts" : "UTS namespace to use" , @any | "--uts=" : "UTS namespace to use" ~ @any
  | opt_volume
  | "--volume-driver" : "Optional volume driver for the container" , @any | "--volume-driver=" : "Optional volume driver for the container" ~ @any
  | "--volumes-from" : "Mount volumes from the specified container(s)" , @any | "--volumes-from=" : "Mount volumes from the specified container(s)" ~ @any
  | opt_workdir ;

run_option =
    create_option
  | opt_detach
  | opt_detach_keys
  | "--sig-proxy" : "Proxy received signals to the process" ;

exec_option =
    "-d" : "Detached mode: run command in the background" | "--detach" : "Detached mode: run command in the background"
  | opt_detach_keys
  | opt_env
  | opt_env_file
  | opt_interactive
  | "--privileged" : "Give extended privileges to the command"
  | opt_tty
  | "-u" : "Username or UID (format: '<name|uid>[:<group|gid>]')" , @any | "--user" : "Username or UID (format: '<name|uid>[:<group|gid>]')" , @any | "--user=" : "Username or UID (format: '<name|uid>[:<group|gid>]')" ~ @any
  | opt_workdir ;

ps_option =
    opt_all
  | opt_filter
  | opt_format
  | "-n" : "Show n last created containers (includes all states)" , @any | "--last" : "Show n last created containers (includes all states)" , @any | "--last=" : "Show n last created containers (includes all states)" ~ @any
  | "-l" : "Show the latest created container (includes all states)" | "--latest" : "Show the latest created container (includes all states)"
  | opt_no_trunc
  | "-q" : "Only display container IDs" | "--quiet" : "Only display container IDs"
  | opt_size ;

build_option =
    "--add-host" : "Add a custom host-to-IP mapping (format: 'host:ip')" , @any | "--add-host=" : "Add a custom host-to-IP mapping (format: 'host:ip')" ~ @any
  | "--allow" : "Allow extra privileged entitlement" , @any | "--allow=" : "Allow extra privileged entitlement" ~ @any
  | "--annotation" : "Add annotation to the image" , @any | "--annotation=" : "Add annotation to the image" ~ @any
  | "--attest" : "Attestation parameters (format: 'type=sbom,generator=image')" , @any | "--attest=" : "Attestation parameters (format: 'type=sbom,generator=image')" ~ @any
  | "--build-arg" : "Set build-time variables" , @any | "--build-arg=" : "Set build-time variables" ~ @any
  | "--build-context" : "Additional build contexts (e.g., name=path)" , @any | "--build-context=" : "Additional build contexts (e.g., name=path)" ~ @any
  | opt_builder
  | "--cache-from" : "External cache sources" , @any | "--cache-from=" : "External cache sources" ~ @any
  | "--cache-to" : "Cache export destinations" , @any | "--cache-to=" : "Cache export destinations" ~ @any
  | opt_call
  | "--cgroup-parent" : "Set the parent cgroup for the 'RUN' instructions during build" , @any | "--cgroup-parent=" : "Set the parent cgroup for the 'RUN' instructions during build" ~ @any
  | opt_check
  | opt_debug
  | "-f" : "Name of the Dockerfile" , @file | "--file" : "Name of the Dockerfile" , @file | "--file=" : "Name of the Dockerfile" ~ @file
  | "--iidfile" : "Write the image ID to a file" , @file | "--iidfile=" : "Write the image ID to a file" ~ @file
  | "--label" : "Set metadata for an image" , @any | "--label=" : "Set metadata for an image" ~ @any
  | "--load" : "Shorthand for '--output=type=docker'"
  | opt_metadata_file
  | "--network" : "Set the networking mode for the 'RUN' instructions during build" , network_mode | "--network=" : "Set the networking mode for the 'RUN' instructions during build" ~ network_mode
  | opt_no_cache
  | "--no-cache-filter" : "Do not cache specified stages" , @any | "--no-cache-filter=" : "Do not cache specified stages" ~ @any
  | "-o" : "Output destination (format: 'type=local,dest=path')" , @any | "--output" : "Output destination (format: 'type=local,dest=path')" , @any | "--output=" : "Output destination (format: 'type=local,dest=path')" ~ @any
  | "--platform" : "Set target platform for build" , @any | "--platform=" : "Set target platform for build" ~ @any
  | "--policy" : "Policy configuration" , @any | "--policy=" : "Policy configuration" ~ @any
  | opt_progress
  | "--provenance" : "Shorthand for '--attest=type=provenance'" , @any | "--provenance=" : "Shorthand for '--attest=type=provenance'" ~ @any
  | opt_pull
  | "--push" : "Shorthand for '--output=type=registry,unpack=false'"
  | "-q" : "Suppress the build output and print image ID on success" | "--quiet" : "Suppress the build output and print image ID on success"
  | "--resource" : "Resource limits for build containers" , @any | "--resource=" : "Resource limits for build containers" ~ @any
  | "--sbom" : "Shorthand for '--attest=type=sbom'" , @any | "--sbom=" : "Shorthand for '--attest=type=sbom'" ~ @any
  | "--secret" : "Secret to expose to the build" , @any | "--secret=" : "Secret to expose to the build" ~ @any
  | "--shm-size" : "Shared memory size for build containers" , @any | "--shm-size=" : "Shared memory size for build containers" ~ @any
  | "--ssh" : "SSH agent socket or keys to expose to the build" , @any | "--ssh=" : "SSH agent socket or keys to expose to the build" ~ @any
  | "-t" : "Image identifier (format: '[registry/]repository[:tag]')" , @any | "--tag" : "Image identifier (format: '[registry/]repository[:tag]')" , @any | "--tag=" : "Image identifier (format: '[registry/]repository[:tag]')" ~ @any
  | "--target" : "Set the target build stage to build" , @any | "--target=" : "Set the target build stage to build" ~ @any
  | opt_ulimit ;

bake_option =
    "--allow" : "Allow build to access specified resources" , @any | "--allow=" : "Allow build to access specified resources" ~ @any
  | opt_builder
  | opt_call
  | opt_check
  | opt_debug
  | "-f" : "Build definition file" , @file | "--file" : "Build definition file" , @file | "--file=" : "Build definition file" ~ @file
  | "--list" : "List targets or variables" , @any | "--list=" : "List targets or variables" ~ @any
  | "--load" : "Shorthand for '--set=*.output=type=docker'"
  | opt_metadata_file
  | opt_no_cache
  | "--policy" : "Global policy evaluation options" , @any | "--policy=" : "Global policy evaluation options" ~ @any
  | "--print" : "Print the options without building"
  | opt_progress
  | "--provenance" : "Shorthand for '--set=*.attest=type=provenance'" , @any | "--provenance=" : "Shorthand for '--set=*.attest=type=provenance'" ~ @any
  | opt_pull
  | "--push" : "Shorthand for '--set=*.output=type=registry'"
  | "--sbom" : "Shorthand for '--set=*.attest=type=sbom'" , @any | "--sbom=" : "Shorthand for '--set=*.attest=type=sbom'" ~ @any
  | "--set" : "Override target value (e.g., 'targetpattern.key=value')" , @any | "--set=" : "Override target value (e.g., 'targetpattern.key=value')" ~ @any
  | "--var" : "Set a variable value (e.g., 'name=value')" , @any | "--var=" : "Set a variable value (e.g., 'name=value')" ~ @any ;

pull_option =
    "-a" : "Download all tagged images in the repository" | "--all-tags" : "Download all tagged images in the repository"
  | opt_platform
  | opt_quiet ;

push_option =
    "-a" : "Push all tags of an image to the repository" | "--all-tags" : "Push all tags of an image to the repository"
  | "--platform" : "Push a platform-specific manifest as a single-platform image" , @any | "--platform=" : "Push a platform-specific manifest as a single-platform image" ~ @any
  | opt_quiet ;

images_option =
    "-a" : "Show all images" | "--all" : "Show all images"
  | "--digests" : "Show digests"
  | opt_filter
  | opt_format
  | opt_no_trunc
  | opt_quiet2
  | "--tree" : "List multi-platform images as a tree (EXPERIMENTAL)" ;

login_option =
    "-p" : "Password or Personal Access Token (PAT), or '-' to read from stdin" , @any | "--password" : "Password or Personal Access Token (PAT), or '-' to read from stdin" , @any | "--password=" : "Password or Personal Access Token (PAT), or '-' to read from stdin" ~ @any
  | "--password-stdin" : "Take the Password or Personal Access Token (PAT) from stdin"
  | "-u" : "Username" , @any | "--username" : "Username" , @any | "--username=" : "Username" ~ @any ;

search_option =
    opt_filter
  | "--format" : "Pretty-print search using a Go template" , format | "--format=" : "Pretty-print search using a Go template" ~ format
  | "--limit" : "Max number of search results" , @any | "--limit=" : "Max number of search results" ~ @any
  | opt_no_trunc ;

version_option = opt_format2 ;

attach_option =
    opt_detach_keys
  | opt_no_stdin
  | opt_sig_proxy ;

commit_option =
    "-a" : "Author (e.g., 'John Hannibal Smith <hannibal@a-team.com>')" , @any | "--author" : "Author (e.g., 'John Hannibal Smith <hannibal@a-team.com>')" , @any | "--author=" : "Author (e.g., 'John Hannibal Smith <hannibal@a-team.com>')" ~ @any
  | opt_change
  | "-m" : "Commit message" , @any | "--message" : "Commit message" , @any | "--message=" : "Commit message" ~ @any
  | "--no-pause" : "Disable pausing container during commit" ;

cp_option =
    opt_archive
  | "-L" : "Always follow symlinks in SRC_PATH" | "--follow-link" : "Always follow symlinks in SRC_PATH"
  | "-q" : "Suppress progress output during copy" | "--quiet" : "Suppress progress output during copy" ;

events_option =
    opt_filter
  | "--format" : "Format output: 'json' or a Go template" , format | "--format=" : "Format output: 'json' or a Go template" ~ format
  | "--since" : "Show all events created since timestamp" , @any | "--since=" : "Show all events created since timestamp" ~ @any
  | "--until" : "Stream events until this timestamp" , @any | "--until=" : "Stream events until this timestamp" ~ @any ;

export_option = opt_output ;

history_option =
    opt_format
  | "-H" : "Print sizes and dates in human readable format" | "--human" : "Print sizes and dates in human readable format"
  | opt_no_trunc
  | "--platform" : "Show history for the given platform" , @any | "--platform=" : "Show history for the given platform" ~ @any
  | opt_quiet2 ;

import_option =
    opt_change
  | "-m" : "Set commit message for imported image" , @any | "--message" : "Set commit message for imported image" , @any | "--message=" : "Set commit message for imported image" ~ @any
  | opt_platform ;

inspect_option =
    opt_format2
  | "-s" : "Display total file sizes if the type is container" | "--size" : "Display total file sizes if the type is container"
  | "--type" : "Only inspect objects of the given type" , @any | "--type=" : "Only inspect objects of the given type" ~ @any ;

kill_option = opt_signal ;

load_option =
    "-i" : "Read from tar archive file, instead of STDIN" , @file | "--input" : "Read from tar archive file, instead of STDIN" , @file | "--input=" : "Read from tar archive file, instead of STDIN" ~ @file
  | "--platform" : "Load only the given platform(s)" , @any | "--platform=" : "Load only the given platform(s)" ~ @any
  | "-q" : "Suppress the load output" | "--quiet" : "Suppress the load output" ;

logs_option =
    "--details" : "Show extra details provided to logs"
  | opt_follow
  | opt_since
  | "-n" : "Number of lines to show from the end of the logs" , @any | "--tail" : "Number of lines to show from the end of the logs" , @any | "--tail=" : "Number of lines to show from the end of the logs" ~ @any
  | opt_timestamps
  | opt_until ;

restart_option =
    opt_signal
  | "-t" : "Seconds to wait before killing the container" , @any | "--timeout" : "Seconds to wait before killing the container" , @any | "--timeout=" : "Seconds to wait before killing the container" ~ @any ;

rm_option =
    "-f" : "Force the removal of a running container (uses SIGKILL)" | "--force" : "Force the removal of a running container (uses SIGKILL)"
  | "-l" : "Remove the specified link" | "--link" : "Remove the specified link"
  | "-v" : "Remove anonymous volumes associated with the container" | "--volumes" : "Remove anonymous volumes associated with the container" ;

rmi_option =
    "-f" : "Force removal of the image" | "--force" : "Force removal of the image"
  | "--no-prune" : "Do not delete untagged parents"
  | "--platform" : "Remove only the given platform variant" , @any | "--platform=" : "Remove only the given platform variant" ~ @any ;

save_option =
    opt_output
  | "--platform" : "Save only the given platform(s)" , @any | "--platform=" : "Save only the given platform(s)" ~ @any ;

start_option =
    "-a" : "Attach STDOUT/STDERR and forward signals" | "--attach" : "Attach STDOUT/STDERR and forward signals"
  | "--checkpoint" : "Restore from this checkpoint" , @any | "--checkpoint=" : "Restore from this checkpoint" ~ @any
  | "--checkpoint-dir" : "Use a custom checkpoint storage directory" , @any | "--checkpoint-dir=" : "Use a custom checkpoint storage directory" ~ @any
  | opt_detach_keys
  | "-i" : "Attach container's STDIN" | "--interactive" : "Attach container's STDIN" ;

stats_option =
    opt_all
  | opt_format
  | opt_no_stream
  | opt_no_trunc2 ;

update_option =
    opt_blkio_weight
  | opt_cpu_period
  | opt_cpu_quota
