container_command =
    "attach" : "Attach local stdin, stdout and stderr to a running container" , { attach_option | @any }
  | "commit" : "Create a new image from a container's changes" , { commit_option | @any }
  | "cp" : "Copy files/folders between a container and the local filesystem" , { cp_option | @file | "-" : "Stream a tar archive through stdin or stdout" }
  | "create" : "Create a new container" , { create_option } , [ @any , { @any } ]
  | "diff" : "Inspect changes to files or directories on a container's filesystem" , { @any }
  | "exec" : "Execute a command in a running container" , { exec_option } , [ @any , { @any } ]
  | "export" : "Export a container's filesystem as a tar archive" , { export_option | @any }
  | "inspect" : "Display detailed information on one or more containers" , { container_inspect_option | @any }
  | "kill" : "Kill one or more running containers" , { kill_option | @any }
  | "logs" : "Fetch the logs of a container" , { logs_option | @any }
  | "ls" : "List containers" , { ps_option }
  | "pause" : "Pause all processes within one or more containers" , { @any }
  | "port" : "List port mappings or a specific mapping for the container" , { @any }
  | "prune" : "Remove all stopped containers" , { prune_option }
  | "rename" : "Rename a container" , { @any }
  | "restart" : "Restart one or more containers" , { restart_option | @any }
  | "rm" : "Remove one or more containers" , { rm_option | @any }
  | "run" : "Create and run a new container from an image" , { run_option } , [ @any , { @any } ]
  | "start" : "Start one or more stopped containers" , { start_option | @any }
  | "stats" : "Display a live stream of container(s) resource usage statistics" , { stats_option | @any }
  | "stop" : "Stop one or more running containers" , { restart_option | @any }
  | "top" : "Display the running processes of a container" , [ @any , { @any } ]
  | "unpause" : "Unpause all processes within one or more containers" , { @any }
  | "update" : "Update configuration of one or more containers" , { update_option | @any }
  | "wait" : "Block until one or more containers stop, then print their exit codes" , { @any } ;

context_create_option =
    "--description" : "Description of the context" , @any | "--description=" : "Description of the context" ~ @any
  | "--docker" : "Set the docker endpoint" , @any | "--docker=" : "Set the docker endpoint" ~ @any
  | "--from" : "Create context from a named context" , @any | "--from=" : "Create context from a named context" ~ @any ;

context_ls_option =
    opt_format
  | "-q" : "Only show context names" | "--quiet" : "Only show context names" ;

context_rm_option =
    "-f" : "Force the removal of a context in use" | "--force" : "Force the removal of a context in use" ;

context_update_option =
    "--description" : "Description of the context"
  | "--docker" : "Set the docker endpoint" ;

context_command =
    "create" : "Create a context" , { context_create_option | @any }
  | "export" : "Export a context to a tar archive FILE or a tar stream on STDOUT" , { @any }
  | "import" : "Import a context from a tar or zip file" , { @any }
  | "inspect" : "Display detailed information on one or more contexts" , { version_option | @any }
  | "ls" : "List contexts" , { context_ls_option }
  | "rm" : "Remove one or more contexts" , { context_rm_option | @any }
  | "show" : "Print the name of the current context"
  | "update" : "Update a context" , { context_update_option | @any }
  | "use" : "Set the default docker context" , { @any } ;

image_inspect_option =
    opt_format5
  | "--platform" : "Inspect a specific platform of the multi-platform image" ;

image_prune_option =
    "-a" : "Remove all unused images, not just dangling ones" | "--all" : "Remove all unused images, not just dangling ones"
  | opt_filter3
  | opt_force ;

image_command =
    "build" : "Build an image from a Dockerfile" , { build_option | @directory | "-" : "Read the context from stdin" }
  | "history" : "Show the history of an image" , { history_option | @any }
  | "import" : "Import the contents from a tarball to create a filesystem image" , { import_option | @file | "-" : "Read the tarball from stdin" }
  | "inspect" : "Display detailed information on one or more images" , { image_inspect_option | @any }
  | "load" : "Load an image from a tar archive or STDIN" , { load_option }
  | "ls" : "List images" , { images_option | @any }
  | "prune" : "Remove unused images" , { image_prune_option }
  | "pull" : "Download an image from a registry" , { pull_option | @any }
  | "push" : "Upload an image to a registry" , { push_option | @any }
  | "rm" : "Remove one or more images" , { rmi_option | @any }
  | "save" : "Save one or more images to a tar archive (streamed to STDOUT by default)" , { save_option | @any }
  | "tag" : "Create a tag TARGET_IMAGE that refers to SOURCE_IMAGE" , { @any } ;

manifest_annotate_option =
    "--arch" : "Set architecture"
  | "--os" : "Set operating system"
  | "--os-features" : "Set operating system feature"
  | "--os-version" : "Set operating system version"
  | "--variant" : "Set architecture variant" ;

manifest_create_option =
    "-a" : "Amend an existing manifest list" | "--amend" : "Amend an existing manifest list"
  | opt_insecure ;

manifest_inspect_option =
    opt_insecure
  | "-v" : "Output additional info including layers and platform" | "--verbose" : "Output additional info including layers and platform" ;

manifest_push_option =
    "--insecure" : "Allow push to an insecure registry"
  | "-p" : "Remove the local manifest list after push" | "--purge" : "Remove the local manifest list after push" ;

manifest_command =
    "annotate" : "Add additional information to a local image manifest" , { manifest_annotate_option | @any }
  | "create" : "Create a local manifest list for annotating and pushing to a registry" , { manifest_create_option | @any }
  | "inspect" : "Display an image manifest, or manifest list" , { manifest_inspect_option | @any }
  | "push" : "Push a manifest list to a repository" , { manifest_push_option | @any }
  | "rm" : "Delete one or more manifest lists from local storage" , { @any } ;

network_connect_option =
    "--alias" : "Add network-scoped alias for the container" , @any | "--alias=" : "Add network-scoped alias for the container" ~ @any
  | "--driver-opt" : "Driver options for the network" , @any | "--driver-opt=" : "Driver options for the network" ~ @any
  | "--gw-priority" : "Highest gw-priority provides the default gateway" , @any | "--gw-priority=" : "Highest gw-priority provides the default gateway" ~ @any
  | "--ip" : "IPv4 address (e.g., '172.30.100.104')" , @any | "--ip=" : "IPv4 address (e.g., '172.30.100.104')" ~ @any
  | "--ip6" : "IPv6 address (e.g., '2001:db8::33')" , @any | "--ip6=" : "IPv6 address (e.g., '2001:db8::33')" ~ @any
  | opt_link
  | "--link-local-ip" : "Add a link-local address for the container" , @any | "--link-local-ip=" : "Add a link-local address for the container" ~ @any ;

network_create_option =
    "--attachable" : "Enable manual container attachment"
  | "--aux-address" : "Auxiliary IPv4 or IPv6 addresses used by Network driver" , @any | "--aux-address=" : "Auxiliary IPv4 or IPv6 addresses used by Network driver" ~ @any
  | "--config-from" : "The network from which to copy the configuration" , @any | "--config-from=" : "The network from which to copy the configuration" ~ @any
  | "--config-only" : "Create a configuration only network"
  | "-d" : "Driver to manage the Network" , @any | "--driver" : "Driver to manage the Network" , @any | "--driver=" : "Driver to manage the Network" ~ @any
  | "--gateway" : "IPv4 or IPv6 Gateway for the master subnet" , @any | "--gateway=" : "IPv4 or IPv6 Gateway for the master subnet" ~ @any
  | "--ingress" : "Create swarm routing-mesh network"
  | "--internal" : "Restrict external access to the network"
  | "--ip-range" : "Allocate container ip from a sub-range" , @any | "--ip-range=" : "Allocate container ip from a sub-range" ~ @any
  | "--ipam-driver" : "IP Address Management Driver" , @any | "--ipam-driver=" : "IP Address Management Driver" ~ @any
  | "--ipam-opt" : "Set IPAM driver specific options" , @any | "--ipam-opt=" : "Set IPAM driver specific options" ~ @any
  | "--ipv4" : "Enable or disable IPv4 address assignment"
  | "--ipv6" : "Enable or disable IPv6 address assignment"
  | "--label" : "Set metadata on a network" , @any | "--label=" : "Set metadata on a network" ~ @any
  | opt_opt
  | "--scope" : "Control the network's scope" , @any | "--scope=" : "Control the network's scope" ~ @any
  | "--subnet" : "Subnet in CIDR format that represents a network segment" , @any | "--subnet=" : "Subnet in CIDR format that represents a network segment" ~ @any ;

network_disconnect_option =
    "-f" : "Force the container to disconnect from a network" | "--force" : "Force the container to disconnect from a network" ;

network_inspect_option =
    opt_format2
  | "-v" : "Verbose output for diagnostics" | "--verbose" : "Verbose output for diagnostics" ;

network_ls_option =
    "-f" : "Provide filter values (e.g. 'driver=bridge')" , @any | "--filter" : "Provide filter values (e.g. 'driver=bridge')" , @any | "--filter=" : "Provide filter values (e.g. 'driver=bridge')" ~ @any
  | opt_format
  | "--no-trunc" : "Do not truncate the output"
  | "-q" : "Only display network IDs" | "--quiet" : "Only display network IDs" ;

network_rm_option =
    "-f" : "Do not error if the network does not exist" | "--force" : "Do not error if the network does not exist" ;

network_command =
    "connect" : "Connect a container to a network" , { network_connect_option | @any }
  | "create" : "Create a network" , { network_create_option | @any }
  | "disconnect" : "Disconnect a container from a network" , { network_disconnect_option | @any }
  | "inspect" : "Display detailed information on one or more networks" , { network_inspect_option | @any }
  | "ls" : "List networks" , { network_ls_option }
  | "prune" : "Remove all unused networks" , { prune_option }
  | "rm" : "Remove one or more networks" , { network_rm_option | @any } ;

plugin_create_option = "--compress" : "Compress the context using gzip" ;

plugin_disable_option =
    "-f" : "Force the disable of an active plugin" | "--force" : "Force the disable of an active plugin" ;

plugin_enable_option = "--timeout" : "HTTP client timeout (in seconds)" ;

plugin_inspect_option = opt_format5 ;

plugin_install_option =
    "--alias" : "Local name for plugin"
  | "--disable" : "Do not enable the plugin on install"
  | opt_grant_all_permissions ;

plugin_ls_option =
    "-f" : "Provide filter values (e.g. 'enabled=true')" | "--filter" : "Provide filter values (e.g. 'enabled=true')"
  | opt_format4
  | opt_no_trunc
  | "-q" : "Only display plugin IDs" | "--quiet" : "Only display plugin IDs" ;

plugin_rm_option =
    "-f" : "Force the removal of an active plugin" | "--force" : "Force the removal of an active plugin" ;

plugin_upgrade_option =
    opt_grant_all_permissions
  | "--skip-remote-check" : "Do not check if specified remote plugin matches existing plugin image" ;

plugin_command =
    "create" : "Create a plugin from a rootfs and configuration" , { plugin_create_option | @any }
  | "disable" : "Disable a plugin" , { plugin_disable_option | @any }
  | "enable" : "Enable a plugin" , { plugin_enable_option | @any }
  | "inspect" : "Display detailed information on one or more plugins" , { plugin_inspect_option | @any }
  | "install" : "Install a plugin" , { plugin_install_option | @any }
  | "ls" : "List plugins" , { plugin_ls_option | @any }
  | "push" : "Push a plugin to a registry" , { @any }
  | "rm" : "Remove one or more plugins" , { plugin_rm_option | @any }
  | "set" : "Change settings for a plugin" , { @any }
  | "upgrade" : "Upgrade an existing plugin" , { plugin_upgrade_option | @any } ;

system_df_option =
    opt_format
  | "-v" : "Show detailed information on space usage" | "--verbose" : "Show detailed information on space usage" ;

system_prune_option =
    "-a" : "Remove all unused images not just dangling ones" | "--all" : "Remove all unused images not just dangling ones"
  | "--filter" : "Provide filter values (e.g. 'label=<key>=<value>')" , @any | "--filter=" : "Provide filter values (e.g. 'label=<key>=<value>')" ~ @any
  | opt_force
  | "--volumes" : "Prune anonymous volumes" ;

system_command =
    "df" : "Show docker disk usage" , { system_df_option }
  | "events" : "Get real time events from the server" , { events_option }
  | "info" : "Display system-wide information" , { version_option }
  | "prune" : "Remove unused data" , { system_prune_option } ;

volume_create_option =
    "-d" : "Specify volume driver name" , @any | "--driver" : "Specify volume driver name" , @any | "--driver=" : "Specify volume driver name" ~ @any
  | "--label" : "Set metadata for a volume" , @any | "--label=" : "Set metadata for a volume" ~ @any
  | opt_opt ;

volume_ls_option =
    "-f" : "Provide filter values (e.g. 'dangling=true')" , @any | "--filter" : "Provide filter values (e.g. 'dangling=true')" , @any | "--filter=" : "Provide filter values (e.g. 'dangling=true')" ~ @any
  | opt_format
  | opt_quiet4 ;

volume_prune_option =
    "-a" : "Remove all unused volumes, not just anonymous ones" | "--all" : "Remove all unused volumes, not just anonymous ones"
  | "--filter" : "Provide filter values (e.g. 'label=<label>')" , @any | "--filter=" : "Provide filter values (e.g. 'label=<label>')" ~ @any
  | opt_force ;

volume_rm_option =
    "-f" : "Force the removal of one or more volumes" | "--force" : "Force the removal of one or more volumes" ;

volume_command =
    "create" : "Create a volume" , { volume_create_option | @any }
  | "inspect" : "Display detailed information on one or more volumes" , { version_option | @any }
  | "ls" : "List volumes" , { volume_ls_option }
  | "prune" : "Remove unused local volumes" , { volume_prune_option }
  | "rm" : "Remove one or more volumes" , { volume_rm_option | @any } ;

swarm_init_option =
    opt_advertise_addr
  | "--autolock" : "Enable manager autolocking"
  | opt_availability
  | "--cert-expiry" : "Validity period for node certificates (ns|us|ms|s|m|h)"
  | opt_data_path_addr
  | "--data-path-port" : "Port number to use for data path traffic (1024 - 49151)"
  | "--default-addr-pool" : "Default address pool in CIDR format"
  | "--default-addr-pool-mask-length" : "Default address pool subnet mask length"
  | "--dispatcher-heartbeat" : "Dispatcher heartbeat period (ns|us|ms|s|m|h)"
  | "--external-ca" : "Specifications of one or more certificate signing endpoints"
  | "--force-new-cluster" : "Force create a new cluster from current state"
  | opt_listen_addr
  | "--max-snapshots" : "Number of additional Raft snapshots to retain"
  | "--snapshot-interval" : "Number of log entries between Raft snapshots"
  | "--task-history-limit" : "Task history retention limit" ;

swarm_join_option =
    opt_advertise_addr
  | opt_availability
  | opt_data_path_addr
  | opt_listen_addr
  | "--token" : "Token for entry into the swarm" ;

swarm_command =
    "init" : "Initialize a swarm" , { swarm_init_option | @any }
  | "join" : "Join a swarm as a node and/or manager" , { swarm_join_option | @any } ;

