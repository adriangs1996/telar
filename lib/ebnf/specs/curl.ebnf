cert_type = "PEM" | "DER" | "ENG" | "PROV" | "P12" ;

ech_config =
    "false" : "Do not attempt ECH (default)" | "grease" : "Send a GREASE ECH extension"
  | "true" : "Attempt ECH if possible" | "hard" : "Attempt ECH and fail if it is not possible"
  | @any : "A list as ecl:<b64>, or pn:<name>" ;

request_method = "GET" | "HEAD" | "POST" | "PUT" | "PATCH" | "DELETE" | "OPTIONS" | "CONNECT" | "TRACE" | @any : "Any request method or command" ;

