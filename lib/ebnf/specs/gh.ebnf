    opt_help
  | opt_repo ;

issue_view = { issue_view_option | @any } ;

issue_view_option =
    "-c" : "View issue comments" | "--comments" : "View issue comments"
  | opt_jq
  | opt_json
  | opt_template
  | "-w" : "Open an issue in the browser" | "--web" : "Open an issue in the browser"
  | opt_help
  | opt_repo ;

org = [ org_command ] ;

org_command =
    "list" : "List organizations for the authenticated user" , org_list ;

org_list = { org_list_option } ;

org_list_option =
    "-L" : "Maximum number of organizations to list" , @number | "--limit" : "Maximum number of organizations to list" , @number | "--limit=" : "Maximum number of organizations to list" ~ @number
  | opt_help ;

pr = { pr_option } , [ pr_command ] ;

pr_option =
    opt_repo ;

pr_command =
    "create" : "Create a pull request" , pr_create
  | "list" : "List pull requests in a repository" , pr_list
  | "status" : "Show status of relevant pull requests" , pr_status
  | "checkout" : "Check out a pull request in git" , pr_checkout
  | "checks" : "Show CI status for a single pull request" , pr_checks
  | "close" : "Close a pull request" , pr_close
  | "comment" : "Add a comment to a pull request" , pr_comment
  | "diff" : "View changes in a pull request" , pr_diff
  | "edit" : "Edit a pull request" , pr_edit
  | "lock" : "Lock pull request conversation" , pr_lock
  | "merge" : "Merge a pull request" , pr_merge
  | "ready" : "Mark a pull request as ready for review" , pr_ready
  | "reopen" : "Reopen a pull request" , pr_reopen
  | "revert" : "Revert a pull request" , pr_revert
  | "review" : "Add a review to a pull request" , pr_review
  | "unlock" : "Unlock pull request conversation" , pr_unlock
  | "update-branch" : "Update a pull request branch" , pr_update_branch
  | "view" : "View a pull request" , pr_view ;

pr_create = { pr_create_option } ;

pr_create_option =
    opt_assignee
  | opt_attach
  | "-B" : "The branch into which you want your code merged" , @branch | "--base" : "The branch into which you want your code merged" , @branch | "--base=" : "The branch into which you want your code merged" ~ @branch
  | "-b" : "Body for the pull request" , @any | "--body" : "Body for the pull request" , @any | "--body=" : "Body for the pull request" ~ @any
  | opt_body_file
  | "-d" : "Mark pull request as a draft" | "--draft" : "Mark pull request as a draft"
  | "--dry-run" : "Print details instead of creating the PR"
  | opt_editor
  | "-f" : "Use commit info for title and body" | "--fill" : "Use commit info for title and body"
  | "--fill-first" : "Use first commit info for title and body"
  | "--fill-verbose" : "Use commits msg+body for description"
  | "-H" : "The branch that contains commits for your pull request" , @branch | "--head" : "The branch that contains commits for your pull request" , @branch | "--head=" : "The branch that contains commits for your pull request" ~ @branch
  | opt_label
  | "-m" : "Add the pull request to a milestone by name" , @any | "--milestone" : "Add the pull request to a milestone by name" , @any | "--milestone=" : "Add the pull request to a milestone by name" ~ @any
  | "--no-maintainer-edit" : "Disable maintainer's ability to modify pull request"
  | "-p" : "Add the pull request to projects by title" , @any | "--project" : "Add the pull request to projects by title" , @any | "--project=" : "Add the pull request to projects by title" ~ @any
