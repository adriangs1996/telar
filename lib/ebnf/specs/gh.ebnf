  | opt_body
  | opt_body_file
  | opt_create_if_none
  | opt_delete_last
  | opt_edit_last
  | opt_editor_2
  | opt_web
  | opt_yes
  | opt_help
  | opt_repo ;

issue_delete = { issue_delete_option | @any } ;

issue_delete_option =
    opt_yes_2
  | opt_help
  | opt_repo ;

issue_develop = { issue_develop_option | @any } ;

issue_develop_option =
    "-b" : "Name of the remote branch you want to make your new branch from" , @branch | "--base" : "Name of the remote branch you want to make your new branch from" , @branch | "--base=" : "Name of the remote branch you want to make your new branch from" ~ @branch
  | "--branch-repo" : "Name or URL of the repository for the new branch" , @any | "--branch-repo=" : "Name or URL of the repository for the new branch" ~ @any
  | "-c" : "Checkout the branch after creating it" | "--checkout" : "Checkout the branch after creating it"
  | "-l" : "List linked branches for the issue" | "--list" : "List linked branches for the issue"
  | "-n" : "Name of the branch to create" , @any | "--name" : "Name of the branch to create" , @any | "--name=" : "Name of the branch to create" ~ @any
  | "--worktree" : "Check out the branch into a worktree at the given path" , @any | "--worktree=" : "Check out the branch into a worktree at the given path" ~ @any
  | opt_help
  | opt_repo ;

issue_edit = { issue_edit_option | @any } ;

issue_edit_option =
    opt_add_assignee
  | "--add-blocked-by" : "Add 'blocked by' relationships by issue number or URL" , @any | "--add-blocked-by=" : "Add 'blocked by' relationships by issue number or URL" ~ @any
  | "--add-blocking" : "Add 'blocking' relationships by issue number or URL" , @any | "--add-blocking=" : "Add 'blocking' relationships by issue number or URL" ~ @any
  | opt_add_label
  | "--add-project" : "Add the issue to projects by title" , @any | "--add-project=" : "Add the issue to projects by title" ~ @any
  | "--add-sub-issue" : "Add sub-issues by number or URL" , @any | "--add-sub-issue=" : "Add sub-issues by number or URL" ~ @any
  | opt_attach
  | opt_body_2
  | opt_body_file
  | "-m" : "Edit the milestone the issue belongs to by name" , @any | "--milestone" : "Edit the milestone the issue belongs to by name" , @any | "--milestone=" : "Edit the milestone the issue belongs to by name" ~ @any
  | "--parent" : "Set the parent issue by number or URL" , @any | "--parent=" : "Set the parent issue by number or URL" ~ @any
  | opt_remove_assignee
  | "--remove-blocked-by" : "Remove 'blocked by' relationships by issue number or URL" , @any | "--remove-blocked-by=" : "Remove 'blocked by' relationships by issue number or URL" ~ @any
  | "--remove-blocking" : "Remove 'blocking' relationships by issue number or URL" , @any | "--remove-blocking=" : "Remove 'blocking' relationships by issue number or URL" ~ @any
  | opt_remove_label
  | "--remove-milestone" : "Remove the milestone association from the issue"
  | "--remove-parent" : "Remove the parent issue"
  | "--remove-project" : "Remove the issue from projects by title" , @any | "--remove-project=" : "Remove the issue from projects by title" ~ @any
  | "--remove-sub-issue" : "Remove sub-issues by number or URL" , @any | "--remove-sub-issue=" : "Remove sub-issues by number or URL" ~ @any
  | "--remove-type" : "Remove the issue type from the issue"
  | opt_title
  | opt_type
  | opt_help
  | opt_repo ;

issue_lock = { issue_lock_option | @any } ;

issue_lock_option =
    opt_reason
  | opt_help
  | opt_repo ;

issue_pin = { issue_pin_option | @any } ;

issue_pin_option =
    opt_help
  | opt_repo ;

issue_reopen = { issue_reopen_option | @any } ;

