  | "issues" : "Search for issues" , search_issues
  | "prs" : "Search for pull requests" , search_prs
  | "repos" : "Search for repositories" , search_repos ;

search_code = { @any } ;

search_commits = { @any } ;

search_issues = { @any } ;

search_prs = { @any } ;

search_repos = { @any } ;

secret = { secret_option } , [ secret_command ] ;

secret_option =
    opt_repo ;

secret_command =
    "delete" : "Delete secrets" , secret_delete
  | "list" : "List secrets" , secret_list
  | "set" : "Create or update secrets" , secret_set ;

secret_delete = { secret_delete_option | @any } ;

secret_delete_option =
    "-a" : "Delete a secret for a specific application" , ( "actions" | "agents" | "codespaces" | "dependabot" ) | "--app" : "Delete a secret for a specific application" , ( "actions" | "agents" | "codespaces" | "dependabot" ) | "--app=" : "Delete a secret for a specific application" ~ ( "actions" | "agents" | "codespaces" | "dependabot" )
  | "-e" : "Delete a secret for an environment" , @any | "--env" : "Delete a secret for an environment" , @any | "--env=" : "Delete a secret for an environment" ~ @any
  | "-o" : "Delete a secret for an organization" , @any | "--org" : "Delete a secret for an organization" , @any | "--org=" : "Delete a secret for an organization" ~ @any
  | "-u" : "Delete a secret for your user" | "--user" : "Delete a secret for your user"
  | opt_help
  | opt_repo ;

secret_list = { secret_list_option } ;

secret_list_option =
    "-a" : "List secrets for a specific application" , ( "actions" | "agents" | "codespaces" | "dependabot" ) | "--app" : "List secrets for a specific application" , ( "actions" | "agents" | "codespaces" | "dependabot" ) | "--app=" : "List secrets for a specific application" ~ ( "actions" | "agents" | "codespaces" | "dependabot" )
  | "-e" : "List secrets for an environment" , @any | "--env" : "List secrets for an environment" , @any | "--env=" : "List secrets for an environment" ~ @any
  | opt_jq
  | opt_json
  | "-o" : "List secrets for an organization" , @any | "--org" : "List secrets for an organization" , @any | "--org=" : "List secrets for an organization" ~ @any
  | opt_template
  | "-u" : "List a secret for your user" | "--user" : "List a secret for your user"
  | opt_help
  | opt_repo ;

secret_set = { secret_set_option | @any } ;

secret_set_option =
    "-a" : "Set the application for a secret" , ( "actions" | "agents" | "codespaces" | "dependabot" ) | "--app" : "Set the application for a secret" , ( "actions" | "agents" | "codespaces" | "dependabot" ) | "--app=" : "Set the application for a secret" ~ ( "actions" | "agents" | "codespaces" | "dependabot" )
  | "-b" : "The value for the secret (reads from standard input if not specified)" , @any | "--body" : "The value for the secret (reads from standard input if not specified)" , @any | "--body=" : "The value for the secret (reads from standard input if not specified)" ~ @any
  | "-e" : "Set deployment environment secret" , @any | "--env" : "Set deployment environment secret" , @any | "--env=" : "Set deployment environment secret" ~ @any
  | "-f" : "Load secret names and values from a dotenv-formatted file" , @file | "--env-file" : "Load secret names and values from a dotenv-formatted file" , @file | "--env-file=" : "Load secret names and values from a dotenv-formatted file" ~ @file
  | "--no-repos-selected" : "No repositories can access the organization secret"
  | "--no-store" : "Print the encrypted base64 value instead of storing it"
  | "-o" : "Set organization secret" , @any | "--org" : "Set organization secret" , @any | "--org=" : "Set organization secret" ~ @any
  | "-r" : "List of repositories that can access an organization or user secret" , @any | "--repos" : "List of repositories that can access an organization or user secret" , @any | "--repos=" : "List of repositories that can access an organization or user secret" ~ @any
  | "-u" : "Set a secret for your user" | "--user" : "Set a secret for your user"
  | "-v" : "Set visibility for an organization secret" , ( "all" | "private" | "selected" ) | "--visibility" : "Set visibility for an organization secret" , ( "all" | "private" | "selected" ) | "--visibility=" : "Set visibility for an organization secret" ~ ( "all" | "private" | "selected" )
  | opt_help
  | opt_repo ;

ssh_key = [ ssh_key_command ] ;

ssh_key_command =
    "add" : "Add an SSH key to your GitHub account" , ssh_key_add
  | "delete" : "Delete an SSH key from your GitHub account" , ssh_key_delete
  | "list" : "Lists SSH keys in your GitHub account" , ssh_key_list ;

