  | "--duplicate-of" : "Mark as duplicate of another issue by number or URL" , @any | "--duplicate-of=" : "Mark as duplicate of another issue by number or URL" ~ @any
  | "-r" : "Reason for closing: {completed|not planned|duplicate}" , @any | "--reason" : "Reason for closing: {completed|not planned|duplicate}" , @any | "--reason=" : "Reason for closing: {completed|not planned|duplicate}" ~ @any
  | opt_help
  | opt_repo ;

