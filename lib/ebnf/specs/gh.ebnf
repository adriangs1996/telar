issue_artifact_view = { @any } ;

issue_create = { issue_create_option } ;

issue_create_option =
    opt_assignee
  | opt_attach
  | "--blocked-by" : "Mark the new issue as blocked by these issue numbers or URLs" , @any | "--blocked-by=" : "Mark the new issue as blocked by these issue numbers or URLs" ~ @any
  | "--blocking" : "Mark the new issue as blocking these issue numbers or URLs" , @any | "--blocking=" : "Mark the new issue as blocking these issue numbers or URLs" ~ @any
  | "-b" : "Supply a body" , @any | "--body" : "Supply a body" , @any | "--body=" : "Supply a body" ~ @any
  | opt_body_file
  | opt_editor
  | opt_label
  | "-m" : "Add the issue to a milestone by name" , @any | "--milestone" : "Add the issue to a milestone by name" , @any | "--milestone=" : "Add the issue to a milestone by name" ~ @any
  | "--parent" : "Add the issue as a sub-issue of this parent number or URL" , @any | "--parent=" : "Add the issue as a sub-issue of this parent number or URL" ~ @any
  | "-p" : "Add the issue to projects by title" , @any | "--project" : "Add the issue to projects by title" , @any | "--project=" : "Add the issue to projects by title" ~ @any
  | opt_recover
  | "-T" : "Template name to use as starting body text" , @any | "--template" : "Template name to use as starting body text" , @any | "--template=" : "Template name to use as starting body text" ~ @any
  | "-t" : "Supply a title" , @any | "--title" : "Supply a title" , @any | "--title=" : "Supply a title" ~ @any
  | opt_type
  | "-w" : "Open the browser to create an issue" | "--web" : "Open the browser to create an issue"
  | opt_help
  | opt_repo ;

issue_list = { issue_list_option } ;

issue_list_option =
    opt_app
  | opt_assignee_2
  | opt_author
  | opt_jq
  | opt_json
  | opt_label_2
  | "-L" : "Maximum number of issues to fetch" , @number | "--limit" : "Maximum number of issues to fetch" , @number | "--limit=" : "Maximum number of issues to fetch" ~ @number
  | "--mention" : "Filter by mention" , @any | "--mention=" : "Filter by mention" ~ @any
  | "-m" : "Filter by milestone number or title" , @any | "--milestone" : "Filter by milestone number or title" , @any | "--milestone=" : "Filter by milestone number or title" ~ @any
  | "-S" : "Search issues with query" , @any | "--search" : "Search issues with query" , @any | "--search=" : "Search issues with query" ~ @any
  | "-s" : "Filter by state" , ( "open" | "closed" | "all" ) | "--state" : "Filter by state" , ( "open" | "closed" | "all" ) | "--state=" : "Filter by state" ~ ( "open" | "closed" | "all" )
  | opt_template
  | "--type" : "Filter by issue type name" , @any | "--type=" : "Filter by issue type name" ~ @any
  | "-w" : "List issues in the web browser" | "--web" : "List issues in the web browser"
  | opt_help
  | opt_repo ;

issue_status = { issue_status_option } ;

issue_status_option =
    opt_jq
  | opt_json
  | opt_template
  | opt_help
  | opt_repo ;

