(* gh: every command `gh --help` lists, checked against gh 2.102.0 (macOS) and
   gh 2.103.3 (Linux; `issue artifact` is new there). Generated from the help of
   each command, then reviewed.

   Modelled with every flag their `--help` lists: pr, issue, repo, run, workflow,
   release, auth, api, cache, label, secret, variable, config, alias, browse,
   ssh-key, gpg-key, completion, status and org. The other
   commands (codespace, discussion, extension, gist, project, ruleset, search,
   skill, attestation, agent-task, copilot, preview, licenses, issue artifact)
   list their subcommands, which take any words.

   Conventions:
   - Flags with a value accept `--name value` and `--name=value`; short ones
     accept `-x value` and `-xvalue` (the matcher decomposes short-option
     clusters itself). `browse --commit` takes its optional value joined only.
   - Positional arguments (numbers, URLs, names, tags) are @any, so after a
     command that takes them an unknown flag is not rejected. The number of
     positional arguments is not checked.
   - Aliases (`gh alias set`) and installed extensions add top-level commands
     the spec cannot know, so they are reported as invalid. *)

gh = { "--help" : "Show help for command" | "--version" : "Show gh version" } , [ command ] ;

command =
    "auth" : "Authenticate gh and git with GitHub" , auth
  | "browse" : "Open repositories, issues, pull requests, and more in the browser" , browse
  | "codespace" : "Connect to and manage codespaces" , codespace
  | "discussion" : "Work with GitHub Discussions (preview)" , discussion
  | "gist" : "Manage gists" , gist
  | "issue" : "Manage issues" , issue
  | "org" : "Manage organizations" , org
  | "pr" : "Manage pull requests" , pr
  | "project" : "Work with GitHub Projects" , project
  | "release" : "Manage releases" , release
  | "repo" : "Manage repositories" , repo
  | "skill" : "Install and manage agent skills (preview)" , skill
  | "cache" : "Manage GitHub Actions caches" , cache
  | "run" : "View details about workflow runs" , run
  | "workflow" : "View details about GitHub Actions workflows" , workflow
  | "agent-task" : "Work with agent tasks (preview)" , agent_task
  | "alias" : "Create command shortcuts" , alias
  | "api" : "Make an authenticated GitHub API request" , api
  | "attestation" : "Work with artifact attestations" , attestation
  | "completion" : "Generate shell completion scripts" , completion
  | "config" : "Manage configuration for gh" , config
  | "copilot" : "Run the GitHub Copilot CLI (preview)" , copilot
  | "extension" : "Manage gh extensions" , extension
  | "gpg-key" : "Manage GPG keys" , gpg_key
  | "label" : "Manage labels" , label
  | "licenses" : "View third-party license information" , licenses
  | "preview" : "Execute previews for gh features" , preview
  | "ruleset" : "View info about repo rulesets" , ruleset
  | "search" : "Search for repositories, issues, and pull requests" , search
  | "secret" : "Manage GitHub secrets" , secret
  | "ssh-key" : "Manage SSH keys" , ssh_key
  | "status" : "Print relevant issues, pull requests, and notifications" , status
  | "variable" : "Manage GitHub Actions variables" , variable
  | "help" : "Help about any command" , { @any }
  | "version" : "Show gh version" ;

auth = [ auth_command ] ;

auth_command =
    "login" : "Log in to a GitHub account" , auth_login
  | "logout" : "Log out of a GitHub account" , auth_logout
  | "refresh" : "Refresh stored authentication credentials" , auth_refresh
  | "setup-git" : "Setup git with GitHub CLI" , auth_setup_git
  | "status" : "Show the active account and auth state on each known host" , auth_status
  | "switch" : "Switch active GitHub account" , auth_switch
  | "token" : "Print the authentication token gh uses for a hostname and account" , auth_token ;

auth_login = { auth_login_option } ;

auth_login_option =
    opt_clipboard
  | "-p" : "The protocol to use for git operations on this host" , ( "ssh" | "https" ) | "--git-protocol" : "The protocol to use for git operations on this host" , ( "ssh" | "https" ) | "--git-protocol=" : "The protocol to use for git operations on this host" ~ ( "ssh" | "https" )
  | "-h" : "The hostname of the GitHub instance to authenticate with" , @any | "--hostname" : "The hostname of the GitHub instance to authenticate with" , @any | "--hostname=" : "The hostname of the GitHub instance to authenticate with" ~ @any
  | opt_insecure_storage
  | "-s" : "Additional authentication scopes to request" , @any | "--scopes" : "Additional authentication scopes to request" , @any | "--scopes=" : "Additional authentication scopes to request" ~ @any
  | "--skip-ssh-key" : "Skip generate/upload SSH key prompt"
  | "-w" : "Open a browser to authenticate" | "--web" : "Open a browser to authenticate"
  | "--with-token" : "Read token from standard input"
  | opt_help ;

auth_logout = { auth_logout_option } ;

auth_logout_option =
    "-h" : "The hostname of the GitHub instance to log out of" , @any | "--hostname" : "The hostname of the GitHub instance to log out of" , @any | "--hostname=" : "The hostname of the GitHub instance to log out of" ~ @any
  | "-u" : "The account to log out of" , @any | "--user" : "The account to log out of" , @any | "--user=" : "The account to log out of" ~ @any
  | opt_help ;

auth_refresh = { auth_refresh_option } ;

auth_refresh_option =
    opt_clipboard
  | "-h" : "The GitHub host to use for authentication" , @any | "--hostname" : "The GitHub host to use for authentication" , @any | "--hostname=" : "The GitHub host to use for authentication" ~ @any
  | opt_insecure_storage
  | "-r" : "Authentication scopes to remove from gh" , @any | "--remove-scopes" : "Authentication scopes to remove from gh" , @any | "--remove-scopes=" : "Authentication scopes to remove from gh" ~ @any
  | "--reset-scopes" : "Reset authentication scopes to the default minimum set of scopes"
  | "-s" : "Additional authentication scopes for gh to have" , @any | "--scopes" : "Additional authentication scopes for gh to have" , @any | "--scopes=" : "Additional authentication scopes for gh to have" ~ @any
  | opt_help ;

auth_setup_git = { auth_setup_git_option } ;

auth_setup_git_option =
    "-f" : "Force setup even if the host is not known" | "--force" : "Force setup even if the host is not known"
  | "-h" : "The hostname to configure git for" , @any | "--hostname" : "The hostname to configure git for" , @any | "--hostname=" : "The hostname to configure git for" ~ @any
  | opt_help ;

auth_status = { auth_status_option } ;

auth_status_option =
    "-a" : "Display the active account only" | "--active" : "Display the active account only"
  | "-h" : "Check only a specific hostname's auth status" , @any | "--hostname" : "Check only a specific hostname's auth status" , @any | "--hostname=" : "Check only a specific hostname's auth status" ~ @any
  | "--jq" : "Filter JSON output using a jq expression" , @any | "--jq=" : "Filter JSON output using a jq expression" ~ @any
  | opt_json
  | "-t" : "Display the auth token" | "--show-token" : "Display the auth token"
  | "--template" : "Format JSON output using a Go template" , @any | "--template=" : "Format JSON output using a Go template" ~ @any
  | opt_help ;

auth_switch = { auth_switch_option } ;

auth_switch_option =
    "-h" : "The hostname of the GitHub instance to switch account for" , @any | "--hostname" : "The hostname of the GitHub instance to switch account for" , @any | "--hostname=" : "The hostname of the GitHub instance to switch account for" ~ @any
  | "-u" : "The account to switch to" , @any | "--user" : "The account to switch to" , @any | "--user=" : "The account to switch to" ~ @any
  | opt_help ;

auth_token = { auth_token_option } ;

auth_token_option =
    "-h" : "The hostname of the GitHub instance authenticated with" , @any | "--hostname" : "The hostname of the GitHub instance authenticated with" , @any | "--hostname=" : "The hostname of the GitHub instance authenticated with" ~ @any
  | "-u" : "The account to output the token for" , @any | "--user" : "The account to output the token for" , @any | "--user=" : "The account to output the token for" ~ @any
  | opt_help ;

browse = { browse_option | @any } ;

browse_option =
    "-a" : "Open repository actions" | "--actions" : "Open repository actions"
  | "--blame" : "Open blame view for a file"
  | "-b" : "Select another branch by passing in the branch name" , @branch | "--branch" : "Select another branch by passing in the branch name" , @branch | "--branch=" : "Select another branch by passing in the branch name" ~ @branch
  | "-c" : "Select a commit by SHA, the last commit when no value is given" | "--commit" : "Select a commit by SHA, the last commit when no value is given" | "--commit=" : "Select a commit by SHA, the last commit when no value is given" ~ @any
  | "-n" : "Print destination URL instead of opening the browser" | "--no-browser" : "Print destination URL instead of opening the browser"
  | "-p" : "Open repository projects" | "--projects" : "Open repository projects"
  | "-r" : "Open repository releases" | "--releases" : "Open repository releases"
  | opt_repo
  | "-s" : "Open repository settings" | "--settings" : "Open repository settings"
  | "-w" : "Open repository wiki" | "--wiki" : "Open repository wiki"
  | opt_help ;

