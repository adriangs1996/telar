issue = { issue_option } , [ issue_command ] ;

issue_option =
    opt_repo ;

issue_command =
    "artifact" : "Work with issue artifacts (preview, gh 2.103)" , issue_artifact
  | "create" : "Create a new issue" , issue_create
  | "list" : "List issues in a repository" , issue_list
  | "status" : "Show status of relevant issues" , issue_status
  | "close" : "Close issue" , issue_close
  | "comment" : "Add a comment to an issue" , issue_comment
  | "delete" : "Delete issue" , issue_delete
  | "develop" : "Manage linked branches for an issue" , issue_develop
  | "edit" : "Edit issues" , issue_edit
  | "lock" : "Lock issue conversation" , issue_lock
  | "pin" : "Pin an issue" , issue_pin
  | "reopen" : "Reopen issue" , issue_reopen
  | "transfer" : "Transfer issue to another repository" , issue_transfer
  | "unlock" : "Unlock issue conversation" , issue_unlock
  | "unpin" : "Unpin an issue" , issue_unpin
  | "view" : "View an issue" , issue_view ;

issue_artifact = [ issue_artifact_command ] ;

issue_artifact_command =
    "create" : "Create issue artifacts (preview)" , issue_artifact_create
  | "delete" : "Delete issue artifacts (preview)" , issue_artifact_delete
  | "download" : "Download issue artifacts (preview)" , issue_artifact_download
  | "edit" : "Edit an issue artifact (preview)" , issue_artifact_edit
  | "list" : "List artifacts on an issue (preview)" , issue_artifact_list
  | "view" : "View an issue artifact (preview)" , issue_artifact_view ;

