(* ansible-playbook: checked against `ansible-playbook --help` of ansible-core 2.22.0
   (installed with pip, as on no machine here it was). Options go anywhere; long ones
   take their value as the next word or after `=`. The operands are playbook files.
   Unique-prefix abbreviations of long options, which argparse accepts, are not
   modelled. *)

ansible_playbook = { option | shared_option | @file } ;

option =
    "-t" : "Only run plays and tasks with these tags" , @any
  | "--tags" : "Only run plays and tasks with these tags" , @any
  | "--tags=" : "Only run plays and tasks with these tags" ~ @any
  | "--skip-tags" : "Skip plays and tasks with these tags" , @any
  | "--skip-tags=" : "Skip plays and tasks with these tags" ~ @any
  | "--list-tags" : "List all available tags"
  | "--list-tasks" : "List the tasks that would run"
  | "--start-at-task" : "Start at the task with this name" , @any
  | "--start-at-task=" : "Start at the task with this name" ~ @any
  | "--step" : "Confirm each task before running it"
  | "--syntax-check" : "Check the playbook syntax without running it"
  | "--force-handlers" : "Run handlers even if a task fails" ;

(* Options ansible and ansible-playbook share. *)
shared_option =
    "-h" : "Show the help and exit" | "--help" : "Show the help and exit"
  | "--version" : "Show the version and configuration and exit"
  | "-v" : "More debug messages (-vvv, -vvvv for more)" | "--verbose" : "More debug messages (-vvv, -vvvv for more)"
  | "-i" : "Inventory path or comma separated host list" , ( @file | @any )
  | "--inventory" : "Inventory path or comma separated host list" , ( @file | @any )
  | "--inventory=" : "Inventory path or comma separated host list" ~ @file
  | "--inventory-file" : "Inventory path or comma separated host list" , ( @file | @any )
  | "--inventory-file=" : "Inventory path or comma separated host list" ~ @file
  | "-l" : "Limit the hosts to this pattern" , @any
  | "--limit" : "Limit the hosts to this pattern" , @any | "--limit=" : "Limit the hosts to this pattern" ~ @any
  | "--list-hosts" : "List the matching hosts without running anything"
  | "--flush-cache" : "Clear the fact cache of every host"
  | "-e" : "Extra variables as key=value, YAML/JSON or @file" , @any
  | "--extra-vars" : "Extra variables as key=value, YAML/JSON or @file" , @any
  | "--extra-vars=" : "Extra variables as key=value, YAML/JSON or @file" ~ @any
  | "-C" : "Do not make changes, predict them" | "--check" : "Do not make changes, predict them"
  | "-D" : "Show the differences in changed files" | "--diff" : "Show the differences in changed files"
  | "-f" : "Number of parallel processes (default 5)" , @number
  | "--forks" : "Number of parallel processes (default 5)" , @number
  | "--forks=" : "Number of parallel processes (default 5)" ~ @number
  | "-M" : "Prepend paths to the module library" , @directory
  | "--module-path" : "Prepend paths to the module library" , @directory
  | "--module-path=" : "Prepend paths to the module library" ~ @directory
    (* Vault *)
  | "--vault-id" : "Vault identity to use" , @any | "--vault-id=" : "Vault identity to use" ~ @any
  | "-J" : "Ask for the vault password"
  | "--ask-vault-password" : "Ask for the vault password" | "--ask-vault-pass" : "Ask for the vault password"
  | "--vault-password-file" : "Vault password file" , @file
  | "--vault-password-file=" : "Vault password file" ~ @file
  | "--vault-pass-file" : "Vault password file" , @file
  | "--vault-pass-file=" : "Vault password file" ~ @file
    (* Privilege escalation *)
  | "-b" : "Run operations with become" | "--become" : "Run operations with become"
  | "--become-method" : "Privilege escalation method (default sudo)" , become_method
  | "--become-method=" : "Privilege escalation method (default sudo)" ~ become_method
  | "--become-user" : "Run operations as this user (default root)" , @any
  | "--become-user=" : "Run operations as this user (default root)" ~ @any
  | "-K" : "Ask for the privilege escalation password" | "--ask-become-pass" : "Ask for the privilege escalation password"
  | "--become-password-file" : "Become password file" , @file
  | "--become-password-file=" : "Become password file" ~ @file
  | "--become-pass-file" : "Become password file" , @file
  | "--become-pass-file=" : "Become password file" ~ @file
    (* Connection *)
  | "--private-key" : "Authenticate the connection with this key" , @file
  | "--private-key=" : "Authenticate the connection with this key" ~ @file
  | "--key-file" : "Authenticate the connection with this key" , @file
  | "--key-file=" : "Authenticate the connection with this key" ~ @file
  | "-u" : "Connect as this user" , @any
  | "--user" : "Connect as this user" , @any | "--user=" : "Connect as this user" ~ @any
  | "-c" : "Connection type (default ssh)" , connection
  | "--connection" : "Connection type (default ssh)" , connection
  | "--connection=" : "Connection type (default ssh)" ~ connection
  | "-T" : "Connection timeout in seconds" , @number
  | "--timeout" : "Connection timeout in seconds" , @number | "--timeout=" : "Connection timeout in seconds" ~ @number
  | "--ssh-common-args" : "Arguments for sftp, scp and ssh" , @any
  | "--ssh-common-args=" : "Arguments for sftp, scp and ssh" ~ @any
  | "--sftp-extra-args" : "Extra arguments for sftp only" , @any
  | "--sftp-extra-args=" : "Extra arguments for sftp only" ~ @any
  | "--scp-extra-args" : "Extra arguments for scp only" , @any
  | "--scp-extra-args=" : "Extra arguments for scp only" ~ @any
  | "--ssh-extra-args" : "Extra arguments for ssh only" , @any
  | "--ssh-extra-args=" : "Extra arguments for ssh only" ~ @any
  | "-k" : "Ask for the connection password" | "--ask-pass" : "Ask for the connection password"
  | "--connection-password-file" : "Connection password file" , @file
  | "--connection-password-file=" : "Connection password file" ~ @file
  | "--conn-pass-file" : "Connection password file" , @file
  | "--conn-pass-file=" : "Connection password file" ~ @file ;

(* The become and connection plugins ansible-core ships; collections add more. *)
become_method = "sudo" | "su" | "runas" | @any ;
connection = "ssh" | "local" | "winrm" | "psrp" | @any ;
