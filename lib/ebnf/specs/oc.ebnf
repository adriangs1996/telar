replace_option =
    opt_allow_missing_template_keys
  | opt_cascade
  | opt_dry_run2
  | opt_field_manager
  | "-f" : "The files that contain the configurations to replace" , @file | "--filename" : "The files that contain the configurations to replace" , @file | "--filename=" : "The files that contain the configurations to replace" ~ @file
  | opt_force
  | opt_grace_period
  | opt_kustomize2
  | opt_output
  | "--raw" : "Raw URI to PUT to the server" , @any | "--raw=" : "Raw URI to PUT to the server" ~ @any
  | opt_recursive
  | opt_save_config
  | opt_show_managed_fields
  | opt_subresource
  | opt_template
  | opt_timeout
  | opt_validate
  | opt_wait ;

patch_option =
    opt_allow_missing_template_keys
  | opt_dry_run2
  | opt_field_manager
  | "-f" : "Filename, directory, or URL to files identifying the resource to update" , @file | "--filename" : "Filename, directory, or URL to files identifying the resource to update" , @file | "--filename=" : "Filename, directory, or URL to files identifying the resource to update" ~ @file
  | opt_kustomize
  | "--local" : "Patch the content of the file, not the server-side resource"
  | opt_output
  | "-p" : "The patch to be applied to the resource JSON file" , @any | "--patch" : "The patch to be applied to the resource JSON file" , @any | "--patch=" : "The patch to be applied to the resource JSON file" ~ @any
  | "--patch-file" : "A file containing a patch to be applied to the resource" , @any | "--patch-file=" : "A file containing a patch to be applied to the resource" ~ @any
  | opt_recursive
  | opt_show_managed_fields
  | opt_subresource
  | opt_template
  | "--type" : "The type of patch being provided" , @any | "--type=" : "The type of patch being provided" ~ @any ;

process_option =
    opt_allow_missing_template_keys
  | "-f" : "Filename or URL to file to read a template" , @file | "--filename" : "Filename or URL to file to read a template" , @file | "--filename=" : "Filename or URL to file to read a template" ~ @file
  | opt_ignore_unknown_parameters
  | "-l" : "Label to set in all resources for this template" , @any | "--labels" : "Label to set in all resources for this template" , @any | "--labels=" : "Label to set in all resources for this template" ~ @any
  | "--local" : "If true process the template locally instead of contacting the server"
  | opt_output
  | opt_param
  | "--param-file" : "File of template parameter values to set or override" , @any | "--param-file=" : "File of template parameter values to set or override" ~ @any
  | "--parameters" : "Do not process but only print available parameters"
  | "--raw" : "Output the processed template instead of the template's objects"
  | opt_show_managed_fields
  | opt_template ;

extract_option =
    "--confirm" : "Overwrite files that already exist"
  | "-f" : "Filename, directory, or URL to file to identify to extract the resource" | "--filename" : "Filename, directory, or URL to file to identify to extract the resource"
  | "--keys" : "An optional list of keys to extract"
  | "--to" : "Directory to extract files to" ;

observe_option =
    "-A" : "List the requested object(s) across all projects" | "--all-namespaces" : "List the requested object(s) across all projects"
  | opt_allow_missing_template_keys
  | "-d" : "A command to run when resources are deleted" | "--delete" : "A command to run when resources are deleted"
  | "--exit-after" : "Exit with status code 0 after the provided duration, optional"
  | "--listen-addr" : "Interface for the metrics and health endpoints"
  | "--maximum-errors" : "Exit after this many errors have been detected with"
  | "--names" : "A command that will list all of the currently known names, optional"
  | "--object-env-var" : "Env var that receives the serialized object"
  | "--once" : "Exit with a status code 0 after all current objects have been processed"
  | "-o" : "Output format" | "--output" : "Output format"
  | "--print-metrics-on-exit" : "On exit write all metrics to stdout"
  | "-q" : "Do not print each event before running the command" | "--quiet" : "Do not print each event before running the command"
  | "--resync-period" : "Reprocess every item as a Sync event at this interval"
  | "--retry-count" : "The number of times to retry a failing command before continuing"
  | "--retry-on-exit-code" : "If any command returns this exit code, retry up to --retry-count times"
  | "-l" : "Selector (label query) to filter on, supports '=', '==', and '!='" | "--selector" : "Selector (label query) to filter on, supports '=', '==', and '!='"
  | "--template" : "Template string or file for -o go-template or go-template-file"
  | "--type-env-var" : "Env var that receives the event type" ;

policy_command =
    "add-role-to-group" : "Add a role to groups for the project" , { global_option | @any }
  | "add-role-to-user" : "Add a role to users or service accounts for the current project" , { global_option | @any }
  | "remove-group" : "Remove group from the project" , { global_option | @any }
