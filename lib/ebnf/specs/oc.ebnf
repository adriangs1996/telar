(* oc: the OpenShift client. Every command `oc --help` lists, checked against
   `oc <command> --help` and `oc options` of oc 4.16.13. OpenShift resource types
   come from the examples and usage lines of that help (bc, dc, is, istag, routes, ...).

   Conventions:
   - The global options (`oc options`) are accepted before and after the command.
   - Options with a value accept `--name value` and `--name=value`; short ones accept
     `-x value` and `-xvalue`. Boolean flags are modelled bare; `--flag=false` is not.
   - --dry-run, --validate and --cascade take their value only joined (--dry-run=client),
     as pflag reads options that have a default for the bare flag.
   - Resource names, pods, containers, projects and contexts have no provider yet:
     @any. Resource types are offered as literals after get, describe, delete, ...
   - Words after `--` in exec, rsh, run and debug belong to the command run in the pod.
   - The subcommands of adm, image, policy, registry, secrets and the less used create
     and set subcommands are listed by name; their words are not checked.
   - `opt_*` rules are options several commands share. *)

oc = { global_option } , [ command ] ;

global_option =
    "--as" : "Username to impersonate for the operation" , @any | "--as=" : "Username to impersonate for the operation" ~ @any
  | "--as-group" : "Group to impersonate for the operation" , @any | "--as-group=" : "Group to impersonate for the operation" ~ @any
  | "--as-uid" : "UID to impersonate for the operation" , @any | "--as-uid=" : "UID to impersonate for the operation" ~ @any
  | "--cache-dir" : "Default cache directory" , @directory | "--cache-dir=" : "Default cache directory" ~ @directory
  | opt_certificate_authority
  | "--client-certificate" : "Path to a client certificate file for TLS" , @file | "--client-certificate=" : "Path to a client certificate file for TLS" ~ @file
  | "--client-key" : "Path to a client key file for TLS" , @file | "--client-key=" : "Path to a client key file for TLS" ~ @file
  | "--cluster" : "The name of the kubeconfig cluster to use" , @any | "--cluster=" : "The name of the kubeconfig cluster to use" ~ @any
  | "--context" : "The name of the kubeconfig context to use" , @any | "--context=" : "The name of the kubeconfig context to use" ~ @any
  | "--disable-compression" : "Opt-out of response compression for all requests to the server"
  | opt_insecure_skip_tls_verify
  | "--kubeconfig" : "Path to the kubeconfig file to use for CLI requests" , @file | "--kubeconfig=" : "Path to the kubeconfig file to use for CLI requests" ~ @file
  | "--log-flush-frequency" : "Maximum number of seconds between log flushes" , @any | "--log-flush-frequency=" : "Maximum number of seconds between log flushes" ~ @any
  | "--loglevel" : "Set the level of log output (0-10)" , @any | "--loglevel=" : "Set the level of log output (0-10)" ~ @any
  | "--match-server-version" : "Require server version to match client version"
  | "-n" : "The namespace scope for this CLI request" , @any | "--namespace" : "The namespace scope for this CLI request" , @any | "--namespace=" : "The namespace scope for this CLI request" ~ @any
  | "--profile" : "Name of profile to capture" , profile_value | "--profile=" : "Name of profile to capture" ~ profile_value
  | "--profile-output" : "Name of the file to write the profile to" , @file | "--profile-output=" : "Name of the file to write the profile to" ~ @file
  | "--request-timeout" : "The length of time to wait before giving up on a single server request" , @any | "--request-timeout=" : "The length of time to wait before giving up on a single server request" ~ @any
  | "-s" : "The address and port of the Kubernetes API server" , @any | "--server" : "The address and port of the Kubernetes API server" , @any | "--server=" : "The address and port of the Kubernetes API server" ~ @any
  | "--tls-server-name" : "Server name to use for server certificate validation" , @any | "--tls-server-name=" : "Server name to use for server certificate validation" ~ @any
  | opt_token
  | "--user" : "The name of the kubeconfig user to use" , @any | "--user=" : "The name of the kubeconfig user to use" ~ @any
  | "-v" : "Number for the log level verbosity" , @any | "--v" : "Number for the log level verbosity" , @any | "--v=" : "Number for the log level verbosity" ~ @any
  | "--vmodule" : "Comma-separated list of pattern=N settings for file-filtered logging" , @any | "--vmodule=" : "Comma-separated list of pattern=N settings for file-filtered logging" ~ @any
  | "--warnings-as-errors" : "Treat warnings from the server as errors" ;

login_option =
    "-c" : "Port for the callback server when using --web" , @any | "--callback-port" : "Port for the callback server when using --web" , @any | "--callback-port=" : "Port for the callback server when using --web" ~ @any
  | "--client-id" : "Experimental: Client ID for external OIDC issuer" , @any | "--client-id=" : "Experimental: Client ID for external OIDC issuer" ~ @any
  | "--client-secret" : "Experimental: Client secret for external OIDC issuer" , @any | "--client-secret=" : "Experimental: Client secret for external OIDC issuer" ~ @any
  | "--exec-plugin" : "Experimental: credentials exec plugin type for an external OIDC issuer" , @any | "--exec-plugin=" : "Experimental: credentials exec plugin type for an external OIDC issuer" ~ @any
  | "--extra-scopes" : "Experimental: Extra scopes for external OIDC issuer" , @any | "--extra-scopes=" : "Experimental: Extra scopes for external OIDC issuer" ~ @any
  | "--issuer-url" : "Experimental: Issuer url for external issuer" , @any | "--issuer-url=" : "Experimental: Issuer url for external issuer" ~ @any
  | "--oidc-certificate-authority" : "Experimental: CA bundle for the external OIDC issuer" , @any | "--oidc-certificate-authority=" : "Experimental: CA bundle for the external OIDC issuer" ~ @any
  | "-p" : "Password for server" , @any | "--password" : "Password for server" , @any | "--password=" : "Password for server" ~ @any
  | "-u" : "Username for server" , @any | "--username" : "Username for server" , @any | "--username=" : "Username for server" ~ @any
  | "-w" : "Login with web browser" | "--web" : "Login with web browser"
  | opt_certificate_authority
  | opt_insecure_skip_tls_verify
  | opt_token ;

new_project_option =
    "--description" : "Project description" , @any | "--description=" : "Project description" ~ @any
  | "--display-name" : "Project display name" , @any | "--display-name=" : "Project display name" ~ @any
  | "--skip-config-write" : "Do not switch kubeconfig to the new project" ;

new_app_option =
    opt_allow_missing_images
  | opt_allow_missing_imagestream_tags
  | opt_allow_missing_template_keys
  | "--as-deployment-config" : "Create the application as a deployment config"
  | "--as-test" : "Create a test deployment that scales down once it succeeds"
  | opt_binary
  | "--build-env" : "Environment variable for each build image, as key=value" , @any | "--build-env=" : "Environment variable for each build image, as key=value" ~ @any
  | "--build-env-file" : "File of environment variables to set in each build image" , @any | "--build-env-file=" : "File of environment variables to set in each build image" ~ @any
  | "--code" : "Source code to use to build this application" , @any | "--code=" : "Source code to use to build this application" ~ @any
  | opt_context_dir
  | opt_dry_run
  | opt_env
  | opt_env_file
  | "-f" : "Path to a template file to use for the app" , @any | "--file" : "Path to a template file to use for the app" , @any | "--file=" : "Path to a template file to use for the app" ~ @any
  | "--grant-install-rights" : "Let components use your token to install software into the project"
  | "--group" : "Indicate components that should be grouped together as <comp1>+<comp2>" , @any | "--group=" : "Indicate components that should be grouped together as <comp1>+<comp2>" ~ @any
  | opt_ignore_unknown_parameters
  | "--image" : "Name of a container image to include in the app" , @any | "--image=" : "Name of a container image to include in the app" ~ @any
  | "-i" : "Name of an existing image stream to use to deploy an app" , @any | "--image-stream" : "Name of an existing image stream to use to deploy an app" , @any | "--image-stream=" : "Name of an existing image stream to use to deploy an app" ~ @any
  | opt_import_mode
  | opt_insecure_registry
  | "-l" : "Label to set in all resources for this application" , @any | "--labels" : "Label to set in all resources for this application" , @any | "--labels=" : "Label to set in all resources for this application" ~ @any
  | "-L" : "List all local templates and image streams that can be used to create" | "--list" : "List all local templates and image streams that can be used to create"
  | "--name" : "Set name to use for generated application artifacts" , @any | "--name=" : "Set name to use for generated application artifacts" ~ @any
  | "--no-install" : "Do not run images that describe themselves as installable"
  | opt_output
  | opt_output_version
  | opt_param
  | "--param-file" : "File containing parameter values to set/override in the template" , @any | "--param-file=" : "File containing parameter values to set/override in the template" ~ @any
  | "-S" : "Search templates, image streams and images matching the arguments" | "--search" : "Search templates, image streams and images matching the arguments"
  | opt_show_all
  | opt_show_labels
  | opt_show_managed_fields
  | opt_sort_by
  | opt_source_secret
  | opt_strategy
  | "--template" : "Name of a stored template to use in the app" , @any | "--template=" : "Name of a stored template to use in the app" ~ @any ;

status_option =
    "-A" : "Display status for all namespaces (must have cluster admin)" | "--all-namespaces" : "Display status for all namespaces (must have cluster admin)"
  | opt_output
  | "--suggest" : "See details for resolving issues" ;

project_option = "-q" : "Display only the project name" | "--short" : "Display only the project name" ;

projects_option = "-q" : "Display only the project names" | "--short" : "Display only the project names" ;

explain_option =
    "--api-version" : "Use given api-version (group/version) of the resource" , @any | "--api-version=" : "Use given api-version (group/version) of the resource" ~ @any
  | "--output" : "Format in which to render the schema" , output_format | "--output=" : "Format in which to render the schema" ~ output_name
  | "--recursive" : "When true, print the name of all the fields recursively" ;

rollout_cancel_option =
    opt_allow_missing_template_keys
  | opt_filename
  | opt_kustomize
  | opt_output
  | opt_recursive
  | opt_show_managed_fields
  | opt_template ;

rollout_history_option =
    opt_allow_missing_template_keys
  | opt_filename
  | opt_kustomize
  | opt_output
  | opt_recursive
  | "--revision" : "See the details, including podTemplate of the revision specified" , @any | "--revision=" : "See the details, including podTemplate of the revision specified" ~ @any
  | opt_selector
  | opt_show_managed_fields
  | opt_template ;

rollout_latest_option =
    "--again" : "Deploy the current pod template without updating state from triggers"
  | opt_allow_missing_template_keys
  | opt_dry_run2
  | opt_output
  | opt_show_managed_fields
  | opt_template ;

rollout_pause_option =
    opt_allow_missing_template_keys
  | opt_field_manager
  | opt_filename
  | opt_kustomize
  | opt_output
  | opt_recursive
  | opt_selector
  | opt_show_managed_fields
  | opt_template ;

rollout_status_option =
    opt_filename
  | opt_kustomize
  | opt_recursive
  | "--revision" : "Pin to a specific revision for showing its status" , @any | "--revision=" : "Pin to a specific revision for showing its status" ~ @any
  | opt_selector
  | "--timeout" : "The length of time to wait before ending watch, zero means never" , @any | "--timeout=" : "The length of time to wait before ending watch, zero means never" ~ @any
  | "-w" : "Watch the status of the rollout until it's done" | "--watch" : "Watch the status of the rollout until it's done" ;

rollout_undo_option =
    opt_allow_missing_template_keys
  | opt_dry_run2
  | opt_filename
  | opt_kustomize
  | opt_output
  | opt_recursive
  | opt_selector
  | opt_show_managed_fields
  | opt_template
  | "--to-revision" : "The revision to rollback to" , @any | "--to-revision=" : "The revision to rollback to" ~ @any ;

rollout_command =
    "cancel" : "Cancel the in-progress deployment" , { rollout_cancel_option | global_option | @any }
  | "history" : "View rollout history" , { rollout_history_option | global_option | resource_type | @any }
  | "latest" : "Start a new rollout of a deployment config from its triggers" , { rollout_latest_option | global_option | @any }
  | "pause" : "Mark the provided resource as paused" , { rollout_pause_option | global_option | resource_type | @any }
  | "restart" : "Restart a resource" , { rollout_pause_option | global_option | resource_type | @any }
  | "resume" : "Resume a paused resource" , { rollout_pause_option | global_option | resource_type | @any }
  | "retry" : "Retry the latest failed rollout" , { rollout_cancel_option | global_option | @any }
  | "status" : "Show the status of the rollout" , { rollout_status_option | global_option | resource_type | @any }
  | "undo" : "Undo a previous rollout" , { rollout_undo_option | global_option | resource_type | @any } ;

rollback_option =
    opt_allow_missing_template_keys
  | "--change-scaling-settings" : "Include the previous replica count and selector in the rollback"
  | "--change-strategy" : "Include the previous deployment's strategy in the rollback"
  | "--change-triggers" : "Include the previous deployment's triggers in the rollback"
  | "-d" : "Describe the rollback instead of performing it" | "--dry-run" : "Describe the rollback instead of performing it" | "--dry-run=" : "Describe the rollback instead of performing it" ~ ( "none" | "server" | "client" )
  | opt_output
  | opt_show_managed_fields
  | opt_template
  | "--to-version" : "A config version to rollback to" , @any | "--to-version=" : "A config version to rollback to" ~ @any ;

new_build_option =
    opt_allow_missing_images
  | opt_allow_missing_imagestream_tags
  | opt_allow_missing_template_keys
  | opt_binary
  | opt_build_arg
  | "--build-config-map" : "ConfigMap and destination to use as an input for the build" , @any | "--build-config-map=" : "ConfigMap and destination to use as an input for the build" ~ @any
  | "--build-secret" : "Secret and destination to use as an input for the build" , @any | "--build-secret=" : "Secret and destination to use as an input for the build" ~ @any
  | "--code" : "Source code in the build configuration" , @any | "--code=" : "Source code in the build configuration" ~ @any
  | opt_context_dir
  | "-D" : "Dockerfile contents to build, implies --strategy=docker" , @any | "--dockerfile" : "Dockerfile contents to build, implies --strategy=docker" , @any | "--dockerfile=" : "Dockerfile contents to build, implies --strategy=docker" ~ @any
  | opt_dry_run
  | "-e" : "Environment variable for the resulting image, as key=value" , @any | "--env" : "Environment variable for the resulting image, as key=value" , @any | "--env=" : "Environment variable for the resulting image, as key=value" ~ @any
  | opt_env_file
  | "--image" : "Name of a container image to use as a builder" , @any | "--image=" : "Name of a container image to use as a builder" ~ @any
  | "-i" : "Name of an image stream to to use as a builder" , @any | "--image-stream" : "Name of an image stream to to use as a builder" , @any | "--image-stream=" : "Name of an image stream to to use as a builder" ~ @any
  | opt_import_mode
  | opt_insecure_registry
  | "-l" : "Label to set in all generated resources" , @any | "--labels" : "Label to set in all generated resources" , @any | "--labels=" : "Label to set in all generated resources" ~ @any
  | "--name" : "Set name to use for generated build artifacts" , @any | "--name=" : "Set name to use for generated build artifacts" ~ @any
  | "--no-output" : "The build output will not be pushed anywhere"
  | opt_output
  | opt_output_version
  | "--push-secret" : "Secret for pushing the output image" , @any | "--push-secret=" : "Secret for pushing the output image" ~ @any
  | opt_show_all
  | opt_show_labels
  | opt_show_managed_fields
  | "--source-image" : "Specify an image to use as source for the build" , @any | "--source-image=" : "Specify an image to use as source for the build" ~ @any
  | "--source-image-path" : "Path to copy from the source image, and its build destination" , @any | "--source-image-path=" : "Path to copy from the source image, and its build destination" ~ @any
  | opt_source_secret
  | opt_strategy
  | opt_template
  | "--to" : "Push built images to this image stream tag" , @any | "--to=" : "Push built images to this image stream tag" ~ @any
  | "--to-docker" : "Have the build output push to a Docker repository" ;

start_build_option =
    opt_allow_missing_template_keys
  | opt_build_arg
  | "--build-loglevel" : "Specify the log level for the build log output" , @any | "--build-loglevel=" : "Specify the log level for the build log output" ~ @any
  | "--commit" : "Specify the source code commit identifier the build should use" , @any | "--commit=" : "Specify the source code commit identifier the build should use" ~ @any
  | "-e" : "Environment variable for the build container, as key=value" , @any | "--env" : "Environment variable for the build container, as key=value" , @any | "--env=" : "Environment variable for the build container, as key=value" ~ @any
  | "--exclude" : "With --from-dir, regex of files to exclude from the build" , @any | "--exclude=" : "With --from-dir, regex of files to exclude from the build" ~ @any
  | "-F" : "Start a build and watch its logs until it completes or fails" | "--follow" : "Start a build and watch its logs until it completes or fails"
  | "--from-archive" : "An archive to be extracted before the build and used as the binary input" , @any | "--from-archive=" : "An archive to be extracted before the build and used as the binary input" ~ @any
  | "--from-build" : "Specify the name of a build which should be re-run" , @any | "--from-build=" : "Specify the name of a build which should be re-run" ~ @any
  | "--from-dir" : "A directory to archive and use as the binary input for a build" , @any | "--from-dir=" : "A directory to archive and use as the binary input for a build" ~ @any
  | "--from-file" : "A file to use as the binary input for the build" , @any | "--from-file=" : "A file to use as the binary input for the build" ~ @any
  | "--from-repo" : "Local source repository to use as the binary input" , @any | "--from-repo=" : "Local source repository to use as the binary input" ~ @any
  | "--from-webhook" : "Specify a generic webhook URL for an existing build config to trigger" , @any | "--from-webhook=" : "Specify a generic webhook URL for an existing build config to trigger" ~ @any
  | "--git-post-receive" : "The contents of the post-receive hook to trigger a build" , @any | "--git-post-receive=" : "The contents of the post-receive hook to trigger a build" ~ @any
  | "--git-repository" : "The path to the git repository for post-receive" , @any | "--git-repository=" : "The path to the git repository for post-receive" ~ @any
  | "--incremental" : "Override the incremental setting of a source-strategy build"
  | "--list-webhooks" : "List the webhooks for the specified build config or build" , @any | "--list-webhooks=" : "List the webhooks for the specified build config or build" ~ @any
  | "--no-cache" : "Override the noCache setting of a docker-strategy build"
  | opt_output
  | opt_show_managed_fields
  | opt_template
  | "-w" : "Wait for the build, exit nonzero if it fails" | "--wait" : "Wait for the build, exit nonzero if it fails" ;

cancel_build_option =
    "--dump-logs" : "Specify if the build logs for the cancelled build should be shown"
  | "--restart" : "Start a new build after cancelling the current one"
  | "--state" : "Only cancel builds in this state" , @any | "--state=" : "Only cancel builds in this state" ~ @any ;

import_image_option =
    "--all" : "Import all tags from the source"
  | opt_allow_missing_template_keys
  | "--confirm" : "Allow the image stream import location to be set or changed"
  | "--dry-run" : "Fetch image information without creating or updating an image stream" | "--dry-run=" : "Fetch image information without creating or updating an image stream" ~ ( "none" | "server" | "client" )
  | "--from" : "A container image repository to import images from" , @any | "--from=" : "A container image repository to import images from" ~ @any
  | opt_import_mode
  | "--insecure" : "Allow registries with invalid HTTPS certificates or plain HTTP"
  | opt_output
  | opt_reference_policy
  | "--scheduled" : "Import each image periodically from its remote repository"
  | opt_show_managed_fields
  | opt_template ;

tag_option =
    "--alias" : "Should the destination tag be updated whenever the source tag changes"
  | "-d" : "Delete the provided spec tags" | "--delete" : "Delete the provided spec tags"
  | opt_import_mode
  | "--insecure" : "The image registry uses HTTP or a self-signed certificate"
  | "--reference" : "Should the destination tag continue to pull from the source namespace"
  | opt_reference_policy
  | "--scheduled" : "Import the image periodically from its remote repository"
  | "--source" : "Optional hint for the source type" , @any | "--source=" : "Optional hint for the source type" ~ @any ;

create_configmap_option =
    opt_allow_missing_template_keys
  | "--append-hash" : "Append a hash of the configmap to its name"
  | opt_dry_run2
  | opt_field_manager
  | "--from-env-file" : "File of key=val lines to create the config map from" , @file | "--from-env-file=" : "File of key=val lines to create the config map from" ~ @file
  | opt_from_file
  | "--from-literal" : "Specify a key and literal value to insert in configmap" , @any | "--from-literal=" : "Specify a key and literal value to insert in configmap" ~ @any
  | opt_output
  | opt_save_config
  | opt_show_managed_fields
  | opt_template
  | opt_validate ;

create_cronjob_option =
    opt_allow_missing_template_keys
  | opt_dry_run2
  | opt_field_manager
  | opt_image
  | opt_output
  | "--restart" : "Job's restart policy. supported values: OnFailure, Never" , @any | "--restart=" : "Job's restart policy. supported values: OnFailure, Never" ~ @any
  | opt_save_config
  | "--schedule" : "A schedule in the Cron format the job should be run with" , @any | "--schedule=" : "A schedule in the Cron format the job should be run with" ~ @any
  | opt_show_managed_fields
  | opt_template
  | opt_validate ;

create_deployment_option =
    opt_allow_missing_template_keys
  | opt_dry_run2
  | opt_field_manager
  | "--image" : "Image names to run" , @any | "--image=" : "Image names to run" ~ @any
  | opt_output
  | opt_port
  | "-r" : "Number of replicas to create" , @any | "--replicas" : "Number of replicas to create" , @any | "--replicas=" : "Number of replicas to create" ~ @any
  | opt_save_config
  | opt_show_managed_fields
  | opt_template
  | opt_validate ;

create_ingress_option =
    opt_allow_missing_template_keys
  | "--annotation" : "Annotation to insert in the ingress object" , @any | "--annotation=" : "Annotation to insert in the ingress object" ~ @any
  | "--class" : "Ingress Class to be used" , @any | "--class=" : "Ingress Class to be used" ~ @any
  | "--default-backend" : "Default service for backend, in format of svcname:port" , @any | "--default-backend=" : "Default service for backend, in format of svcname:port" ~ @any
  | opt_dry_run2
  | opt_field_manager
  | opt_output
  | "--rule" : "Rule in format host/path=service:port[,tls=secretname]" , @any | "--rule=" : "Rule in format host/path=service:port[,tls=secretname]" ~ @any
  | opt_save_config
  | opt_show_managed_fields
  | opt_template
  | opt_validate ;

create_job_option =
    opt_allow_missing_template_keys
  | opt_dry_run2
  | opt_field_manager
  | "--from" : "The name of the resource to create a Job from" , @any | "--from=" : "The name of the resource to create a Job from" ~ @any
  | opt_image
  | opt_output
  | opt_save_config
  | opt_show_managed_fields
  | opt_template
  | opt_validate ;

create_namespace_option =
    opt_allow_missing_template_keys
  | opt_dry_run2
  | opt_field_manager
  | opt_output
  | opt_save_config
  | opt_show_managed_fields
  | opt_template
  | opt_validate ;

create_route_command =
    "edge" : "Create a route that uses edge TLS termination" , { global_option | @any }
  | "passthrough" : "Create a route that uses passthrough TLS termination" , { global_option | @any }
  | "reencrypt" : "Create a route that uses reencrypt TLS termination" , { global_option | @any } ;

create_secret_docker_registry_option =
    opt_allow_missing_template_keys
  | opt_append_hash
  | "--docker-email" : "Email for Docker registry" , @any | "--docker-email=" : "Email for Docker registry" ~ @any
  | "--docker-password" : "Password for Docker registry authentication" , @any | "--docker-password=" : "Password for Docker registry authentication" ~ @any
  | "--docker-server" : "Server location for Docker registry" , @any | "--docker-server=" : "Server location for Docker registry" ~ @any
  | "--docker-username" : "Username for Docker registry authentication" , @any | "--docker-username=" : "Username for Docker registry authentication" ~ @any
  | opt_dry_run2
  | opt_field_manager
  | opt_from_file
  | opt_output
  | opt_save_config
  | opt_show_managed_fields
  | opt_template
  | opt_validate ;

create_secret_generic_option =
    opt_allow_missing_template_keys
  | opt_append_hash
  | opt_dry_run2
  | opt_field_manager
  | "--from-env-file" : "File of key=val lines to create the secret from" , @file | "--from-env-file=" : "File of key=val lines to create the secret from" ~ @file
  | opt_from_file
  | "--from-literal" : "Specify a key and literal value to insert in secret" , @any | "--from-literal=" : "Specify a key and literal value to insert in secret" ~ @any
  | opt_output
