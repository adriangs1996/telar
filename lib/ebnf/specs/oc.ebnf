auth_can_i_option =
    opt_all_namespaces2
  | "--list" : "Prints all allowed actions"
  | "--no-headers" : "Prints allowed actions without headers"
  | "-q" : "Suppress output and just return the exit code" | "--quiet" : "Suppress output and just return the exit code"
