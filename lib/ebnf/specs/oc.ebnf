proxy_option =
    "--accept-hosts" : "Regular expression for hosts that the proxy should accept" , @any | "--accept-hosts=" : "Regular expression for hosts that the proxy should accept" ~ @any
  | "--accept-paths" : "Regular expression for paths that the proxy should accept" , @any | "--accept-paths=" : "Regular expression for paths that the proxy should accept" ~ @any
  | "--address" : "The IP address on which to serve on" , @any | "--address=" : "The IP address on which to serve on" ~ @any
  | "--api-prefix" : "Prefix to serve the proxied API under" , @any | "--api-prefix=" : "Prefix to serve the proxied API under" ~ @any
  | "--append-server-path" : "Append the kube context server path to each request"
  | "--disable-filter" : "Disable request filtering in the proxy"
  | "--keepalive" : "Keep-alive period of an active network connection" , @any | "--keepalive=" : "Keep-alive period of an active network connection" ~ @any
  | "-p" : "The port on which to run the proxy" , @any | "--port" : "The port on which to run the proxy" , @any | "--port=" : "The port on which to run the proxy" ~ @any
  | "--reject-methods" : "Regular expression for HTTP methods that the proxy should reject" , @any | "--reject-methods=" : "Regular expression for HTTP methods that the proxy should reject" ~ @any
  | "--reject-paths" : "Regular expression for paths that the proxy should reject" , @any | "--reject-paths=" : "Regular expression for paths that the proxy should reject" ~ @any
  | "-u" : "Unix socket on which to run the proxy" , @any | "--unix-socket" : "Unix socket on which to run the proxy" , @any | "--unix-socket=" : "Unix socket on which to run the proxy" ~ @any
  | "-w" : "Also serve static files from this directory" , @any | "--www" : "Also serve static files from this directory" , @any | "--www=" : "Also serve static files from this directory" ~ @any
  | "-P" : "Prefix to serve static files under" , @any | "--www-prefix" : "Prefix to serve static files under" , @any | "--www-prefix=" : "Prefix to serve static files under" ~ @any ;

attach_option =
    opt_container
  | opt_pod_running_timeout
  | opt_quiet
  | opt_stdin
  | opt_tty2 ;

run_option =
    opt_allow_missing_template_keys
  | "--annotations" : "Annotations to apply to the pod" , @any | "--annotations=" : "Annotations to apply to the pod" ~ @any
  | "--attach" : "Wait for the pod to start running, then attach to it"
  | "--command" : "Use extra arguments as the container's command, not its args"
  | opt_dry_run2
  | "--env" : "Environment variables to set in the container" , @any | "--env=" : "Environment variables to set in the container" ~ @any
  | "--expose" : "Create a ClusterIP service associated with the pod"
  | opt_field_manager
  | "--image" : "The image for the container to run" , @any | "--image=" : "The image for the container to run" ~ @any
  | "--image-pull-policy" : "The image pull policy for the container" , @any | "--image-pull-policy=" : "The image pull policy for the container" ~ @any
  | "-l" : "Comma separated labels to apply to the pod" , @any | "--labels" : "Comma separated labels to apply to the pod" , @any | "--labels=" : "Comma separated labels to apply to the pod" ~ @any
  | "--leave-stdin-open" : "Leave stdin open after the first attach completes"
  | opt_output
  | opt_override_type
  | opt_overrides
  | opt_pod_running_timeout
  | opt_port
  | "--privileged" : "Run the container in privileged mode"
  | "-q" : "Suppress prompt messages" | "--quiet" : "Suppress prompt messages"
  | "--restart" : "The restart policy for this Pod" , @any | "--restart=" : "The restart policy for this Pod" ~ @any
  | "--rm" : "Delete the pod after it exits"
  | opt_save_config
  | opt_show_managed_fields
  | "-i" : "Keep stdin open on the container in the pod, even if nothing is attached" | "--stdin" : "Keep stdin open on the container in the pod, even if nothing is attached"
  | opt_template
  | "-t" : "Allocate a TTY for the container in the pod" | "--tty" : "Allocate a TTY for the container in the pod" ;

cp_option =
    opt_container
  | "--no-preserve" : "Do not preserve ownership and permissions in the container"
  | "--retries" : "Set number of retries to complete a copy operation from a container" , @any | "--retries=" : "Set number of retries to complete a copy operation from a container" ~ @any ;

wait_option =
    opt_all
  | opt_all_namespaces
  | opt_allow_missing_template_keys
  | opt_field_selector
  | "-f" : "Identifying the resource" , @file | "--filename" : "Identifying the resource" , @file | "--filename=" : "Identifying the resource" ~ @file
  | "--for" : "Condition to wait on: delete, condition=NAME or jsonpath=EXPR" , @any | "--for=" : "Condition to wait on: delete, condition=NAME or jsonpath=EXPR" ~ @any
  | opt_local2
  | opt_output
  | opt_recursive
  | opt_selector
  | opt_show_managed_fields
  | opt_template
  | "--timeout" : "The length of time to wait before giving up" , @any | "--timeout=" : "The length of time to wait before giving up" ~ @any ;

events_option =
    opt_all_namespaces
  | opt_allow_missing_template_keys
  | opt_chunk_size
  | "--for" : "Filter events to only those pertaining to the specified resource" , @any | "--for=" : "Filter events to only those pertaining to the specified resource" ~ @any
  | "--no-headers" : "When using the default output format, don't print headers"
  | opt_output
  | opt_show_managed_fields
  | opt_template
  | "--types" : "Output only events of given types" , @any | "--types=" : "Output only events of given types" ~ @any
  | "-w" : "After listing the requested events, watch for more events" | "--watch" : "After listing the requested events, watch for more events" ;

