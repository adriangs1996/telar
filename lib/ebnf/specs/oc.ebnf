config_set_option = "--set-raw-bytes" : "Write a []byte value as given, without base64 decoding" ;

config_set_cluster_option =
    "--certificate-authority" : "Path to certificate-authority file for the cluster entry in kubeconfig" , @file | "--certificate-authority=" : "Path to certificate-authority file for the cluster entry in kubeconfig" ~ @file
  | "--embed-certs" : "Embed-certs for the cluster entry in kubeconfig"
  | "--insecure-skip-tls-verify" : "Insecure-skip-tls-verify for the cluster entry in kubeconfig"
  | "--proxy-url" : "Proxy-url for the cluster entry in kubeconfig" , @any | "--proxy-url=" : "Proxy-url for the cluster entry in kubeconfig" ~ @any
  | "--server" : "Server for the cluster entry in kubeconfig" , @any | "--server=" : "Server for the cluster entry in kubeconfig" ~ @any
  | "--tls-server-name" : "Tls-server-name for the cluster entry in kubeconfig" , @any | "--tls-server-name=" : "Tls-server-name for the cluster entry in kubeconfig" ~ @any ;

config_set_context_option =
    "--cluster" : "Cluster for the context entry in kubeconfig" , @any | "--cluster=" : "Cluster for the context entry in kubeconfig" ~ @any
  | "--current" : "Modify the current context"
  | "--namespace" : "Namespace for the context entry in kubeconfig" , @any | "--namespace=" : "Namespace for the context entry in kubeconfig" ~ @any
  | "--user" : "User for the context entry in kubeconfig" , @any | "--user=" : "User for the context entry in kubeconfig" ~ @any ;

config_set_credentials_option =
    "--auth-provider" : "Auth provider for the user entry in kubeconfig" , @any | "--auth-provider=" : "Auth provider for the user entry in kubeconfig" ~ @any
  | "--auth-provider-arg" : "'key=value' arguments for the auth provider" , @any | "--auth-provider-arg=" : "'key=value' arguments for the auth provider" ~ @any
  | "--client-certificate" : "Path to client-certificate file for the user entry in kubeconfig" , @file | "--client-certificate=" : "Path to client-certificate file for the user entry in kubeconfig" ~ @file
  | "--client-key" : "Path to client-key file for the user entry in kubeconfig" , @file | "--client-key=" : "Path to client-key file for the user entry in kubeconfig" ~ @file
  | "--embed-certs" : "Embed client cert/key for the user entry in kubeconfig"
  | "--exec-api-version" : "API version of the user's exec credential plugin" , @any | "--exec-api-version=" : "API version of the user's exec credential plugin" ~ @any
  | "--exec-arg" : "New arguments for the user's exec credential plugin" , @any | "--exec-arg=" : "New arguments for the user's exec credential plugin" ~ @any
  | "--exec-command" : "Command for the exec credential plugin for the user entry in kubeconfig" , @any | "--exec-command=" : "Command for the exec credential plugin for the user entry in kubeconfig" ~ @any
  | "--exec-env" : "'key=value' environment values for the exec credential plugin" , @any | "--exec-env=" : "'key=value' environment values for the exec credential plugin" ~ @any
  | "--password" : "Password for the user entry in kubeconfig" , @any | "--password=" : "Password for the user entry in kubeconfig" ~ @any
  | "--token" : "Token for the user entry in kubeconfig" , @any | "--token=" : "Token for the user entry in kubeconfig" ~ @any
  | "--username" : "Username for the user entry in kubeconfig" , @any | "--username=" : "Username for the user entry in kubeconfig" ~ @any ;

config_view_option =
    opt_allow_missing_template_keys
  | "--flatten" : "Flatten the resulting kubeconfig file into self-contained output"
  | "--merge" : "Merge the full hierarchy of kubeconfig files"
  | "--minify" : "Remove all information not used by current-context from the output"
  | opt_output
  | "--raw" : "Display raw byte data and sensitive data"
  | opt_show_managed_fields
  | opt_template ;

config_command =
    "current-context" : "Display the current-context" , { global_option }
  | "delete-cluster" : "Delete the specified cluster from the kubeconfig" , { global_option | @any }
  | "delete-context" : "Delete the specified context from the kubeconfig" , { global_option | @any }
  | "delete-user" : "Delete the specified user from the kubeconfig" , { global_option | @any }
  | "get-clusters" : "Display clusters defined in the kubeconfig" , { global_option }
  | "get-contexts" : "Describe one or many contexts" , { config_get_contexts_option | global_option | @any }
  | "get-users" : "Display users defined in the kubeconfig" , { global_option }
  | "new-admin-kubeconfig" : "Generate, make the server trust, and display a new admin.kubeconfig" , { global_option }
  | "new-kubelet-bootstrap-kubeconfig" : "Generate, trust and display a new kubelet kubeconfig" , { global_option }
  | "refresh-ca-bundle" : "Update the OpenShift CA bundle by contacting the apiserver" , { config_refresh_ca_bundle_option | global_option | @any }
  | "rename-context" : "Rename a context from the kubeconfig file" , { global_option | @any }
  | "set" : "Set an individual value in a kubeconfig file" , { config_set_option | global_option | @any }
  | "set-cluster" : "Set a cluster entry in kubeconfig" , { config_set_cluster_option | global_option | @any }
  | "set-context" : "Set a context entry in kubeconfig" , { config_set_context_option | global_option | @any }
  | "set-credentials" : "Set a user entry in kubeconfig" , { config_set_credentials_option | global_option | @any }
  | "unset" : "Unset an individual value in a kubeconfig file" , { global_option | @any }
  | "use-context" : "Set the current-context in a kubeconfig file" , { global_option | @any }
  | "view" : "Display merged kubeconfig settings or a specified kubeconfig file" , { config_view_option | global_option } ;

whoami_option =
    "--show-console" : "Print the current server's web console URL"
  | "-c" : "Print the current user context name" | "--show-context" : "Print the current user context name"
  | "--show-server" : "Print the current server's REST API URL"
  | "-t" : "Print the token the current session is using" | "--show-token" : "Print the token the current session is using" ;

plugin_command = "list" : "List all visible plugin executables on a user's PATH" , { global_option | @any } ;

version_option =
    "--client" : "Client version only (no server required)"
  | "-o" : "One of 'yaml' or 'json'" , output_format | "--output" : "One of 'yaml' or 'json'" , output_format | "--output=" : "One of 'yaml' or 'json'" ~ output_name ;

command =
    "login" : "Log in to a server" , { login_option | global_option | @any }
  | "new-project" : "Request a new project" , { new_project_option | global_option | @any }
  | "new-app" : "Create a new application" , { new_app_option | global_option | @any }
  | "status" : "Show an overview of the current project" , { status_option | global_option | @any }
  | "project" : "Switch to another project" , { project_option | global_option | @any }
  | "projects" : "Display existing projects" , { projects_option | global_option }
  | "explain" : "Get documentation for a resource" , { explain_option | global_option | resource_type | @any }
  | "rollout" : "Manage a Kubernetes deployment or OpenShift deployment config" , { global_option } , [ rollout_command ]
  | "rollback" : "Revert part of an application back to a previous deployment" , { rollback_option | global_option | resource_type | @any }
  | "new-build" : "Create a new build configuration" , { new_build_option | global_option | @any }
  | "start-build" : "Start a new build" , { start_build_option | global_option | @any }
  | "cancel-build" : "Cancel running, pending, or new builds" , { cancel_build_option | global_option | @any }
  | "import-image" : "Import images from a container image registry" , { import_image_option | global_option | @any }
  | "tag" : "Tag existing images into image streams" , { tag_option | global_option | @any }
  | "create" : "Create a resource from a file or from stdin" , { create_option | global_option } , [ create_command ]
  | "apply" : "Apply a configuration to a resource by file name or stdin" , { apply_option | global_option } , [ apply_command ]
  | "get" : "Display one or many resources" , { get_option | global_option | resource_type | @any }
  | "describe" : "Show details of a specific resource or group of resources" , { describe_option | global_option | resource_type | @any }
  | "edit" : "Edit a resource on the server" , { edit_option | global_option | resource_type | @any }
  | "set" : "Commands that help set specific features on objects" , { global_option } , [ set_command ]
  | "label" : "Update the labels on a resource" , { label_option | global_option | resource_type | @any }
  | "annotate" : "Update the annotations on a resource" , { annotate_option | global_option | resource_type | @any }
  | "expose" : "Expose a replicated application as a service or route" , { expose_option | global_option | resource_type | @any }
  | "delete" : "Delete resources by file, stdin, name or label selector" , { delete_option | global_option | resource_type | @any }
  | "scale" : "Set a new size for a deployment, replica set, or replication controller" , { scale_option | global_option | resource_type | @any }
  | "autoscale" : "Autoscale a deployment config, deployment, replica or stateful set" , { autoscale_option | global_option | resource_type | @any }
  | "secrets" : "Manage secrets" , { global_option } , [ secrets_command ]
  | "logs" : "Print the logs for a container in a pod" , { logs_option | global_option | @any }
  | "rsh" : "Start a shell session in a container" , { rsh_option | global_option | @any } , [ "--" : "End of options, the command follows" , { @any } ]
  | "rsync" : "Copy files between a local file system and a pod" , { rsync_option | global_option | @file }
  | "port-forward" : "Forward one or more local ports to a pod" , { port_forward_option | global_option | @any }
  | "debug" : "Launch a new instance of a pod for debugging" , { debug_option | global_option | resource_type | @any } , [ "--" : "End of options, the command follows" , { @any } ]
  | "exec" : "Execute a command in a container" , { exec_option | global_option | @any } , [ "--" : "End of options, the command follows" , { @any } ]
  | "proxy" : "Run a proxy to the Kubernetes API server" , { proxy_option | global_option | @any }
  | "attach" : "Attach to a running container" , { attach_option | global_option | @any }
  | "run" : "Run a particular image on the cluster" , { run_option | global_option | @any } , [ "--" : "End of options, the command follows" , { @any } ]
  | "cp" : "Copy files and directories to and from containers" , { cp_option | global_option | @file }
  | "wait" : "Experimental: Wait for a specific condition on one or many resources" , { wait_option | global_option | resource_type | @any }
  | "events" : "List events" , { events_option | global_option | @any }
  | "adm" : "Tools for managing a cluster" , { global_option } , [ adm_command ]
  | "replace" : "Replace a resource by file name or stdin" , { replace_option | global_option | @any }
  | "patch" : "Update fields of a resource" , { patch_option | global_option | resource_type | @any }
  | "process" : "Process a template into list of resources" , { process_option | global_option | @file }
  | "extract" : "Extract secrets or config maps to disk" , { extract_option | global_option | @any }
  | "observe" : "Observe changes to resources and react to them (experimental)" , { observe_option | global_option | @any }
  | "policy" : "Manage authorization policy" , { global_option } , [ policy_command ]
  | "auth" : "Inspect authorization" , { global_option } , [ auth_command ]
  | "image" : "Useful commands for managing images" , { global_option } , [ image_command ]
  | "registry" : "Commands for working with the registry" , { global_option } , [ registry_command ]
  | "idle" : "Idle scalable resources" , { idle_option | global_option | resource_type | @any }
  | "api-versions" : "Print the supported API versions on the server as group/version" , { global_option }
  | "api-resources" : "Print the supported API resources on the server" , { api_resources_option | global_option }
  | "cluster-info" : "Display cluster information" , { global_option } , [ cluster_info_command ]
  | "diff" : "Diff the live version against a would-be applied version" , { diff_option | global_option | @any }
  | "kustomize" : "Build a kustomization target from a directory or URL" , { kustomize_option | global_option | @file }
  | "get-token" : "Experimental: get a token from an external OIDC issuer" , { get_token_option | global_option | @any }
  | "logout" : "End the current server session" , { global_option }
  | "config" : "Modify kubeconfig files" , { global_option } , [ config_command ]
  | "whoami" : "Return information about the current session" , { whoami_option | global_option }
  | "completion" : "Output shell completion code for the specified shell" , [ "bash" | "zsh" | "fish" | "powershell" ]
  | "plugin" : "Provides utilities for interacting with plugins" , { global_option } , [ plugin_command ]
  | "version" : "Print the client and server version information" , { version_option | global_option } ;

opt_certificate_authority =
    "--certificate-authority" : "Path to a cert file for the certificate authority" , @file | "--certificate-authority=" : "Path to a cert file for the certificate authority" ~ @file ;

opt_insecure_skip_tls_verify = "--insecure-skip-tls-verify" : "The server's certificate will not be checked for validity" ;

opt_token =
    "--token" : "Bearer token for authentication to the API server" , @any | "--token=" : "Bearer token for authentication to the API server" ~ @any ;

opt_allow_missing_images = "--allow-missing-images" : "Use referenced images even when they cannot be found" ;

opt_allow_missing_imagestream_tags =
    "--allow-missing-imagestream-tags" : "Indicates that image stream tags that don't exist should still be used" ;

opt_allow_missing_template_keys = "--allow-missing-template-keys" : "Ignore template errors for missing fields or map keys" ;

opt_binary = "--binary" : "Expect binary contents instead of a source URL" ;

opt_context_dir =
    "--context-dir" : "Context directory to be used for the build" , @any | "--context-dir=" : "Context directory to be used for the build" ~ @any ;

opt_dry_run =
    "--dry-run" : "Show the result of the operation without performing it" | "--dry-run=" : "Show the result of the operation without performing it" ~ ( "none" | "server" | "client" ) ;

opt_env =
    "-e" : "Environment variable to set in each container, as key=value" , @any | "--env" : "Environment variable to set in each container, as key=value" , @any | "--env=" : "Environment variable to set in each container, as key=value" ~ @any ;

opt_env_file =
    "--env-file" : "File of environment variables to set in each container" , @any | "--env-file=" : "File of environment variables to set in each container" ~ @any ;

opt_ignore_unknown_parameters =
    "--ignore-unknown-parameters" : "Keep going when a parameter does not exist in the template" ;

opt_import_mode =
