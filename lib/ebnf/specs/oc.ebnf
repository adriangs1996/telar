idle_option =
    "--all" : "Select all services in the namespace"
  | "-A" : "Select services across all namespaces" | "--all-namespaces" : "Select services across all namespaces"
  | "--dry-run" : "Only print the annotations that would be written" | "--dry-run=" : "Only print the annotations that would be written" ~ ( "none" | "server" | "client" )
  | "--resource-names-file" : "File containing list of services whose scalable resources to idle" , @any | "--resource-names-file=" : "File containing list of services whose scalable resources to idle" ~ @any
  | "-l" : "Selector (label query) to use to select services" , @any | "--selector" : "Selector (label query) to use to select services" , @any | "--selector=" : "Selector (label query) to use to select services" ~ @any ;

api_resources_option =
    "--api-group" : "Limit to resources in the specified API group" , @any | "--api-group=" : "Limit to resources in the specified API group" ~ @any
  | "--cached" : "Use the cached list of resources if available"
  | "--categories" : "Limit to resources that belong to the specified categories" , @any | "--categories=" : "Limit to resources that belong to the specified categories" ~ @any
  | "--namespaced" : "List namespaced resources, or cluster-wide ones when false"
  | opt_no_headers
  | opt_output
  | "--sort-by" : "If non-empty, sort list of resources using specified field" , @any | "--sort-by=" : "If non-empty, sort list of resources using specified field" ~ @any
  | "--verbs" : "Limit to resources that support the specified verbs" , @any | "--verbs=" : "Limit to resources that support the specified verbs" ~ @any ;

