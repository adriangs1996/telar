  | "join-projects" : "Join project network" , { global_option | @any }
  | "make-projects-global" : "Make project network global" , { global_option | @any } ;

adm_policy_command =
    "add-cluster-role-to-group" : "Add a role to groups for all projects in the cluster" , { global_option | @any }
  | "add-cluster-role-to-user" : "Add a role to users for all projects in the cluster" , { global_option | @any }
  | "add-role-to-group" : "Add a role to groups for the project" , { global_option | @any }
  | "add-role-to-user" : "Add a role to users or service accounts for the current project" , { global_option | @any }
  | "add-scc-to-group" : "Add a security context constraint to groups" , { global_option | @any }
  | "add-scc-to-user" : "Add a security context constraint to users or a service account" , { global_option | @any }
  | "remove-cluster-role-from-group" : "Remove a role from groups for all projects in the cluster" , { global_option | @any }
  | "remove-cluster-role-from-user" : "Remove a role from users for all projects in the cluster" , { global_option | @any }
  | "remove-group" : "Remove group from the project" , { global_option | @any }
  | "remove-role-from-group" : "Remove a role from groups for the project" , { global_option | @any }
  | "remove-role-from-user" : "Remove a role from users for the project" , { global_option | @any }
  | "remove-scc-from-group" : "Remove a group from a security context constraint" , { global_option | @any }
  | "remove-scc-from-user" : "Remove a user from a security context constraint" , { global_option | @any }
  | "remove-user" : "Remove user from the project" , { global_option | @any }
