  | opt_selector
  | opt_server_side
  | "--show-managed-fields" : "Include managed fields in the diff" ;

kustomize_option =
    "--as-current-user" : "Run the function with the uid and gid of the command executor"
  | "--enable-alpha-plugins" : "Enable kustomize plugins"
  | "--enable-helm" : "Enable use of the Helm chart inflator generator"
  | "-e" : "A list of environment variables to be used by functions" , @any | "--env" : "A list of environment variables to be used by functions" , @any | "--env=" : "A list of environment variables to be used by functions" ~ @any
  | "--helm-command" : "Helm command (path to executable)" , @any | "--helm-command=" : "Helm command (path to executable)" ~ @any
  | "--load-restrictor" : "LoadRestrictionsNone lets kustomizations load files outside their root" , @any | "--load-restrictor=" : "LoadRestrictionsNone lets kustomizations load files outside their root" ~ @any
  | "--mount" : "A list of storage options read from the filesystem" , @any | "--mount=" : "A list of storage options read from the filesystem" ~ @any
  | "--network" : "Enable network access for functions that declare it"
  | "--network-name" : "The docker network to run the container in" , @any | "--network-name=" : "The docker network to run the container in" ~ @any
  | "-o" : "If specified, write output to this path" , output_format | "--output" : "If specified, write output to this path" , output_format | "--output=" : "If specified, write output to this path" ~ output_name ;

