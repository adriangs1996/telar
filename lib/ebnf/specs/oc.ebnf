diff_option =
    "--concurrency" : "Number of objects to diff in parallel" , @any | "--concurrency=" : "Number of objects to diff in parallel" ~ @any
  | opt_field_manager
  | "-f" : "Filename, directory, or URL to files contains the configuration to diff" , @file | "--filename" : "Filename, directory, or URL to files contains the configuration to diff" , @file | "--filename=" : "Filename, directory, or URL to files contains the configuration to diff" ~ @file
  | opt_force_conflicts
  | opt_kustomize
  | "--prune" : "Include resources that would be deleted by pruning"
  | "--prune-allowlist" : "Overwrite the default whitelist with <group/version/kind> for --prune" , @any | "--prune-allowlist=" : "Overwrite the default whitelist with <group/version/kind> for --prune" ~ @any
