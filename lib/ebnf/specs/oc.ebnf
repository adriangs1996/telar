opt_insecure_registry =
    "--insecure-registry" : "Referenced images are on insecure registries, skip certificate checks" ;

opt_output =
    "-o" : "Output format" , output_format | "--output" : "Output format" , output_format | "--output=" : "Output format" ~ output_name ;

opt_output_version =
    "--output-version" : "The preferred API versions of the output objects" , @any | "--output-version=" : "The preferred API versions of the output objects" ~ @any ;

opt_param =
    "-p" : "Template parameter to set or override, as KEY=VALUE" , @any | "--param" : "Template parameter to set or override, as KEY=VALUE" , @any | "--param=" : "Template parameter to set or override, as KEY=VALUE" ~ @any ;

opt_show_all =
    "-a" : "When printing, show all resources" | "--show-all" : "When printing, show all resources" ;

opt_show_labels = "--show-labels" : "When printing, show all labels as the last column" ;

opt_show_managed_fields =
    "--show-managed-fields" : "Keep the managedFields when printing objects in JSON or YAML format" ;

opt_sort_by =
    "--sort-by" : "If non-empty, sort list types using this field specification" , @any | "--sort-by=" : "If non-empty, sort list types using this field specification" ~ @any ;

opt_source_secret =
    "--source-secret" : "Secret for cloning a private git repository" , @any | "--source-secret=" : "Secret for cloning a private git repository" ~ @any ;

opt_strategy =
    "--strategy" : "Specify the build strategy to use if you don't want to detect" , @any | "--strategy=" : "Specify the build strategy to use if you don't want to detect" ~ @any ;

opt_filename =
    "-f" : "File, directory or URL identifying the resource" , @file | "--filename" : "File, directory or URL identifying the resource" , @file | "--filename=" : "File, directory or URL identifying the resource" ~ @file ;

opt_kustomize =
    "-k" : "Process the kustomization directory" , @directory | "--kustomize" : "Process the kustomization directory" , @directory | "--kustomize=" : "Process the kustomization directory" ~ @directory ;

opt_recursive =
    "-R" : "Process the directory used in -f, --filename recursively" | "--recursive" : "Process the directory used in -f, --filename recursively" ;

opt_template =
    "--template" : "Template string or file for -o go-template or go-template-file" , @any | "--template=" : "Template string or file for -o go-template or go-template-file" ~ @any ;

opt_selector =
    "-l" : "Selector (label query) to filter on, supports '=', '==', and '!='" , @any | "--selector" : "Selector (label query) to filter on, supports '=', '==', and '!='" , @any | "--selector=" : "Selector (label query) to filter on, supports '=', '==', and '!='" ~ @any ;

opt_dry_run2 =
    "--dry-run" : "Dry run strategy: 'none', 'server' or 'client'" | "--dry-run=" : "Dry run strategy: 'none', 'server' or 'client'" ~ ( "none" | "server" | "client" ) ;

opt_field_manager =
    "--field-manager" : "Name of the manager used to track field ownership" , @any | "--field-manager=" : "Name of the manager used to track field ownership" ~ @any ;

opt_build_arg =
    "--build-arg" : "Specify a key-value pair to pass to Docker during the build" , @any | "--build-arg=" : "Specify a key-value pair to pass to Docker during the build" ~ @any ;

opt_reference_policy =
    "--reference-policy" : "Allow to request pullthrough for external image when set to 'local'" , @any | "--reference-policy=" : "Allow to request pullthrough for external image when set to 'local'" ~ @any ;

opt_from_file =
    "--from-file" : "File to add, keyed by its basename or as key=path" , @any | "--from-file=" : "File to add, keyed by its basename or as key=path" ~ @any ;

opt_save_config = "--save-config" : "The configuration of current object will be saved in its annotation" ;

opt_validate =
    "--validate" : "Must be one of: strict (or true), warn, ignore (or false)" | "--validate=" : "Must be one of: strict (or true), warn, ignore (or false)" ~ ( "strict" | "warn" | "ignore" | "true" | "false" ) ;

opt_image = "--image" : "Image name to run" , @any | "--image=" : "Image name to run" ~ @any ;

opt_port =
    "--port" : "The port that this container exposes" , @any | "--port=" : "The port that this container exposes" ~ @any ;

opt_append_hash = "--append-hash" : "Append a hash of the secret to its name" ;

opt_all = "--all" : "Select all resources in the namespace of the specified resource types" ;

opt_cascade =
    "--cascade" : "Must be 'background', 'orphan', or 'foreground'" | "--cascade=" : "Must be 'background', 'orphan', or 'foreground'" ~ ( "background" | "orphan" | "foreground" ) ;

opt_force = "--force" : "Immediately remove resources from API and bypass graceful deletion" ;

opt_force_conflicts = "--force-conflicts" : "Server-side apply will force the changes against conflicts" ;

opt_grace_period =
    "--grace-period" : "Period of time in seconds given to the resource to terminate gracefully" , @any | "--grace-period=" : "Period of time in seconds given to the resource to terminate gracefully" ~ @any ;

opt_kustomize2 =
    "-k" : "Process a kustomization directory" , @directory | "--kustomize" : "Process a kustomization directory" , @directory | "--kustomize=" : "Process a kustomization directory" ~ @directory ;

opt_server_side = "--server-side" : "Apply runs in the server instead of the client" ;

opt_timeout =
    "--timeout" : "Time to wait before giving up on a delete, 0 to size it by object" , @any | "--timeout=" : "Time to wait before giving up on a delete, 0 to size it by object" ~ @any ;

opt_wait = "--wait" : "Wait for resources to be gone before returning" ;

opt_all_namespaces =
    "-A" : "List the requested object(s) across all namespaces" | "--all-namespaces" : "List the requested object(s) across all namespaces" ;

opt_chunk_size =
    "--chunk-size" : "Return large lists in chunks rather than all at once" , @any | "--chunk-size=" : "Return large lists in chunks rather than all at once" ~ @any ;

opt_field_selector =
    "--field-selector" : "Selector (field query) to filter on, supports '=', '==', and '!='" , @any | "--field-selector=" : "Selector (field query) to filter on, supports '=', '==', and '!='" ~ @any ;

opt_no_headers = "--no-headers" : "Don't print headers in the default or custom-columns output" ;

opt_filename2 =
    "-f" : "Filename, directory, or URL to files to use to edit the resource" , @file | "--filename" : "Filename, directory, or URL to files to use to edit the resource" , @file | "--filename=" : "Filename, directory, or URL to files to use to edit the resource" ~ @file ;

opt_subresource =
    "--subresource" : "Operate on this subresource of the object" , @any | "--subresource=" : "Operate on this subresource of the object" ~ @any ;

opt_local = "--local" : "Set image will NOT contact api-server but run locally" ;

opt_resource_version =
    "--resource-version" : "Update only if this is the object's current resource version" , @any | "--resource-version=" : "Update only if this is the object's current resource version" ~ @any ;

opt_all2 = "--all" : "Select all resources, in the namespace of the specified resource types" ;

opt_all_namespaces2 =
    "-A" : "Check the specified action in all namespaces" | "--all-namespaces" : "Check the specified action in all namespaces" ;

opt_local2 = "--local" : "Annotation will NOT contact api-server but run locally" ;

opt_name =
    "--name" : "The name for the newly created object" , @any | "--name=" : "The name for the newly created object" ~ @any ;

