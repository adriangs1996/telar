  | "reboot-machine-config-pool" : "Initiate reboot of the specified MachineConfigPool" , { global_option | @any }
  | "release" : "Tools for managing the OpenShift release process" , { global_option } , [ adm_release_command ]
  | "restart-kubelet" : "Restarts kubelet on the specified nodes" , { global_option | @any }
  | "taint" : "Update the taints on one or more nodes" , { global_option | @any }
  | "top" : "Show usage statistics of resources on the server" , { global_option } , [ adm_top_command ]
  | "uncordon" : "Mark node as schedulable" , { global_option | @any }
  | "upgrade" : "Upgrade a cluster or adjust the upgrade channel" , { global_option } , [ adm_upgrade_command ]
