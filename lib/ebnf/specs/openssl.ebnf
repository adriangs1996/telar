  | "-fingerprint" : "Print the certificate fingerprint"
  | "-alias" : "Print certificate alias"
  | "-serial" : "Print serial number value"
  | "-startdate" : "Print the notBefore field"
  | "-enddate" : "Print the notAfter field"
  | "-dates" : "Print both notBefore and notAfter fields"
  | "-subject" : "Print subject DN"
  | "-issuer" : "Print issuer DN"
  | "-nameopt" : "Certificate subject/issuer name printing options" , @any
  | "-email" : "Print email address(es)"
  | "-hash" : "Synonym for -subject_hash (for backward compat)"
  | "-subject_hash" : "Print subject hash value"
  | "-subject_hash_old" : "Print old-style (MD5) subject hash value"
  | "-issuer_hash" : "Print issuer hash value"
  | "-issuer_hash_old" : "Print old-style (MD5) issuer hash value"
  | "-ext" : "Restrict which X.509 extensions to print and/or copy" , @any
  | "-ocspid" : "Print OCSP hash values for the subject name and public key"
  | "-ocsp_uri" : "Print OCSP Responder URL(s)"
  | "-purpose" : "Print out certificate purposes"
  | "-pubkey" : "Print the public key in PEM format"
  | "-modulus" : "Print the RSA key modulus"
  | "-multi" : "Process multiple certificates"
  | "-checkend" : "Check whether cert expires in the next arg seconds" , @any
  | "-checkhost" : "Check certificate matches host" , @any
  | "-checkemail" : "Check certificate matches email" , @any
  | "-checkip" : "Check certificate matches ipaddr" , @any
  | "-set_serial" : "Serial number to use, overrides -CAserial" , @any
  | "-next_serial" : "Increment current certificate serial number"
  | "-not_before" : "[CC]YYMMDDHHMMSSZ value for notBefore certificate field" , @any
  | "-not_after" : "[CC]YYMMDDHHMMSSZ value for notAfter certificate field" , @any
  | "-days" : "Number of days until newly generated certificate expires - default 30" , @number
  | "-preserve_dates" : "Preserve existing validity dates"
  | "-set_issuer" : "Set or override certificate issuer" , @any
  | "-set_subject" : "Set or override certificate subject (and issuer)" , @any
  | "-subj" : "Alias for -set_subject" , @any
  | "-force_pubkey" : "Key to be placed in new certificate or certificate request" , @file
  | "-clrext" : "Do not take over any extensions from the source certificate"
  | "-extfile" : "Config file with X509V3 extensions to add" , @file
  | "-extensions" : "Section of extfile to use - default: unnamed section" , @any
  | "-sigopt" : "Signature parameter, in n:v form" , @any
  | "-badsig" : "Corrupt last byte of certificate signature (for test)"
  | "-" : "Use this digest algorithm" ~ digest
  | "-CA" : "Use the given CA certificate, conflicts with -key" , @file
  | "-CAform" : "CA cert format (PEM/DER/P12); has no effect" , pem_der
  | "-CAkey" : "The corresponding CA key; default is -CA arg" , @file
  | "-CAkeyform" : "CA key format (DER/PEM)" , format
  | "-CAserial" : "File that keeps track of CA-generated serial number" , @any
  | "-CAcreateserial" : "Create CA serial number file if it does not exist"
  | "-trustout" : "Mark certificate PEM output as trusted"
  | "-setalias" : "Set certificate alias (nickname)" , @any
  | "-clrtrust" : "Clear all trusted purposes"
  | "-addtrust" : "Trust certificate for a given purpose" , @any
  | "-clrreject" : "Clears all the prohibited or rejected uses of the certificate"
  | "-addreject" : "Reject certificate for a given purpose" , @any
  | "-rand" : "Load the given file(s) into the random number generator" , @any
  | "-writerand" : "Write random data to the specified file" , @file
  | "-provider-path" : "Provider load path (must be before 'provider' argument if required)" , @any
  | "-provider" : "Provider to load (can be specified multiple times)" , @any
  | "-provparam" : "Set a provider key-value parameter" , @any
  | "-propquery" : "Property query used when fetching algorithms" , @any
  | "-engine" : "Use engine, possibly a hardware device" , @any ;

(* Commands of `openssl list -digest-commands` and `-cipher-commands`. *)
digest_command = "blake2b512" | "blake2s256" | "md5" | "rmd160" | "sha1" | "sha224" | "sha256" | "sha3-224" | "sha3-256" | "sha3-384" | "sha3-512" | "sha384" | "sha512" | "sha512-224" | "sha512-256" | "shake128" | "shake256" | "sm3" ;
cipher_command =
    "base64" | "aes-128-cbc" | "aes-128-ecb" | "aes-192-cbc" | "aes-192-ecb" | "aes-256-cbc" | "aes-256-ecb" | 
    "aria-128-cbc" | "aria-128-cfb" | "aria-128-cfb1" | "aria-128-cfb8" | "aria-128-ctr" | 
    "aria-128-ecb" | "aria-128-ofb" | "aria-192-cbc" | "aria-192-cfb" | "aria-192-cfb1" | 
    "aria-192-cfb8" | "aria-192-ctr" | "aria-192-ecb" | "aria-192-ofb" | "aria-256-cbc" | 
    "aria-256-cfb" | "aria-256-cfb1" | "aria-256-cfb8" | "aria-256-ctr" | "aria-256-ecb" | 
    "aria-256-ofb" | "camellia-128-cbc" | "camellia-128-ecb" | "camellia-192-cbc" | "camellia-192-ecb" 
    | "camellia-256-cbc" | "camellia-256-ecb" | "des-ede" | "des-ede-cbc" | "des-ede-cfb" | 
    "des-ede-ofb" | "des-ede3" | "des-ede3-cbc" | "des-ede3-cfb" | "des-ede3-ofb" | "des3" | "sm4-cbc" 
    | "sm4-cfb" | "sm4-ctr" | "sm4-ecb" | "sm4-ofb" ;

(* The names `openssl dgst -list` and `openssl enc -list` print, on both versions,
   for the -<digest> and -<cipher> options; the ciphers leave out the ones only the
   legacy provider supplies (RC2, RC4, SEED, IDEA, CAST, Blowfish, single DES). *)
digest =
    "blake2b512" | "blake2s256" | "md4" | "md5" | "md5-sha1" | "mdc2" | "ripemd" | "ripemd160" | 
    "rmd160" | "sha1" | "sha224" | "sha256" | "sha3-224" | "sha3-256" | "sha3-384" | "sha3-512" | 
    "sha384" | "sha512" | "sha512-224" | "sha512-256" | "shake128" | "shake256" | "sm3" | "ssl3-md5" | 
    "ssl3-sha1" | "whirlpool" ;
cipher =
    "aes-128-cbc" | "aes-128-cfb" | "aes-128-cfb1" | "aes-128-cfb8" | "aes-128-ctr" | "aes-128-ecb" |
    "aes-128-ofb" | "aes-192-cbc" | "aes-192-cfb" | "aes-192-cfb1" | "aes-192-cfb8" | "aes-192-ctr" |
    "aes-192-ecb" | "aes-192-ofb" | "aes-256-cbc" | "aes-256-cfb" | "aes-256-cfb1" | "aes-256-cfb8" |
    "aes-256-ctr" | "aes-256-ecb" | "aes-256-ofb" | "aes128" | "aes128-wrap" | "aes128-wrap-pad" |
    "aes192" | "aes192-wrap" | "aes192-wrap-pad" | "aes256" | "aes256-wrap" | "aes256-wrap-pad" |
    "aria-128-cbc" | "aria-128-cfb" | "aria-128-cfb1" | "aria-128-cfb8" | "aria-128-ctr" |
    "aria-128-ecb" | "aria-128-ofb" | "aria-192-cbc" | "aria-192-cfb" | "aria-192-cfb1" |
    "aria-192-cfb8" | "aria-192-ctr" | "aria-192-ecb" | "aria-192-ofb" | "aria-256-cbc" | "aria-256-cfb"
    | "aria-256-cfb1" | "aria-256-cfb8" | "aria-256-ctr" | "aria-256-ecb" | "aria-256-ofb" | "aria128" |
    "aria192" | "aria256" | "camellia-128-cbc" | "camellia-128-cfb" | "camellia-128-cfb1" |
    "camellia-128-cfb8" | "camellia-128-ctr" | "camellia-128-ecb" | "camellia-128-ofb" |
    "camellia-192-cbc" | "camellia-192-cfb" | "camellia-192-cfb1" | "camellia-192-cfb8" |
    "camellia-192-ctr" | "camellia-192-ecb" | "camellia-192-ofb" | "camellia-256-cbc" |
    "camellia-256-cfb" | "camellia-256-cfb1" | "camellia-256-cfb8" | "camellia-256-ctr" |
    "camellia-256-ecb" | "camellia-256-ofb" | "camellia128" | "camellia192" | "camellia256" | "chacha20"
    | "des-ede" | "des-ede-cbc" | "des-ede-cfb" | "des-ede-ecb" | "des-ede-ofb" | "des-ede3" |
    "des-ede3-cbc" | "des-ede3-cfb" | "des-ede3-cfb1" | "des-ede3-cfb8" | "des-ede3-ecb" |
    "des-ede3-ofb" | "des3" | "des3-wrap" | "id-aes128-wrap" | "id-aes128-wrap-pad" | "id-aes192-wrap" |
    "id-aes192-wrap-pad" | "id-aes256-wrap" | "id-aes256-wrap-pad" | "id-smime-alg-CMS3DESwrap" | "sm4"
    | "sm4-cbc" | "sm4-cfb" | "sm4-ctr" | "sm4-ecb" | "sm4-ofb" ;

(* Format names are case-insensitive: -outform pem works. *)
pem_der = "PEM" | "DER" | "pem" | "der" ;
key_format = pem_der | "ENGINE" | "engine" ;
format = key_format | "P12" | "p12" | "MSBLOB" | "PVK" | "SMIME" | "B64" ;

command_name = "asn1parse" | "ca" | "ciphers" | "cmp" | "cms" | "configutl" | "crl" | "crl2pkcs7" | "dgst" | 
    "dhparam" | "dsa" | "dsaparam" | "ec" | "ech" | "ecparam" | "enc" | "errstr" | "fipsinstall" | 
    "gendsa" | "genpkey" | "genrsa" | "help" | "info" | "kdf" | "list" | "mac" | "nseq" | "ocsp" | 
    "passwd" | "pkcs12" | "pkcs7" | "pkcs8" | "pkey" | "pkeyparam" | "pkeyutl" | "prime" | "rand" | 
    "rehash" | "req" | "rsa" | "rsautl" | "s_client" | "s_server" | "s_time" | "sess_id" | "skeyutl" | 
