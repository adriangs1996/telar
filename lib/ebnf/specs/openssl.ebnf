(* openssl: every command of `openssl list -commands`, checked against `openssl <command>
   -help` of OpenSSL 4.1.0 (macOS) and OpenSSL 3.6.5 (Arch Linux); an option either
   version lists is accepted. `ech` exists only in 4.x and `engine` only in 3.x.
   Commands modelled with their options: req, x509, genrsa, genpkey, rsa, pkey,
   pkeyutl, ec, ecparam, dhparam, pkcs8, pkcs12, pkcs7, crl, crl2pkcs7, ca, verify,
   s_client, s_server, dgst, enc, rand, passwd, prime, cms, smime, ocsp, ciphers,
   list, asn1parse, rehash, storeutl, version and help; the others take any words.
   Digest commands (`openssl sha256 file`) take the options of dgst and cipher
   commands (`openssl aes-256-cbc`) those of enc. Values always follow an option as
   the next word. Descriptions are the first line of each option's help. *)

openssl = [ command ] ;

command =
    "asn1parse" : "Parse an ASN.1 sequence" , { asn1parse_option }
  | "ca" : "Sign certificate requests as a minimal CA" , { ca_option | @file }
  | "ciphers" : "List and decode cipher suites" , { ciphers_option }
  | "cmp" : "Certificate Management Protocol client" , { @any }
  | "cms" : "Sign, verify, encrypt and decrypt CMS messages" , { cms_option }
  | "configutl" : "Process configuration files" , { @any }
  | "crl" : "Process certificate revocation lists" , { crl_option }
  | "crl2pkcs7" : "Convert CRLs and certificates to PKCS#7" , { crl2pkcs7_option }
  | "dgst" : "Compute message digests and signatures" , { dgst_option | @file }
  | "dhparam" : "Generate and process DH parameters" , { dhparam_option | @number }
  | "dsa" : "Process DSA keys" , { @any }
  | "dsaparam" : "Generate and process DSA parameters" , { @any }
  | "ec" : "Process EC keys" , { ec_option }
  | "ech" : "Manage Encrypted Client Hello keys (OpenSSL 4)" , { @any }
  | "ecparam" : "Generate and process EC parameters" , { ecparam_option }
  | "enc" : "Encrypt and decrypt with symmetric ciphers" , { enc_option }
  | "engine" : "Load and query engines (OpenSSL 3)" , { @any }
  | "errstr" : "Decode error codes" , { @any }
  | "fipsinstall" : "Install and verify the FIPS provider configuration" , { @any }
  | "gendsa" : "Generate a DSA private key" , { @any }
  | "genpkey" : "Generate a private key or parameters" , { genpkey_option }
  | "genrsa" : "Generate an RSA private key" , { genrsa_option | @number }
  | "help" : "Show the commands or the help of one" , { help_option | command_name }
  | "info" : "Print built-in configuration information" , { @any }
  | "kdf" : "Run a key derivation function" , { @any }
  | "list" : "List algorithms, commands and providers" , { list_option }
  | "mac" : "Compute message authentication codes" , { @any }
  | "nseq" : "Create or examine a Netscape certificate sequence" , { @any }
  | "ocsp" : "Online Certificate Status Protocol client and responder" , { ocsp_option }
  | "passwd" : "Compute password hashes" , { passwd_option }
  | "pkcs12" : "Create and parse PKCS#12 files" , { pkcs12_option }
  | "pkcs7" : "Process PKCS#7 files" , { pkcs7_option }
  | "pkcs8" : "Convert private keys to and from PKCS#8" , { pkcs8_option }
  | "pkey" : "Process public and private keys" , { pkey_option }
  | "pkeyparam" : "Process public key algorithm parameters" , { @any }
  | "pkeyutl" : "Sign, verify, encrypt and derive with keys" , { pkeyutl_option }
  | "prime" : "Check or generate prime numbers" , { prime_option | @number }
  | "rand" : "Generate random bytes" , { rand_option | @number }
  | "rehash" : "Create symbolic links to certificates by hash" , { rehash_option | @directory }
  | "req" : "Create and process certificate requests" , { req_option }
  | "rsa" : "Process RSA keys" , { rsa_option }
  | "rsautl" : "Sign, verify, encrypt and decrypt with RSA (deprecated)" , { @any }
  | "s_client" : "Connect to a TLS server" , { s_client_option | @ssh_host }
  | "s_server" : "Run a TLS server" , { s_server_option }
  | "s_time" : "Time TLS connections" , { @any }
  | "sess_id" : "Process TLS session data" , { @any }
  | "skeyutl" : "Manage opaque symmetric keys" , { @any }
  | "smime" : "Sign, verify, encrypt and decrypt S/MIME messages" , { smime_option | @file }
  | "speed" : "Measure algorithm speed" , { @any }
  | "spkac" : "Process signed public key and challenge files" , { @any }
  | "srp" : "Maintain an SRP password file" , { @any }
  | "storeutl" : "Load objects from a URI" , { storeutl_option | @file }
  | "ts" : "Time Stamping Authority client and server" , { @any }
  | "verify" : "Verify certificate chains" , { verify_option | @file }
  | "version" : "Print OpenSSL version information" , { version_option }
  | "x509" : "Display, convert, sign and edit certificates" , { x509_option }
  | digest_command , { dgst_option | @file }
  | cipher_command , { enc_option } ;

asn1parse_option =
    "-help" : "Display the summary of the options"
  | "-oid" : "File of extra oid definitions" , @file
  | "-inform" : "Input format - one of DER PEM B64" , @any
  | "-in" : "Input file" , @file
  | "-out" : "Output file (output format is always DER)" , @file
  | "-noout" : "Do not produce any output"
  | "-offset" : "Offset into file" , @number
  | "-length" : "Length of section in file" , @number
  | "-strparse" : "Offset; a series of these can be used to 'dig'" , @number
  | "-genstr" : "String to generate ASN1 structure" , @any
  | "-genconf" : "File to generate ASN1 structure" , @any
  | "-strictpem" : "Equivalent to '-inform pem' (obsolete)"
  | "-item" : "Item to parse and print" , @any
  | "-i" : "Indents the output"
  | "-dump" : "Unknown data in hex form"
  | "-dlimit" : "Dump the first arg bytes of unknown data in hex form" , @number ;

ca_option =
    "-help" : "Display the summary of the options"
  | "-verbose" : "Verbose output during processing"
  | "-quiet" : "Terse output during processing"
  | "-outdir" : "Where to put output cert" , @directory
  | "-in" : "The input cert request(s)" , @file
  | "-inform" : "CSR input format to use (PEM or DER; by default try PEM first)" , pem_der
  | "-infiles" : "The last argument, requests to process"
  | "-out" : "Where to put the output file(s)" , @file
  | "-dateopt" : "Datetime format used for printing. (rfc_822/iso_8601)" , @any
  | "-notext" : "Do not print the generated certificate"
  | "-batch" : "Don't ask questions"
  | "-ss_cert" : "File contains a self signed cert to sign" , @file
  | "-spkac" : "File contains DN and signed public key and challenge" , @file
  | "-config" : "A config file" , @any
  | "-name" : "The particular CA definition to use" , @any
  | "-section" : "An alias for -name" , @any
  | "-policy" : "The CA 'policy' to support" , @any
  | "-subj" : "Use arg instead of request's subject" , @any
  | "-utf8" : "Input characters are UTF8; default ASCII"
  | "-create_serial" : "If reading serial fails, create a new random serial"
  | "-rand_serial" : "Always create a random serial; do not store it"
  | "-multivalue-rdn" : "Deprecated; multi-valued RDNs support is always"
  | "-startdate" : "[CC]YYMMDDHHMMSSZ value for notBefore certificate field" , @any
  | "-not_before" : "An alias for -startdate" , @any
  | "-enddate" : "[CC]YYMMDDHHMMSSZ value for notAfter certificate field" , @any
  | "-not_after" : "An alias for -enddate" , @any
  | "-days" : "Number of days from today to certify the cert" , @number
  | "-extensions" : "Extension section (override value in config file)" , @any
  | "-extfile" : "Configuration file with X509v3 extensions to add" , @file
  | "-preserveDN" : "Don't re-order the DN"
  | "-noemailDN" : "Don't add the EMAIL field to the DN"
  | "-md" : "Digest to use, such as sha256" , @any
  | "-keyfile" : "The CA private key" , @any
  | "-keyform" : "Private key file format (DER/PEM)" , format
  | "-passin" : "Key and cert input file pass phrase source" , @any
  | "-key" : "Key to decrypt the private key or cert files if encrypted" , @file
  | "-cert" : "The CA cert" , @file
  | "-certform" : "Certificate input format (DER/PEM/P12); has no effect" , pem_der
  | "-selfsign" : "Sign a cert with the key associated with it"
  | "-sigopt" : "Signature parameter in n:v form" , @any
  | "-vfyopt" : "Verification parameter in n:v form" , @any
  | "-gencrl" : "Generate a new CRL"
  | "-valid" : "Add a Valid(not-revoked) DB entry about a cert (given in file)" , @any
  | "-status" : "Shows cert status given the serial number" , @any
  | "-updatedb" : "Updates db for expired cert"
  | "-crlexts" : "CRL extension section (override value in config file)" , @any
  | "-crl_reason" : "Revocation reason" , @any
  | "-crl_hold" : "The hold instruction, an OID" , @any
  | "-crl_compromise" : "Sets compromise time to val and the revocation reason" , @any
  | "-crl_CA_compromise" : "Sets compromise time to val and the revocation reason to CACompromise" , @any
  | "-crl_lastupdate" : "Sets the CRL lastUpdate time to val" , @any
  | "-crl_nextupdate" : "Sets the CRL nextUpdate time to val" , @any
  | "-crldays" : "Days until the next CRL is due" , @number
  | "-crlhours" : "Hours until the next CRL is due" , @number
  | "-crlsec" : "Seconds until the next CRL is due" , @number
  | "-revoke" : "Revoke a cert (given in file)" , @file
  | "-rand" : "Load the given file(s) into the random number generator" , @any
  | "-writerand" : "Write random data to the specified file" , @file
  | "-provider-path" : "Provider load path (must be before 'provider' argument if required)" , @any
  | "-provider" : "Provider to load (can be specified multiple times)" , @any
  | "-provparam" : "Set a provider key-value parameter" , @any
  | "-propquery" : "Property query used when fetching algorithms" , @any
  | "-msie_hack" : "Msie modifications to handle all Universal Strings"
  | "-engine" : "Use engine, possibly a hardware device" , @any ;

ciphers_option =
    "-help" : "Display the summary of the options"
  | "-v" : "Verbose listing of the SSL/TLS ciphers"
  | "-V" : "Even more verbose"
  | "-stdname" : "Show standard cipher names"
  | "-convert" : "Convert standard name into OpenSSL name" , @any
  | "-s" : "Only supported ciphers"
  | "-tls1" : "Ciphers compatible with TLS1"
  | "-tls1_1" : "Ciphers compatible with TLS1.1"
  | "-tls1_2" : "Ciphers compatible with TLS1.2"
  | "-tls1_3" : "Ciphers compatible with TLS1.3"
  | "-psk" : "Include ciphersuites requiring PSK"
  | "-srp" : "(deprecated) Include ciphersuites requiring SRP"
  | "-ciphersuites" : "Configure the TLSv1.3 ciphersuites to use" , @any
  | "-provider-path" : "Provider load path (must be before 'provider' argument if required)" , @any
  | "-provider" : "Provider to load (can be specified multiple times)" , @any
  | "-provparam" : "Set a provider key-value parameter" , @any
  | "-propquery" : "Property query used when fetching algorithms" , @any ;

cms_option =
    "-help" : "Display the summary of the options"
  | "-in" : "Input file" , @file
  | "-out" : "Output file" , @file
  | "-config" : "Load a configuration file (this may load modules)" , @file
  | "-encrypt" : "Encrypt message"
  | "-decrypt" : "Decrypt encrypted message"
  | "-sign" : "Sign message"
  | "-verify" : "Verify signed message"
  | "-resign" : "Resign a signed message"
  | "-sign_receipt" : "Generate a signed receipt for a message"
  | "-verify_receipt" : "Verify receipts; exit if receipt signatures do not verify" , @file
  | "-digest" : "Sign a pre-computed digest in hex notation" , @any
  | "-digest_create" : "Create a CMS 'DigestedData' object"
  | "-digest_verify" : "Verify a CMS 'DigestedData' object and output it"
  | "-compress" : "Create a CMS 'CompressedData' object"
  | "-uncompress" : "Uncompress a CMS 'CompressedData' object"
  | "-EncryptedData_encrypt" : "Create CMS 'EncryptedData' object using symmetric key"
  | "-EncryptedData_decrypt" : "Decrypt CMS 'EncryptedData' object using symmetric key"
  | "-data_create" : "Create a CMS 'Data' object"
  | "-data_out" : "Copy CMS 'Data' object to output"
  | "-cmsout" : "Output CMS structure"
  | "-inform" : "Input format SMIME (default), PEM or DER" , @any
  | "-outform" : "Output format SMIME (default), PEM or DER" , @any
  | "-rctform" : "Receipt file format" , pem_der
  | "-stream" : "Enable CMS streaming"
  | "-indef" : "Same as -stream"
  | "-noindef" : "Disable CMS streaming"
  | "-binary" : "Treat input as binary: do not translate to canonical form"
  | "-crlfeol" : "Use CRLF as EOL termination instead of LF only"
  | "-asciicrlf" : "Perform CRLF canonicalisation when signing"
  | "-pwri_password" : "Specific password for recipient" , @any
  | "-secretkey" : "Use specified hex-encoded key to decrypt/encrypt recipients" , @any
  | "-secretkeyid" : "Identity of the -secretkey for CMS 'KEKRecipientInfo' object" , @any
  | "-inkey" : "Input private key (if not signer or recipient)" , @file
  | "-passin" : "Input file pass phrase source" , @any
  | "-keyopt" : "Set public key parameters as n:v pairs" , @any
  | "-keyform" : "Input private key format (DER/PEM)" , format
  | "-provider-path" : "Provider load path (must be before 'provider' argument if required)" , @any
  | "-provider" : "Provider to load (can be specified multiple times)" , @any
  | "-provparam" : "Set a provider key-value parameter" , @any
  | "-propquery" : "Property query used when fetching algorithms" , @any
  | "-rand" : "Load the given file(s) into the random number generator" , @any
  | "-writerand" : "Write random data to the specified file" , @file
  | "-originator" : "Originator certificate" , @any
  | "-recip" : "Recipient cert" , @file
  | "-cert..." : "Recipient certs (optional; used only when encrypting)" , @any
  | "-" : "Encrypt with this cipher" ~ cipher
  | "-kekcipher" : "The key encryption algorithm to use" , @any
  | "-wrap" : "Key wrap algorithm to use when encrypting with key agreement" , @any
  | "-aes128-wrap" : "Use AES128 to wrap key"
  | "-aes192-wrap" : "Use AES192 to wrap key"
  | "-aes256-wrap" : "Use AES256 to wrap key"
  | "-des3-wrap" : "Use 3DES-EDE to wrap key"
  | "-debug_decrypt" : "Disable MMA protection, return error if no recipient found (see doc)"
  | "-recip_kdf" : "Set KEMRecipientInfo KDF for current recipient" , @any
  | "-recip_ukm" : "KEMRecipientInfo user keying material for current recipient" , @any
  | "-md" : "Digest algorithm to use" , @any
  | "-signer" : "Signer certificate input" , @file
  | "-certfile" : "Extra signer and intermediate CA certificates to include when signing" , @file
  | "-cades" : "Include signingCertificate attribute (CAdES-BES)"
  | "-nodetach" : "Use opaque signing"
  | "-nocerts" : "Don't include signer's certificate when signing"
  | "-noattr" : "Don't include any signed attributes"
  | "-nosmimecap" : "Omit the SMIMECapabilities attribute"
  | "-no_signing_time" : "Omit the signing time attribute"
  | "-receipt_request_all" : "When signing, create a receipt request for all recipients"
  | "-receipt_request_first" : "When signing, create a receipt request for first recipient"
  | "-receipt_request_from" : "Create signed receipt request with specified email address" , @any
  | "-receipt_request_to" : "Create signed receipt targeted to specified address" , @any
  | "-content" : "Supply or override content for detached signature" , @file
  | "-no_content_verify" : "Do not verify signed content signatures"
  | "-no_attr_verify" : "Do not verify signed attribute signatures"
  | "-nosigs" : "Don't verify message signature"
  | "-noverify" : "Don't verify signers certificate"
  | "-nointern" : "Don't search certificates in message for signer"
  | "-verify_partial" : "Return success if at least one signature can be verified"
  | "-verify_retcode" : "Exit non-zero on verification failure"
  | "-CAfile" : "File in PEM format with trusted CA certs" , @file
  | "-CApath" : "Dir with trusted CA cert files in PEM format" , @directory
  | "-CAstore" : "URI of store with trusted CA certs" , ( @file | @any )
  | "-no-CAfile" : "Do not load the default certificates file"
  | "-no-CApath" : "Do not load certificates from the default certificates directory"
  | "-no-CAstore" : "Do not load certificates from the default certificates store"
  | "-keyid" : "Use subject key identifier"
  | "-econtent_type" : "OID for external content" , @any
  | "-text" : "Include or delete text MIME headers"
  | "-certsout" : "Certificate output file" , @file
  | "-to" : "To address" , @any
  | "-from" : "From address" , @any
  | "-subject" : "Subject" , @any
  | "-noout" : "For the -cmsout operation do not output the parsed CMS structure"
  | "-print" : "For the -cmsout operation print out all fields of the CMS structure"
  | "-nameopt" : "For the -print option specifies various strings printing options" , @any
  | "-receipt_request_print" : "Print CMS Receipt Request"
  | "-policy" : "Adds policy to the acceptable policy set" , @any
  | "-purpose" : "Certificate chain purpose" , @any
  | "-verify_name" : "Verification policy name" , @any
  | "-verify_depth" : "Chain depth limit" , @number
  | "-auth_level" : "Chain authentication security level" , @number
  | "-attime" : "Verification epoch time" , @any
  | "-verify_hostname" : "Expected peer hostname" , @any
  | "-verify_email" : "Expected peer email" , @any
  | "-verify_ip" : "Expected peer IP address" , @any
  | "-ignore_critical" : "Permit unhandled critical extensions"
  | "-issuer_checks" : "(deprecated)"
  | "-crl_check" : "Check leaf certificate revocation"
  | "-crl_check_all" : "Check full chain revocation"
  | "-policy_check" : "Perform rfc5280 policy checks"
  | "-explicit_policy" : "Set policy variable require-explicit-policy"
  | "-inhibit_any" : "Set policy variable inhibit-any-policy"
  | "-inhibit_map" : "Set policy variable inhibit-policy-mapping"
  | "-x509_strict" : "Disable certificate compatibility work-arounds"
  | "-extended_crl" : "Enable extended CRL features"
  | "-use_deltas" : "Use delta CRLs"
  | "-policy_print" : "Print policy processing diagnostics"
  | "-check_ss_sig" : "Check root CA self-signatures"
  | "-trusted_first" : "Search trust store first (default)"
  | "-suiteB_128_only" : "Suite B 128-bit-only mode"
  | "-suiteB_128" : "Suite B 128-bit mode allowing 192-bit algorithms"
  | "-suiteB_192" : "Suite B 192-bit-only mode"
  | "-partial_chain" : "Accept chains anchored by intermediate trust-store CAs"
  | "-no_alt_chains" : "(deprecated)"
  | "-no_check_time" : "Ignore certificate validity time"
  | "-allow_proxy_certs" : "Allow the use of proxy certificates"
  | "-engine" : "Use engine e, possibly a hardware device" , @any ;

crl_option =
    "-help" : "Display the summary of the options"
  | "-verify" : "Verify CRL signature"
  | "-in" : "Input file - default stdin" , @file
  | "-inform" : "CRL input format (DER or PEM); has no effect" , pem_der
  | "-key" : "CRL signing Private key to use" , @file
  | "-keyform" : "Private key file format (DER/PEM/P12); has no effect" , pem_der
  | "-out" : "Output file - default stdout" , @file
  | "-outform" : "Output format - default PEM" , pem_der
  | "-dateopt" : "Datetime format used for printing. (rfc_822/iso_8601)" , @any
  | "-text" : "Print out a text format version"
  | "-hash" : "Print hash value"
  | "-hash_old" : "Print old-style (MD5) hash value"
  | "-nameopt" : "Certificate subject/issuer name printing options" , @any
  | "-" : "Use this digest algorithm" ~ digest
  | "-issuer" : "Print issuer DN"
  | "-lastupdate" : "Set lastUpdate field"
  | "-nextupdate" : "Set nextUpdate field"
  | "-noout" : "No CRL output"
  | "-fingerprint" : "Print the crl fingerprint"
  | "-crlnumber" : "Print CRL number"
  | "-badsig" : "Corrupt last byte of loaded CRL signature (for test)"
  | "-gendelta" : "Other CRL to compare/diff to the Input one" , @file
  | "-CAfile" : "File in PEM format with trusted CA certs" , @file
  | "-CApath" : "Dir with trusted CA cert files in PEM format" , @directory
  | "-CAstore" : "URI of store with trusted CA certs" , ( @file | @any )
  | "-no-CAfile" : "Do not load the default certificates file"
  | "-no-CApath" : "Do not load certificates from the default certificates directory"
  | "-no-CAstore" : "Do not load certificates from the default certificates store"
  | "-provider-path" : "Provider load path (must be before 'provider' argument if required)" , @any
  | "-provider" : "Provider to load (can be specified multiple times)" , @any
  | "-provparam" : "Set a provider key-value parameter" , @any
  | "-propquery" : "Property query used when fetching algorithms" , @any ;

crl2pkcs7_option =
    "-help" : "Display the summary of the options"
  | "-in" : "Input file" , @file
  | "-inform" : "Input format - DER or PEM" , pem_der
  | "-nocrl" : "No crl to load, just certs from '-certfile'"
  | "-certfile" : "File of chain of certs to a trusted CA; can be repeated" , @file
  | "-out" : "Output file" , @file
  | "-outform" : "Output format - DER or PEM" , pem_der
  | "-provider-path" : "Provider load path (must be before 'provider' argument if required)" , @any
  | "-provider" : "Provider to load (can be specified multiple times)" , @any
  | "-provparam" : "Set a provider key-value parameter" , @any
  | "-propquery" : "Property query used when fetching algorithms" , @any ;

dgst_option =
    "-help" : "Display the summary of the options"
  | "-list" : "List digests"
  | "-passin" : "Input file pass phrase source" , @any
  | "-c" : "Print the digest with separating colons"
  | "-r" : "Print the digest in coreutils format"
  | "-out" : "Output to filename rather than stdout" , @file
  | "-keyform" : "Key file format (DER/PEM)" , format
  | "-hex" : "Print as hex dump"
  | "-binary" : "Print in binary form"
  | "-xoflen" : "Output length for XOF algorithms" , @number
  | "-d" : "Print debug info"
  | "-debug" : "Print debug info"
  | "-sign" : "Sign digest using private key" , @any
  | "-verify" : "Verify a signature using public key" , @any
  | "-prverify" : "Verify a signature using private key" , @any
  | "-sigopt" : "Signature parameter in n:v form" , @any
  | "-signature" : "File with signature to verify" , @file
  | "-hmac" : "Create hashed MAC with key" , @any
  | "-hmac-env" : "Create hashed MAC with key from environment variable" , @any
  | "-hmac-stdin" : "Create hashed MAC with key from stdin"
  | "-mac" : "Create MAC (not necessarily HMAC)" , @any
  | "-macopt" : "MAC algorithm parameters in n:v form or key" , @any
  | "-" : "Use this digest algorithm" ~ digest
  | "-fips-fingerprint" : "Compute HMAC with the key used in OpenSSL-FIPS fingerprint"
  | "-rand" : "Load the given file(s) into the random number generator" , @any
  | "-writerand" : "Write random data to the specified file" , @file
  | "-provider-path" : "Provider load path (must be before 'provider' argument if required)" , @any
  | "-provider" : "Provider to load (can be specified multiple times)" , @any
  | "-provparam" : "Set a provider key-value parameter" , @any
  | "-propquery" : "Property query used when fetching algorithms" , @any
  | "-engine" : "Use engine e, possibly a hardware device" , @any
  | "-engine_impl" : "Also use engine given by -engine for digest operations" ;

dhparam_option =
    "-help" : "Display the summary of the options"
  | "-check" : "Check the DH parameters"
  | "-dsaparam" : "Read or generate DSA parameters, convert to DH"
  | "-in" : "Input file" , @file
  | "-inform" : "Input format, DER or PEM" , pem_der
  | "-out" : "Output file" , @file
  | "-outform" : "Output format, DER or PEM" , pem_der
  | "-text" : "Print a text form of the DH parameters"
  | "-noout" : "Don't output any DH parameters"
  | "-2" : "Generate parameters using 2 as the generator value"
  | "-3" : "Generate parameters using 3 as the generator value"
  | "-5" : "Generate parameters using 5 as the generator value"
