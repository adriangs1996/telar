(* gcloud: checked against `gcloud help` and `gcloud <group> <command> --help` of Google
   Cloud SDK 566.0.0 (core 2026.04.24).

   Every top-level group and command is listed. Fully modelled: auth, config, projects,
   compute instances (and compute ssh, scp, config-ssh, start-iap-tunnel), container
   clusters, run, functions, storage, sql, logging, iam and secrets, with the common flags
   of their main commands. Other groups and commands take any words.

   Conventions:
   - gcloud-wide flags are accepted before the group and anywhere after it.
   - Flags with a value accept `--flag value` and `--flag=value`. Only the `--flag=`
     form, the one gcloud documents, carries the description: the lexer reads at most
     10000 tokens, and describing both forms would not fit.
   - Resource names (instances, clusters, services, buckets) have no provider, so they
     are @any, which also accepts option-like words: an unknown flag is only rejected
     by commands that take no positional arguments, such as the list commands. *)

gcloud = { g } , [ command ] ;

(* gcloud-wide flags *)
g =
    "--account" , @any
  | "--account=" : "Google Cloud user account to use" ~ @any
  | "--billing-project" , @any
  | "--billing-project=" : "Project charged quota for this command" ~ @any
  | "--configuration" , @any
  | "--configuration=" : "Named configuration to use" ~ @any
  | "--flags-file" , @file
  | "--flags-file=" : "YAML or JSON file of flags" ~ @file
  | "--flatten" , @any
  | "--flatten=" : "Flatten these resource slices into separate records" ~ @any
  | "--format" , format_name
  | "--format=" : "Output format" ~ format_name
  | "--help" : "Display detailed help"
  | "-h" : "Print a summary help"
  | "--project" , @any
  | "--project=" : "Google Cloud project to use" ~ @any
  | "--quiet" : "Disable all interactive prompts" | "-q" : "Disable all interactive prompts"
  | "--verbosity" , verbosity
  | "--verbosity=" : "Logging verbosity" ~ verbosity
  | "--version" : "Print version information" | "-v" : "Print version information"
  | "--access-token-file" , @file
  | "--access-token-file=" : "File with an access token to use" ~ @file
  | "--impersonate-service-account" , @any
  | "--impersonate-service-account=" : "Impersonate these service accounts" ~ @any
  | "--log-http" : "Log all HTTP requests and responses" | "--no-log-http" : "Do not log HTTP traffic"
  | "--trace-token" , @any
  | "--trace-token=" : "Token for tracing the server requests" ~ @any
  | "--user-output-enabled" : "Print output and prompts" | "--no-user-output-enabled" : "Suppress output and prompts" ;

verbosity = "debug" | "info" | "warning" | "error" | "critical" | "none" ;

format_name =
    "json" : "JSON" | "yaml" : "YAML" | "table" : "Table, with table(KEYS) projections"
  | "value" : "Values only, with value(KEYS) projections" | "csv" : "CSV, with csv(KEYS) projections"
  | "text" : "Flattened key: value pairs" | "list" : "List of resources" | "flattened" : "Flattened key: value pairs"
  | "config" : "Properties file format" | "default" : "The command's default format" | "diff" : "Diff of two resources"
  | "disable" : "Disable output" | "get" : "A single value" | "multi" : "Per-key formats" | "none" : "No output"
  | "object" : "Python object" | @any ;

(* Words of a command not modelled further. *)
rest = { @any } ;

(* A gcloud-wide flag or a positional argument, optionally after a location flag. *)
ga = g | @any ;
zga = zone | ga ;
rga = region | ga ;
lga = location | ga ;

(* Shared flags *)
filter = "--filter" , @any
       | "--filter=" : "Filter expression for the listed resources" ~ @any ;
limit = "--limit" , @number
      | "--limit=" : "Maximum number of resources to list" ~ @number ;
page_size = "--page-size" , @number
          | "--page-size=" : "Resources fetched per page" ~ @number ;
sort_by = "--sort-by" , @any
        | "--sort-by=" : "Comma separated fields to sort by" ~ @any ;
uri = "--uri" : "Print resource URIs instead of the default output" ;
(* The list flags of a command come in three sets. *)
list_flag = filter | limit | page_size | sort_by | uri ;
query_flag = filter | limit | page_size | sort_by ;
short_query = filter | limit | sort_by ;

async = "--async" : "Return without waiting for the operation" | "--no-async" : "Wait for the operation to finish" ;
zone = "--zone" , @any | "--zone=" : "Zone of the resource" ~ @any ;
region = "--region" , @any | "--region=" : "Region of the resource" ~ @any ;
location = "--location" , @any | "--location=" : "Location of the resource" ~ @any ;
description = "--description" , @any | "--description=" : "Description of the resource" ~ @any ;

labels =
    "--labels" , @any | "--labels=" : "KEY=VALUE labels to set" ~ @any ;

update_labels =
    "--update-labels" , @any
  | "--update-labels=" : "KEY=VALUE labels to add or update" ~ @any
  | "--remove-labels" , @any | "--remove-labels=" : "Label keys to remove" ~ @any
  | "--clear-labels" : "Remove all labels" ;
member = "--member" , @any
       | "--member=" : "Principal of the binding, as user:EMAIL" ~ @any ;
role = "--role" , @any | "--role=" : "Role of the binding" ~ @any ;

binding =
    member | role
  | "--condition" , @any
  | "--condition=" : "Condition of the binding, as KEY=VALUE" ~ @any
  | "--condition-from-file" , @file
  | "--condition-from-file=" : "File with the binding condition" ~ @file ;

env_vars =
    "--set-env-vars" , @any
  | "--set-env-vars=" : "Replace all environment variables, KEY=VALUE" ~ @any
  | "--update-env-vars" , @any
  | "--update-env-vars=" : "Add or update environment variables" ~ @any
  | "--remove-env-vars" , @any
  | "--remove-env-vars=" : "Environment variables to remove" ~ @any
  | "--clear-env-vars" : "Remove all environment variables"
  | "--env-vars-file" , @file
  | "--env-vars-file=" : "YAML file of environment variables" ~ @file
  | "--set-secrets" , @any
  | "--set-secrets=" : "Replace all secrets, KEY=SECRET:VERSION" ~ @any
  | "--update-secrets" , @any
  | "--update-secrets=" : "Add or update secrets" ~ @any
  | "--remove-secrets" , @any | "--remove-secrets=" : "Secrets to remove" ~ @any
  | "--clear-secrets" : "Remove all secrets" ;

service_account =
    "--service-account" , @any
  | "--service-account=" : "Service account to run as" ~ @any ;

resources =
    "--memory" , @any | "--memory=" : "Memory limit, such as 512Mi or 2Gi" ~ @any
  | "--cpu" , @any | "--cpu=" : "CPU limit" ~ @any
  | "--vpc-connector" , @any
  | "--vpc-connector=" : "Serverless VPC Access connector" ~ @any ;

scaling =
    "--timeout" , @any | "--timeout=" : "Request timeout" ~ @any
  | "--concurrency" , @any
  | "--concurrency=" : "Maximum concurrent requests per instance" ~ @any
  | "--min-instances" , @any
  | "--min-instances=" : "Minimum number of instances" ~ @any
  | "--max-instances" , @any
  | "--max-instances=" : "Maximum number of instances" ~ @any ;

unauthenticated =
    "--allow-unauthenticated" : "Allow unauthenticated invocations"
  | "--no-allow-unauthenticated" : "Require authenticated invocations" ;

command =
    "auth" : "Manage oauth2 credentials for the Google Cloud CLI" , { g } , [ auth_command ]
  | "config" : "View and edit Google Cloud CLI properties" , { g } , [ config_command ]
  | "projects" : "Create and manage project access policies" , { g } , [ projects_command ]
  | "compute" : "Create and manipulate Compute Engine resources" , { g } , [ compute_command ]
  | "container" : "Deploy and manage clusters of machines for containers" , { g } , [ container_command ]
  | "run" : "Manage your Cloud Run applications" , { g } , [ run_command ]
  | "functions" : "Manage Google Cloud Functions" , { g } , [ functions_command ]
  | "storage" : "Create and manage Cloud Storage buckets and objects" , { g } , [ storage_command ]
  | "sql" : "Create and manage Google Cloud SQL databases" , { g } , [ sql_command ]
  | "logging" : "Manage Cloud Logging" , { g } , [ logging_command ]
  | "iam" : "Manage IAM service accounts and keys" , { g } , [ iam_command ]
  | "secrets" : "Manage secrets on Google Cloud" , { g } , [ secrets_command ]
  | "components" : "List, install, update, or remove CLI components" , { g } , [ components_command ]
  | "init" : "Initialize or reinitialize gcloud" , { init_flag | g }
  | "info" : "Display information about the gcloud environment" , { info_flag | g }
  | "version" : "Print version information for CLI components" , { g }
  | "help" : "Search gcloud help text" , { query_flag | ga } , [ "--" , { @any } ]
  | "cheat-sheet" : "Display gcloud cheat sheet" , { g }
  | ( "feedback" : "Provide feedback to the Google Cloud CLI team"
      | "survey" : "Invoke a customer satisfaction survey"
      | "docker" : "Deprecated: Docker access to Container Registry"
      | "topic" : "Supplementary help topics"
      | "access-approval" : "Manage Access Approval requests and settings"
      | "access-context-manager" : "Manage Access Context Manager resources"
      | "active-directory" : "Manage Managed Microsoft AD resources"
      | "ai" : "Manage entities in Vertex AI"
      | "ai-platform" : "Manage AI Platform jobs and models"
      | "alloydb" : "Create and manage AlloyDB databases"
      | "anthos" : "Anthos command group"
      | "api-gateway" : "Manage Cloud API Gateway resources"
      | "apigee" : "Manage Apigee resources"
      | "apihub" : "Manage Apihub resources"
      | "app" : "Manage your App Engine deployments"
      | "apphub" : "Manage App Hub resources"
      | "artifacts" : "Manage Artifact Registry resources"
      | "asset" : "Manage the Cloud Asset Inventory"
      | "assured" : "Read and manipulate Assured Workloads data controls"
      | "audit-manager" : "Enroll resources, audit workloads, generate reports"
      | "backup-dr" : "Manage Backup and DR resources"
      | "batch" : "Manage Batch resources"
      | "beyondcorp" : "Manage Beyondcorp resources"
      | "biglake" : "Create and manage BigLake resources"
      | "bigtable" : "Manage your Cloud Bigtable storage"
      | "billing" : "Manage billing accounts and associate them with projects"
      | "bms" : "Manage Bare Metal Solution resources"
      | "bq" : "Manage Bq resources"
      | "builds" : "Create and manage builds for Google Cloud Build"
      | "certificate-manager" : "Manage SSL certificates for your projects"
      | "cloud-shell" : "Manage Google Cloud Shell"
      | "cloudlocationfinder" : "Manage Cloudlocationfinder resources"
      | "colab" : "Manage Colab Enterprise resources"
      | "compliance-manager" : "Manage Compliance Manager resources"
      | "composer" : "Create and manage Cloud Composer Environments"
      | "data-catalog" : "Manage Data Catalog resources"
      | "database-migration" : "Manage Database Migration Service resources"
      | "dataflow" : "Manage Google Cloud Dataflow resources"
      | "dataplex" : "Manage Dataplex resources"
      | "dataproc" : "Create and manage Dataproc clusters and jobs"
      | "datastore" : "Manage your Cloud Datastore resources"
      | "datastream" : "Manage Cloud Datastream resources"
      | "deploy" : "Create and manage Cloud Deploy resources"
      | "deployment-manager" : "Manage deployments of cloud resources"
      | "design-center" : "Manage Application Design Center resources"
      | "developer-connect" : "Manage Developer Connect resources"
      | "dns" : "Manage your Cloud DNS managed-zones and record-sets"
      | "domains" : "Manage domains for your Google Cloud projects"
      | "edge-cache" : "Manage Media CDN resources"
      | "edge-cloud" : "Manage edge-cloud resources"
      | "emulators" : "Set up local development emulators"
      | "endpoints" : "Create, enable and manage API services"
      | "essential-contacts" : "Manage Essential Contacts"
      | "eventarc" : "Manage Eventarc resources"
      | "filestore" : "Create and manipulate Filestore resources"
      | "firebase" : "Work with Google Firebase"
      | "firestore" : "Manage your Cloud Firestore resources"
      | "gemini" : "Manage Gemini Code Assist and Gemini Cloud Assist"
      | "healthcare" : "Manage Cloud Healthcare resources"
      | "iap" : "Manage IAP policies"
      | "identity" : "Manage Cloud Identity Groups and Memberships"
      | "ids" : "Manage Cloud IDS"
      | "infra-manager" : "Manage Infra Manager resources"
      | "kms" : "Manage cryptographic keys in the cloud"
      | "looker" : "Manage Looker resources"
      | "lustre" : "Manage Lustre resources"
      | "managed-kafka" : "Administer Managed Service for Apache Kafka"
      | "memcache" : "Manage Cloud Memorystore Memcached resources"
      | "memorystore" : "Manage Memorystore resources"
      | "metastore" : "Manage Dataproc Metastore resources"
      | "migration" : "Cloud Migration commands"
      | "ml" : "Use Google Cloud machine learning capabilities"
      | "model-armor" : "Manage Model Armor LLM security and safety"
      | "monitoring" : "Manage Cloud Monitoring dashboards"
      | "netapp" : "Create and manipulate Cloud NetApp Files resources"
      | "network-connectivity" : "Manage Network Connectivity resources"
      | "network-management" : "Manage Network Management resources"
      | "network-security" : "Manage Network Security resources"
      | "network-services" : "Manage Network Services resources"
      | "notebooks" : "Notebooks command group"
      | "observability" : "Manage Observability resources"
      | "oracle-database" : "Manage Oracle Database resources"
      | "org-policies" : "Create and manage Organization Policies"
      | "organizations" : "Create and manage Organizations"
      | "pam" : "Manage Privileged Access Manager entitlements"
      | "parametermanager" : "Store, access and manage parameters"
      | "policy-intelligence" : "Understand, use, and manage policies"
      | "policy-troubleshoot" : "Troubleshoot Google Cloud Platform policies"
      | "privateca" : "Manage private Certificate Authorities"
      | "publicca" : "Manage Google Trust Services CA accounts"
      | "pubsub" : "Manage Cloud Pub/Sub topics, subscriptions, and snapshots"
      | "recaptcha" : "Manage reCAPTCHA Enterprise Keys"
      | "recommender" : "Manage Cloud recommendations and recommendation rules"
      | "redis" : "Manage Cloud Memorystore Redis resources"
      | "resource-manager" : "Manage Cloud Resources"
      | "scc" : "Manage Cloud SCC resources"
      | "scheduler" : "Manage Cloud Scheduler jobs and schedules"
      | "service-directory" : "Command groups for Service Directory"
      | "service-extensions" : "Manage Service Extensions resources"
      | "services" : "List, enable and disable APIs and services"
      | "source" : "Cloud git repository commands"
      | "source-manager" : "Manage Secure Source Manager resources"
      | "spanner" : "Command groups for Cloud Spanner"
      | "tasks" : "Manage Cloud Tasks queues and tasks"
      | "telco-automation" : "Manage Telco Automation resources"
      | "transcoder" : "Manage Transcoder jobs and job templates"
      | "transfer" : "Manage Transfer Service jobs, operations, and agents"
      | "vector-search" : "Manage Vector Search data objects"
      | "vmware" : "Manage Google Cloud VMware Engine resources"
      | "workbench" : "Workbench command group"
      | "workflows" : "Manage your Cloud Workflows resources"
      | "workload-identity" : "Manage Workload Identity"
      | "workspace-add-ons" : "Manage Google Workspace Add-ons resources"
      | "workstations" : "Manage Cloud Workstations resources" ) , rest ;

init_flag =
    "--no-browser" : "Authorize without a browser on this machine"
  | "--console-only" : "Print the authorization URL instead of a browser"
  | "--no-launch-browser" : "Print the authorization URL instead of a browser"
  | "--skip-diagnostics" : "Do not run diagnostics" ;

info_flag =
    "--anonymize" : "Minimize personal information in the output"
  | "--show-log" : "Print the contents of the last log file"
  | "--run-diagnostics" : "Run diagnostics on the installation"
  | "--check-certs" , @any
  | "--check-certs=" : "Check certificates for this host" ~ @any ;

components_command =
    "install" : "Install one or more components" , { ga }
  | "list" : "List the status of all components" , { components_list_flag | short_query | g }
  | "update" : "Update all installed components" , { components_update_flag | g }
  | "remove" : "Remove one or more installed components" , { ga }
  | "reinstall" : "Reinstall the Google Cloud CLI" , { g }
  | "repositories" : "Manage additional component repositories" , rest ;

components_list_flag =
    "--only-local-state" : "Only show locally installed components"
  | "--show-platform" : "Show the platform of this machine"
  | "--show-versions" : "Show installed and available versions" ;

components_update_flag =
    "--version" , @any | "--version=" : "Update to this version" ~ @any ;

(* auth *)

auth_command =
    "login" : "Authorize gcloud with Google user credentials" , { auth_login_flag | ga }
  | "activate-service-account" : "Authorize with a service account" , { auth_sa_flag | ga }
  | "list" : "List credentialed accounts" , { auth_list_flag | query_flag | g }
  | "revoke" : "Revoke access credentials for an account" , { "--all" : "Revoke all credentialed accounts" | ga }
  | "print-access-token" : "Print an access token for the account" , { lifetime | ga }
  | "print-identity-token" : "Print an identity token for the account" , { identity_token_flag | ga }
  | "configure-docker" : "Register gcloud as a Docker credential helper" , { ga }
  | "application-default" : "Manage your Application Default Credentials" , { g } , [ adc_command ]
  | "enterprise-certificate-config" : "Manage enterprise certificate configurations" , rest ;

auth_login_flag =
    "--activate" : "Make the account active" | "--no-activate" : "Do not make the account active"
  | "--brief" : "Minimal user output"
  | "--no-browser" : "Authorize without a browser on this machine"
  | "--no-launch-browser" : "Print the authorization URL instead of a browser"
  | "--cred-file" , @file
  | "--cred-file=" : "Credential configuration file" ~ @file
  | "--enable-gdrive-access" : "Also request Google Drive access"
  | "--force" : "Re-run the web flow even if credentials exist"
  | "--login-config" , @file
  | "--login-config=" : "Workforce identity login configuration file" ~ @file
  | "--update-adc" : "Also write Application Default Credentials" ;

auth_sa_flag =
    "--key-file" , @file
  | "--key-file=" : "Path to the private key file" ~ @file
  | "--password-file" , @file
  | "--password-file=" : "File with the password of a .p12 key" ~ @file
  | "--prompt-for-password" : "Prompt for the password of a .p12 key" ;

auth_list_flag =
    "--filter-account" , @any
  | "--filter-account=" : "List only this account" ~ @any ;

lifetime = "--lifetime" , @any | "--lifetime=" : "Lifetime of the token" ~ @any ;

identity_token_flag =
    "--audiences" , @any
  | "--audiences=" : "Intended recipient of the token" ~ @any
  | "--include-email" : "Include the account email in the token"
  | "--include-license" : "Include license codes in the token"
  | "--token-format" , ( "standard" | "full" )
  | "--token-format=" : "Token format" ~ ( "standard" | "full" ) ;

adc_command =
    "login" : "Acquire new user credentials for ADC" , { adc_login_flag | ga }
  | "print-access-token" : "Print an access token for your current ADC" , { lifetime | scopes | g }
  | "revoke" : "Revoke previously generated ADC" , { g }
  | "set-quota-project" : "Update the quota project in ADC" , { ga } ;

adc_login_flag =
    "--no-browser" : "Authorize without a browser on this machine"
  | "--no-launch-browser" : "Print the authorization URL instead of a browser"
  | "--client-id-file" , @file
  | "--client-id-file=" : "OAuth client id file" ~ @file
  | "--disable-quota-project" : "Do not write a quota project"
  | "--login-config" , @file
  | "--login-config=" : "Workforce identity login configuration file" ~ @file
  | scopes ;

scopes = "--scopes" , @any | "--scopes=" : "OAuth scopes, comma separated" ~ @any ;

(* config *)

config_command =
    "get" : "Print the value of a property" , { g } , [ property ] , { g }
  | "set" : "Set a property" , { installation | g } , [ property , { installation | g } , [ @any ] ] , { installation | g }
  | "unset" : "Unset a property" , { installation | g } , [ property ] , { installation | g }
  | "list" : "List the properties of the active configuration" , { config_list_flag | short_query | g | property }
  | "configurations" : "Manage the set of named configurations" , { g } , [ configurations_command ] ;

installation = "--installation" : "Set the property for the whole installation" ;
config_list_flag = "--all" : "List all set and unset properties" ;

property =
    "project" : "Project ID to operate on" | "account" : "Account gcloud uses"
  | "core/project" : "Project ID to operate on" | "core/account" : "Account gcloud uses"
  | "core/disable_prompts" : "Disable interactive prompts" | "core/verbosity" : "Default logging verbosity"
  | "core/log_http" : "Log HTTP requests and responses" | "core/format" : "Default output format"
  | "core/disable_usage_reporting" : "Do not send usage statistics" | "core/custom_ca_certs_file" : "CA bundle for TLS"
  | "core/universe_domain" : "Universe domain of the API endpoints"
  | "compute/zone" : "Default Compute Engine zone" | "compute/region" : "Default Compute Engine region"
  | "run/region" : "Default Cloud Run region" | "run/platform" : "Default Cloud Run platform"
  | "functions/region" : "Default Cloud Functions region" | "container/cluster" : "Default GKE cluster"
  | "artifacts/location" : "Default Artifact Registry location" | "artifacts/repository" : "Default Artifact Registry repository"
  | "ai/region" : "Default Vertex AI region" | "billing/quota_project" : "Project charged for quota"
  | "auth/impersonate_service_account" : "Service account to impersonate"
  | "auth/access_token_file" : "File with an access token"
  | "component_manager/disable_update_check" : "Do not check for updates"
  | "survey/disable_prompts" : "Disable survey prompts"
  | "accessibility/screen_reader" : "Screen reader friendly output"
  | @any ;

configurations_command =
    "create" : "Create a new named configuration" , { "--activate" : "Activate the new configuration" | "--no-activate" : "Do not activate the new configuration" | ga }
  | "activate" : "Activate an existing named configuration" , { ga }
  | "list" : "List existing named configurations" , { short_query | g }
  | "delete" : "Delete named configurations" , { ga }
  | "describe" : "Describe a named configuration" , { "--all" : "Include unset properties" | ga }
  | "rename" : "Rename a named configuration" , { "--new-name" , @any | "--new-name=" : "New name of the configuration" ~ @any | ga } ;

(* projects *)

projects_command =
    "add-iam-policy-binding" : "Add an IAM policy binding for a project" , { binding | ga }
  | "create" : "Create a new project" , { project_create_flag | labels | ga }
  | "delete" : "Delete a project" , { ga }
  | "describe" : "Show metadata for a project" , { ga }
  | "get-ancestors" : "Get the ancestors for a project" , { ga }
  | "get-ancestors-iam-policy" : "Get IAM policies for a project and its ancestors" , { "--include-deny" : "Include deny policies" | query_flag | ga }
  | "get-iam-policy" : "Get the IAM policy for a project" , { query_flag | ga }
  | "list" : "List projects accessible by the active account" , { list_flag | g }
  | "remove-iam-policy-binding" : "Remove an IAM policy binding for a project" , { binding | "--all" : "Remove the binding for all conditions" | ga }
  | "set-iam-policy" : "Set the IAM policy for a project" , { g | @file | @any }
  | "undelete" : "Undelete a project" , { ga }
  | "update" : "Update the name of a project" , { name | ga } ;

name = "--name" , @any | "--name=" : "Display name" ~ @any ;

project_create_flag =
    "--enable-cloud-apis" : "Enable cloudapis.googleapis.com" | "--no-enable-cloud-apis" : "Do not enable cloudapis.googleapis.com"
  | "--folder" , @any | "--folder=" : "Folder to create the project in" ~ @any
  | "--organization" , @any
  | "--organization=" : "Organization to create the project in" ~ @any
  | "--set-as-default" : "Set the new project as the default"
  | "--tags" , @any | "--tags=" : "KEY=VALUE tags to bind" ~ @any
  | name ;

(* compute *)

compute_command =
    "instances" : "Read and manipulate virtual machine instances" , { g } , [ instances_command ]
  | "ssh" : "SSH into a virtual machine instance" , { ssh_flag | ssh_common | ga } , [ "--" , { @any } ]
  | "scp" : "Copy files to and from instances via scp" , { scp_flag | ssh_common | g | @file | @any }
  | "config-ssh" : "Write SSH config Host entries for each instance" , { config_ssh_flag | g }
  | "start-iap-tunnel" : "Start an IAP TCP forwarding tunnel" , { iap_tunnel_flag | iap_network | zga }
  | ( "connect-to-serial-port" : "Connect to the serial port of an instance"
      | "copy-files" : "Copy files to and from instances via scp"
      | "reset-windows-password" : "Reset the password of a Windows instance"
      | "sign-url" : "Sign a URL for Cloud CDN Signed URLs"
      | "accelerator-types" : "Read accelerator types"
      | "addresses" : "Read and manipulate addresses"
      | "advice" : "Recommend optimal allocation of resources"
      | "backend-buckets" : "Read and manipulate backend buckets"
      | "backend-services" : "List, create, and delete backend services"
      | "commitments" : "Manage commitments"
      | "composite-health-checks" : "Manage composite health checks"
      | "diagnose" : "Debugging tools for virtual machine instances"
      | "disk-types" : "Read virtual disk types"
      | "disks" : "Read and manipulate disks"
      | "external-vpn-gateways" : "Manage External VPN Gateways"
      | "firewall-policies" : "Manage organization firewall policies"
      | "firewall-rules" : "List, create, update, and delete firewall rules"
      | "forwarding-rules" : "Read and manipulate traffic forwarding rules"
      | "future-reservations" : "Manage future reservations"
      | "health-aggregation-policies" : "Manage health aggregation policies"
      | "health-checks" : "Read and manipulate health checks"
      | "health-sources" : "Manage health sources"
      | "http-health-checks" : "Read and manipulate HTTP health checks"
      | "https-health-checks" : "Read and manipulate HTTPS health checks"
      | "images" : "List, create, and delete images"
      | "instance-groups" : "Read and manipulate instance groups"
      | "instance-templates" : "Read and manipulate instance templates"
      | "instant-snapshot-groups" : "Create, list and delete instant snapshot groups"
      | "instant-snapshots" : "Create, list and delete instant snapshots"
      | "interconnects" : "Read and manipulate interconnects"
      | "machine-images" : "Read and manage machine images"
      | "machine-types" : "Read virtual machine types"
      | "migration" : "Migrate to Virtual Machines"
      | "network-attachments" : "Manage network attachments"
      | "network-edge-security-services" : "Read and manipulate network edge security services"
      | "network-endpoint-groups" : "Read and manipulate network endpoint groups"
      | "network-firewall-policies" : "Manage network firewall policies"
      | "network-profiles" : "Read network profiles"
      | "networks" : "List, create, and delete networks"
      | "operations" : "Read and manipulate operations"
