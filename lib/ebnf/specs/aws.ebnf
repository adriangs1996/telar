  | "list-imports" : "Lists all stacks that are importing an exported output value"
  | "cancel-update-stack" : "Cancels an update on the specified stack"
  | "continue-update-rollback" : "Continue update rollback"
  | "detect-stack-drift" : "Detects whether a stack's actual configuration differs"
  | "describe-stack-drift-detection-status" : "Returns information about a stack drift detection operation"
  | "describe-stack-resource-drifts" : "Describe stack resource drifts"
  | "update-termination-protection" : "Updates termination protection for the specified stack"
  | "set-stack-policy" : "Sets a stack policy for a specified stack"
  | "get-stack-policy" : "Returns the stack policy for a specified stack"
  | "estimate-template-cost" : "Returns the estimated monthly cost of a template"
  | "signal-resource" : "Signal resource"
  | "create-stack-set" : "Creates a StackSet"
  | "update-stack-set" : "Update stack set"
  | "delete-stack-set" : "Deletes a StackSet"
  | "list-stack-sets" : "List stack sets"
  | "describe-stack-set" : "Returns the description of the specified StackSet"
  | "list-stack-instances" : "List stack instances"
  | "create-stack-instances" : "Creates stack instances for the specified accounts"
  | "delete-stack-instances" : "Deletes stack instances for the specified accounts"
  | "help" : "Show the documentation of this service" ;

cloudformation_command =
    "deploy" : "Deploy" , { cloudformation_deploy_option }
  | "package" : "Package" , { cloudformation_package_option }
  | "create-stack" : "Creates a stack as specified in the template" , { cloudformation_create_stack_option }
  | "update-stack" : "Updates a stack as specified in the template" , { cloudformation_update_stack_option }
  | "delete-stack" : "Deletes a specified stack" , { cloudformation_delete_stack_option }
  | "describe-stacks" : "Returns the description for the specified stack" , { cloudformation_describe_stacks_option }
  | "list-stacks" : "List stacks" , { cloudformation_list_stacks_option }
  | "describe-stack-events" : "Describe stack events" , { cloudformation_describe_stack_events_option }
  | "describe-stack-resources" : "Describe stack resources" , { cloudformation_describe_stack_resources_option }
  | "validate-template" : "Validates a specified template" , { cloudformation_validate_template_option }
  | "wait" : "Wait until a condition is satisfied" , [ cloudformation_waiter , { @any } ]
  | cloudformation_operation , { @any } ;

