(* aws: checked against aws-cli 2.37.7 (`aws help`, `aws <service> help` and the
   command tables the CLI builds from its bundled service models).

   Modelled:
   - every top-level command `aws help` lists, with the service's full name;
   - the global options, accepted before the service and anywhere after it;
   - configure, s3 (cp, mv, rm, sync, ls, mb, rb, presign, website), sts and
     secretsmanager: every operation; ec2, ecr, ecs, eks, lambda, iam, logs,
     cloudformation and ssm: their most used operations. The main operations
     of each have their options;
   - `wait` lists each modelled service's waiters.
   Other services and operations accept any words after their name. Options that
   take a list (--instance-ids a b c) accept any following words, so an unknown
   option after a list value is not caught. Values are separate words; local paths
   complete as files, S3 URIs and every other value are free text. *)

aws = { global_option } , [ service ] ;

global_option =
    "--debug" : "Turn on debug logging"
  | "--endpoint-url" : "Override the command's default URL" , @any
  | "--no-verify-ssl" : "Do not verify SSL certificates"
  | "--no-paginate" : "Disable automatic pagination"
  | "--output" : "The formatting style for command output" , ( "json" | "text" | "table" | "yaml" | "yaml-stream" | "off" )
  | "--query" : "A JMESPath query to filter the response data" , @any
  | "--profile" : "Use a specific profile from your credential file" , @any
  | "--region" : "The region to use" , @any
  | "--version" : "Display the version of this tool"
  | "--color" : "Turn on/off color output" , ( "on" | "off" | "auto" )
  | "--no-sign-request" : "Do not sign requests"
  | "--ca-bundle" : "CA certificate bundle to verify SSL certificates" , @file
  | "--cli-read-timeout" : "Maximum socket read time in seconds" , @number
  | "--cli-connect-timeout" : "Maximum socket connect time in seconds" , @number
  | "--cli-binary-format" : "The formatting style for binary blobs" , ( "base64" | "raw-in-base64-out" )
  | "--no-cli-pager" : "Disable the pager for output"
  | "--cli-auto-prompt" : "Automatically prompt for CLI input parameters"
  | "--no-cli-auto-prompt" : "Do not prompt for CLI input parameters"
  | "--cli-error-format" : "The formatting style for error output" , ( "legacy" | "json" | "yaml" | "text" | "table" | "enhanced" ) ;

(* Options every service operation accepts, and those of paginated operations. *)
op_input =
    "--cli-input-json" : "Read arguments from a JSON string" , @any
  | "--cli-input-yaml" : "Read arguments from a YAML string" , @any
  | "--generate-cli-skeleton" : "Print a JSON skeleton of the input or output" , [ "input" | "output" | "yaml-input" ] ;
op_paging =
    "--starting-token" : "Token to specify where to start paginating" , @any
  | "--page-size" : "The size of each page to get in the service call" , @number
  | "--max-items" : "The total number of items to return" , @number ;

service =
    "cloudformation" : "AWS CloudFormation" , { global_option } , [ cloudformation_command ]
  | "ec2" : "Amazon Elastic Compute Cloud" , { global_option } , [ ec2_command ]
  | "ecr" : "Amazon Elastic Container Registry" , { global_option } , [ ecr_command ]
  | "ecs" : "Amazon EC2 Container Service" , { global_option } , [ ecs_command ]
  | "eks" : "Amazon Elastic Kubernetes Service" , { global_option } , [ eks_command ]
  | "iam" : "AWS Identity and Access Management" , { global_option } , [ iam_command ]
  | "lambda" : "AWS Lambda" , { global_option } , [ lambda_command ]
  | "logs" : "Amazon CloudWatch Logs" , { global_option } , [ logs_command ]
  | "secretsmanager" : "AWS Secrets Manager" , { global_option } , [ secretsmanager_command ]
  | "ssm" : "Amazon Simple Systems Manager (SSM)" , { global_option } , [ ssm_command ]
  | "sts" : "AWS Security Token Service" , { global_option } , [ sts_command ]
  | "s3" : "High-level S3 commands: cp, sync, ls, mb, rb" , { global_option } , [ s3_command ]
  | "configure" : "Configure credentials, regions and profiles" , { global_option } , [ configure_command ]
  | other_service , { @any }
  | "help" : "Show the documentation of the AWS CLI" , { @any } ;

other_service =
