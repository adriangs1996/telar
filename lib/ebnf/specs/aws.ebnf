configure_operation =
    "help" : "Show the documentation of this service" ;

configure_command =
    "list" : "List the configuration used for the profile" , { configure_list_option }
  | "get" : "Get a configuration value from the config file" , { configure_get_option }
  | "set" : "Set a configuration value in the config file" , { configure_set_option }
  | "add-model" : "Add a service JSON model to ~/.aws/models" , { configure_add_model_option }
  | "import" : "Import CSV credentials generated from the AWS web console" , { configure_import_option }
  | "list-profiles" : "List the profiles available to the AWS CLI" , { configure_list_profiles_option }
