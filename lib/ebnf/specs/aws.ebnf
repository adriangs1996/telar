  | "export-credentials" : "Export credentials in various formats" , { configure_export_credentials_option }
  | "agent-toolkit" : "Set up AI coding agents with AWS skills and the AWS MCP Server" , { configure_agent_toolkit_option }
  | "wizard" : "Interactive command for creating and configuring AWS resources" , { configure_wizard_option }
  | configure_operation , { @any } ;
