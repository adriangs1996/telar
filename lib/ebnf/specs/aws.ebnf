s3_transfer_option =
    "--dryrun" : "Dryrun"
  | "--quiet" : "Does not display the operations performed from the specified command"
  | "--include" : "Include" , @any
  | "--exclude" : "Exclude" , @any
  | "--acl" : "Sets the ACL for the object when the command is performed" , ( "private" | "public-read" | "public-read-write" | "authenticated-read" | "aws-exec-read" | "bucket-owner-read" | "bucket-owner-full-control" | "log-delivery-write" )
  | "--follow-symlinks" : "Follow symlinks"
  | "--no-follow-symlinks"
  | "--no-guess-mime-type" : "Do not try to guess the mime type for uploaded files"
  | "--sse" : "Specifies server-side encryption of the object in S3" , [ ( "AES256" | "aws:kms" ) ]
  | "--sse-c" : "Server-side encryption with a customer-provided key" , [ ( "AES256" ) ]
  | "--sse-c-key" : "The customer-provided key for SSE-C" , @any
  | "--sse-kms-key-id" : "Sse kms key id" , @any
  | "--sse-c-copy-source" : "Sse c copy source" , [ ( "AES256" ) ]
  | "--sse-c-copy-source-key" : "Sse c copy source key" , @any
  | "--storage-class" : "The type of storage to use for the object" , ( "STANDARD" | "REDUCED_REDUNDANCY" | "STANDARD_IA" | "ONEZONE_IA" | "INTELLIGENT_TIERING" | "GLACIER" | "DEEP_ARCHIVE" | "GLACIER_IR" )
  | "--grants" : "Grant specific permissions to individual users or groups" , @any , { @any }
  | "--website-redirect" : "If the bucket is configured as a website" , @any
  | "--content-type" : "Specify an explicit content type for this operation" , @any
  | "--cache-control" : "Specifies caching behavior along the request/reply chain" , @any
  | "--content-disposition" : "Specifies presentational information for the object" , @any
  | "--content-encoding" : "Content encodings applied to the object" , @any
  | "--content-language" : "The language the content is in" , @any
  | "--expires" : "The date and time at which the object is no longer cacheable" , @any
  | "--source-region" : "When transferring objects from an s3 bucket to an s3 bucket" , @any
  | "--only-show-errors" : "Only errors and warnings are displayed"
  | "--no-progress" : "File transfer progress is not displayed"
  | "--progress-frequency" : "Number of seconds to wait before updating file transfer progress" , @any
  | "--progress-multiline" : "Show progress on multiple lines"
  | "--ignore-glacier-warnings" : "Turns off glacier warnings"
  | "--force-glacier-transfer" : "Force a transfer request on all Glacier objects"
  | "--request-payer" : "Confirm that the requester pays for the request" , [ ( "requester" ) ]
  | "--checksum-mode" : "To retrieve the checksum, this mode must be enabled" , ( "ENABLED" )
  | "--checksum-algorithm" : "Indicates the algorithm used to create the checksum for the object" , ( "CRC64NVME" | "CRC32" | "SHA256" | "SHA1" | "CRC32C" | "SHA512" | "XXHASH64" | "XXHASH3" | "XXHASH128" )
  | "--metadata" : "A map of metadata to store with the objects in S3" , @any
  | "--copy-props" : "Determines which properties are copied from the source S3 object" , ( "none" | "metadata-directive" | "default" | "all" )
  | "--metadata-directive" : "Sets the x-amz-metadata-directive header for CopyObject operations" , ( "COPY" | "REPLACE" )
  | "--case-conflict" : "Case conflict" , ( "ignore" | "skip" | "warn" | "error" )
  | "--no-overwrite" : "This flag prevents overwriting of files at the destination" ;

s3_ls_option =
    "--recursive" : "Act on all files or objects under the directory or prefix"
  | "--human-readable" : "Displays file sizes in human readable format"
  | "--summarize" : "Displays summary information (number of objects, total size)"
  | "--request-payer" : "Confirm that the requester pays for the request" , [ ( "requester" ) ]
  | "--bucket-name-prefix" : "Bucket name prefix" , @any
  | "--bucket-region" : "Bucket region" , @any
  | global_option
  | @any ;

s3_website_option =
    "--index-document" : "Suffix appended to requests for a directory" , @any
  | "--error-document" : "The object key name to use when a 4XX class error occurs" , @any
  | global_option
  | @any ;

s3_cp_option =
    "--expected-size" : "Expected size in bytes of a stream upload" , @any
  | "--recursive" : "Act on all files or objects under the directory or prefix"
  | s3_transfer_option
  | global_option
  | @file ;

s3_mv_option =
    "--recursive" : "Act on all files or objects under the directory or prefix"
  | "--validate-same-s3-paths" : "Verify that an object is not moved onto itself"
  | s3_transfer_option
  | global_option
  | @file ;

s3_rm_option =
    "--dryrun" : "Dryrun"
  | "--quiet" : "Does not display the operations performed from the specified command"
  | "--recursive" : "Act on all files or objects under the directory or prefix"
  | "--request-payer" : "Confirm that the requester pays for the request" , [ ( "requester" ) ]
  | "--include" : "Include" , @any
  | "--exclude" : "Exclude" , @any
  | "--only-show-errors" : "Only errors and warnings are displayed"
  | global_option
  | @any ;

s3_sync_option =
    s3_transfer_option
  | global_option
  | @file ;

s3_mb_option =
    "--tags" : "Tags to apply, as Key=k,Value=v" , @any
  | global_option
  | @any ;

s3_rb_option =
    "--force" : "Deletes all objects in the bucket including the bucket itself"
  | global_option
  | @any ;

s3_presign_option =
    "--expires-in" : "Number of seconds until the pre-signed URL expires" , @any
  | global_option
  | @any ;

s3_operation =
    "help" : "Show the documentation of this service" ;

s3_command =
    "ls" : "List S3 objects and common prefixes under a prefix or all S3 buckets" , { s3_ls_option }
  | "website" : "Set the website configuration for a bucket" , { s3_website_option }
  | "cp" : "Copies a local file or S3 object to another location locally or in S3" , { s3_cp_option }
  | "mv" : "Move a local file or S3 object locally or in S3" , { s3_mv_option }
  | "rm" : "Deletes an S3 object" , { s3_rm_option }
  | "sync" : "Syncs directories and S3 prefixes" , { s3_sync_option }
  | "mb" : "Creates an S3 bucket" , { s3_mb_option }
  | "rb" : "Deletes an empty S3 bucket" , { s3_rb_option }
  | "presign" : "Generate a pre-signed URL for an Amazon S3 object" , { s3_presign_option }
  | s3_operation , { @any } ;

