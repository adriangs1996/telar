opt_tty = "-t" : "Stdin is a TTY" | "--tty" : "Stdin is a TTY" ;

opt_all_namespaces2 =
    "-A" : "Check the specified action in all namespaces" | "--all-namespaces" : "Check the specified action in all namespaces" ;

opt_force_conflicts = "--force-conflicts" : "Server-side apply will force the changes against conflicts" ;

opt_prune_allowlist =
    "--prune-allowlist" : "Overwrite the default allowlist with <group/version/kind> for --prune" , @any | "--prune-allowlist=" : "Overwrite the default allowlist with <group/version/kind> for --prune" ~ @any ;

opt_server_side = "--server-side" : "Apply runs in the server instead of the client" ;

opt_filename4 =
    "-f" : "File, directory or URL with the last-applied-configuration" | "--filename" : "File, directory or URL with the last-applied-configuration" ;

opt_resource_version =
    "--resource-version" : "Update only if this is the object's current resource version" , @any | "--resource-version=" : "Update only if this is the object's current resource version" ~ @any ;

(* Resource types: the built-in ones of the resource types table in the kubectl
   reference (kubernetes.io/docs/reference/kubectl), with their short names.
   TYPE/NAME, TYPE.GROUP and custom resources go through @any. *)
resource_type =
    "all" : "Every resource of the common types"
  | "pods" : "Pods" | "po" : "Pods"
  | "deployments" : "Deployments" | "deploy" : "Deployments"
  | "services" : "Services" | "svc" : "Services"
  | "replicasets" : "Replica sets" | "rs" : "Replica sets"
  | "statefulsets" : "Stateful sets" | "sts" : "Stateful sets"
  | "daemonsets" : "Daemon sets" | "ds" : "Daemon sets"
  | "jobs" : "Jobs" | "cronjobs" : "Cron jobs" | "cj" : "Cron jobs"
  | "configmaps" : "Config maps" | "cm" : "Config maps"
  | "secrets" : "Secrets"
  | "namespaces" : "Namespaces" | "ns" : "Namespaces"
  | "nodes" : "Nodes" | "no" : "Nodes"
  | "persistentvolumeclaims" : "Persistent volume claims" | "pvc" : "Persistent volume claims"
  | "persistentvolumes" : "Persistent volumes" | "pv" : "Persistent volumes"
  | "ingresses" : "Ingresses" | "ing" : "Ingresses" | "ingressclasses" : "Ingress classes"
  | "serviceaccounts" : "Service accounts" | "sa" : "Service accounts"
  | "events" : "Events" | "ev" : "Events"
  | "endpoints" : "Endpoints" | "ep" : "Endpoints" | "endpointslices" : "Endpoint slices"
  | "horizontalpodautoscalers" : "Horizontal pod autoscalers" | "hpa" : "Horizontal pod autoscalers"
  | "networkpolicies" : "Network policies" | "netpol" : "Network policies"
  | "poddisruptionbudgets" : "Pod disruption budgets" | "pdb" : "Pod disruption budgets"
  | "replicationcontrollers" : "Replication controllers" | "rc" : "Replication controllers"
  | "resourcequotas" : "Resource quotas" | "quota" : "Resource quotas"
  | "limitranges" : "Limit ranges" | "limits" : "Limit ranges"
  | "storageclasses" : "Storage classes" | "sc" : "Storage classes"
  | "roles" : "Roles" | "rolebindings" : "Role bindings"
  | "clusterroles" : "Cluster roles" | "clusterrolebindings" : "Cluster role bindings"
  | "customresourcedefinitions" : "Custom resource definitions" | "crd" : "Custom resource definitions"
  | "priorityclasses" : "Priority classes" | "pc" : "Priority classes"
  | "certificatesigningrequests" : "Certificate signing requests" | "csr" : "Certificate signing requests"
  | "leases" : "Leases" | "controllerrevisions" : "Controller revisions"
  | "mutatingwebhookconfigurations" : "Mutating admission webhooks"
  | "validatingwebhookconfigurations" : "Validating admission webhooks" ;

(* -o FORMAT, with the joined forms jsonpath=..., custom-columns=..., go-template=... *)
output_format =
    "json" : "JSON" | "yaml" : "YAML" | "wide" : "Plain text with more columns" | "name" : "Only TYPE/NAME"
  | "jsonpath=" : "Fields picked by a JSONPath template" ~ @any
  | "jsonpath-as-json=" : "JSONPath results as JSON" ~ @any
  | "jsonpath-file=" : "JSONPath template from a file" ~ @file
  | "custom-columns=" : "Columns, as NAME:.json.path pairs" ~ @any
  | "custom-columns-file=" : "Columns from a file" ~ @file
  | "go-template=" : "Fields picked by a Go template" ~ @any
  | "go-template-file=" : "Go template from a file" ~ @file
  | "template=" : "Fields picked by a Go template" ~ @any
  | "templatefile=" : "Go template from a file" ~ @file ;

(* The value of --output=FORMAT, where the template forms are a single glued word. *)
output_name = "json" | "yaml" | "wide" | "name" | @any ;

debug_profile = "legacy" | "general" | "baseline" | "netadmin" | "restricted" | "sysadmin" ;

profile_value = "none" | "cpu" | "heap" | "goroutine" | "threadcreate" | "block" | "mutex" ;
