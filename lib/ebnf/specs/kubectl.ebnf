  | opt_recursive
  | opt_save_config
  | opt_show_managed_fields
  | opt_subresource
  | opt_template2
  | opt_timeout
  | opt_validate
  | opt_wait ;

wait_option =
    opt_all
  | opt_all_namespaces
  | opt_allow_missing_template_keys
  | opt_field_selector
  | "-f" : "Identifying the resource" , @file | "--filename" : "Identifying the resource" , @file | "--filename=" : "Identifying the resource" ~ @file
  | "--for" : "Condition to wait on: create, delete, condition=NAME or jsonpath=EXPR" , @any | "--for=" : "Condition to wait on: create, delete, condition=NAME or jsonpath=EXPR" ~ @any
  | opt_local
  | opt_output2
  | opt_recursive
  | "-l" : "Selector (label query) to filter on, supports '=', '==', and '!='" , @any | "--selector" : "Selector (label query) to filter on, supports '=', '==', and '!='" , @any | "--selector=" : "Selector (label query) to filter on, supports '=', '==', and '!='" ~ @any
