(* kubectl: every command `kubectl --help` lists, checked against `kubectl <command>
   --help` and `kubectl options` of kubectl v1.33.9.

   Conventions:
   - The global options (`kubectl options`) are accepted before and after the command.
   - Options with a value accept `--name value` and `--name=value`; short ones accept
     `-x value` and `-xvalue`. Boolean flags are modelled bare; `--flag=false` is not.
   - --dry-run, --validate and --cascade take their value only joined (--dry-run=client),
     as pflag reads options that have a default for the bare flag.
   - Resource names, pods, containers, contexts and namespaces have no provider yet:
     @any. Resource types are offered as literals after get, describe, delete, ...
   - Words after `--` in exec, run and debug belong to the command run in the pod.
   - Commands used less often (most create and set subcommands, certificate, plugin)
     list their options and accept any word after them.
   - `opt_*` rules are options several commands share. *)

kubectl = { global_option } , [ command ] ;

global_option =
    "--as" : "Username to impersonate for the operation" , @any | "--as=" : "Username to impersonate for the operation" ~ @any
  | "--as-group" : "Group to impersonate for the operation" , @any | "--as-group=" : "Group to impersonate for the operation" ~ @any
  | "--as-uid" : "UID to impersonate for the operation" , @any | "--as-uid=" : "UID to impersonate for the operation" ~ @any
  | "--cache-dir" : "Default cache directory" , @directory | "--cache-dir=" : "Default cache directory" ~ @directory
  | "--certificate-authority" : "Path to a cert file for the certificate authority" , @file | "--certificate-authority=" : "Path to a cert file for the certificate authority" ~ @file
  | "--client-certificate" : "Path to a client certificate file for TLS" , @file | "--client-certificate=" : "Path to a client certificate file for TLS" ~ @file
  | "--client-key" : "Path to a client key file for TLS" , @file | "--client-key=" : "Path to a client key file for TLS" ~ @file
  | "--cluster" : "The name of the kubeconfig cluster to use" , @any | "--cluster=" : "The name of the kubeconfig cluster to use" ~ @any
  | "--context" : "The name of the kubeconfig context to use" , @any | "--context=" : "The name of the kubeconfig context to use" ~ @any
  | "--disable-compression" : "Opt-out of response compression for all requests to the server"
  | "--insecure-skip-tls-verify" : "The server's certificate will not be checked for validity"
  | "--kubeconfig" : "Path to the kubeconfig file to use for CLI requests" , @file | "--kubeconfig=" : "Path to the kubeconfig file to use for CLI requests" ~ @file
  | "--log-flush-frequency" : "Maximum number of seconds between log flushes" , @any | "--log-flush-frequency=" : "Maximum number of seconds between log flushes" ~ @any
  | "--match-server-version" : "Require server version to match client version"
  | "-n" : "The namespace scope for this CLI request" , @any | "--namespace" : "The namespace scope for this CLI request" , @any | "--namespace=" : "The namespace scope for this CLI request" ~ @any
  | "--password" : "Password for basic authentication to the API server" , @any | "--password=" : "Password for basic authentication to the API server" ~ @any
  | "--profile" : "Name of profile to capture" , profile_value | "--profile=" : "Name of profile to capture" ~ profile_value
  | "--profile-output" : "Name of the file to write the profile to" , @file | "--profile-output=" : "Name of the file to write the profile to" ~ @file
  | "--request-timeout" : "The length of time to wait before giving up on a single server request" , @any | "--request-timeout=" : "The length of time to wait before giving up on a single server request" ~ @any
  | "-s" : "The address and port of the Kubernetes API server" , @any | "--server" : "The address and port of the Kubernetes API server" , @any | "--server=" : "The address and port of the Kubernetes API server" ~ @any
  | "--tls-server-name" : "Server name to use for server certificate validation" , @any | "--tls-server-name=" : "Server name to use for server certificate validation" ~ @any
  | "--token" : "Bearer token for authentication to the API server" , @any | "--token=" : "Bearer token for authentication to the API server" ~ @any
  | "--user" : "The name of the kubeconfig user to use" , @any | "--user=" : "The name of the kubeconfig user to use" ~ @any
  | "--username" : "Username for basic authentication to the API server" , @any | "--username=" : "Username for basic authentication to the API server" ~ @any
  | "-v" : "Number for the log level verbosity" , @any | "--v" : "Number for the log level verbosity" , @any | "--v=" : "Number for the log level verbosity" ~ @any
  | "--vmodule" : "Comma-separated list of pattern=N settings for file-filtered logging" , @any | "--vmodule=" : "Comma-separated list of pattern=N settings for file-filtered logging" ~ @any
  | "--warnings-as-errors" : "Treat warnings from the server as errors" ;

create_clusterrole_option =
    "--aggregation-rule" : "An aggregation label selector for combining ClusterRoles"
  | opt_allow_missing_template_keys
  | opt_dry_run
  | opt_field_manager
  | "--non-resource-url" : "A partial url that user should have access to"
  | opt_output
  | opt_resource
  | opt_resource_name
  | opt_save_config
  | opt_show_managed_fields
  | opt_template
  | opt_validate
  | opt_verb ;

create_clusterrolebinding_option =
    opt_allow_missing_template_keys
  | "--clusterrole" : "ClusterRole this ClusterRoleBinding should reference"
  | opt_dry_run
  | opt_field_manager
  | "--group" : "Groups to bind to the clusterrole"
  | opt_output
  | opt_save_config
  | "--serviceaccount" : "Service accounts to bind to the clusterrole"
  | opt_show_managed_fields
  | opt_template
  | "--user" : "Usernames to bind to the clusterrole"
  | opt_validate ;

create_configmap_option =
    opt_allow_missing_template_keys
  | "--append-hash" : "Append a hash of the configmap to its name"
  | opt_dry_run
  | opt_field_manager2
  | "--from-env-file" : "File of key=val lines to create the config map from" , @file | "--from-env-file=" : "File of key=val lines to create the config map from" ~ @file
  | opt_from_file
  | "--from-literal" : "Specify a key and literal value to insert in configmap" , @any | "--from-literal=" : "Specify a key and literal value to insert in configmap" ~ @any
  | opt_output2
  | opt_save_config
  | opt_show_managed_fields
  | opt_template2
  | opt_validate ;

create_cronjob_option =
    opt_allow_missing_template_keys
  | opt_dry_run
  | opt_field_manager2
  | opt_image
  | opt_output2
  | "--restart" : "Job's restart policy. supported values: OnFailure, Never" , @any | "--restart=" : "Job's restart policy. supported values: OnFailure, Never" ~ @any
  | opt_save_config
  | "--schedule" : "A schedule in the Cron format the job should be run with" , @any | "--schedule=" : "A schedule in the Cron format the job should be run with" ~ @any
  | opt_show_managed_fields
  | opt_template2
  | opt_validate ;

create_deployment_option =
    opt_allow_missing_template_keys
  | opt_dry_run
  | opt_field_manager2
  | "--image" : "Image names to run" , @any | "--image=" : "Image names to run" ~ @any
  | opt_output2
  | "--port" : "The containerPort that this deployment exposes" , @any | "--port=" : "The containerPort that this deployment exposes" ~ @any
  | "-r" : "Number of replicas to create" , @any | "--replicas" : "Number of replicas to create" , @any | "--replicas=" : "Number of replicas to create" ~ @any
  | opt_save_config
  | opt_show_managed_fields
  | opt_template2
  | opt_validate ;

create_ingress_option =
    opt_allow_missing_template_keys
  | "--annotation" : "Annotation to insert in the ingress object" , @any | "--annotation=" : "Annotation to insert in the ingress object" ~ @any
  | "--class" : "Ingress Class to be used" , @any | "--class=" : "Ingress Class to be used" ~ @any
  | "--default-backend" : "Default service for backend, in format of svcname:port" , @any | "--default-backend=" : "Default service for backend, in format of svcname:port" ~ @any
  | opt_dry_run
  | opt_field_manager2
  | opt_output2
  | "--rule" : "Rule in format host/path=service:port[,tls=secretname]" , @any | "--rule=" : "Rule in format host/path=service:port[,tls=secretname]" ~ @any
  | opt_save_config
  | opt_show_managed_fields
  | opt_template2
  | opt_validate ;

create_job_option =
    opt_allow_missing_template_keys
  | opt_dry_run
  | opt_field_manager2
  | "--from" : "The name of the resource to create a Job from" , @any | "--from=" : "The name of the resource to create a Job from" ~ @any
  | opt_image
  | opt_output2
  | opt_save_config
  | opt_show_managed_fields
  | opt_template2
  | opt_validate ;

create_namespace_option =
    opt_allow_missing_template_keys
  | opt_dry_run
  | opt_field_manager2
  | opt_output2
  | opt_save_config
  | opt_show_managed_fields
  | opt_template2
  | opt_validate ;

create_poddisruptionbudget_option =
    opt_allow_missing_template_keys
  | opt_dry_run
  | opt_field_manager
  | "--max-unavailable" : "Maximum number or percentage of unavailable pods"
  | "--min-available" : "The minimum number or percentage of available pods this budget requires"
  | opt_output
  | opt_save_config
  | "--selector" : "A label selector to use for this budget"
  | opt_show_managed_fields
  | opt_template
  | opt_validate ;

create_priorityclass_option =
    opt_allow_missing_template_keys
  | "--description" : "Guidelines on when to use this priority class"
  | opt_dry_run
  | opt_field_manager
  | "--global-default" : "Make this priority class the default one"
  | opt_output
  | "--preemption-policy" : "Preemption-policy is the policy for preempting pods with lower priority"
  | opt_save_config
  | opt_show_managed_fields
  | opt_template
  | opt_validate
  | "--value" : "The value of this priority class" ;

create_quota_option =
    opt_allow_missing_template_keys
  | opt_dry_run
  | opt_field_manager
  | "--hard" : "Comma-separated resource=quantity pairs that define a hard limit"
  | opt_output
  | opt_save_config
  | "--scopes" : "Comma-separated quota scopes every tracked object must match"
  | opt_show_managed_fields
  | opt_template
  | opt_validate ;

create_role_option =
    opt_allow_missing_template_keys
  | opt_dry_run
  | opt_field_manager
  | opt_output
  | opt_resource
  | opt_resource_name
  | opt_save_config
  | opt_show_managed_fields
  | opt_template
  | opt_validate
  | opt_verb ;

create_rolebinding_option =
    opt_allow_missing_template_keys
  | "--clusterrole" : "ClusterRole this RoleBinding should reference"
  | opt_dry_run
  | opt_field_manager
  | opt_group
  | opt_output
  | "--role" : "Role this RoleBinding should reference"
  | opt_save_config
  | "--serviceaccount" : "Service accounts to bind to the role, in the format <namespace>:<name>"
  | opt_show_managed_fields
  | opt_template
  | opt_user
  | opt_validate ;

create_secret_docker_registry_option =
    opt_allow_missing_template_keys
  | opt_append_hash
  | "--docker-email" : "Email for Docker registry" , @any | "--docker-email=" : "Email for Docker registry" ~ @any
  | "--docker-password" : "Password for Docker registry authentication" , @any | "--docker-password=" : "Password for Docker registry authentication" ~ @any
  | "--docker-server" : "Server location for Docker registry" , @any | "--docker-server=" : "Server location for Docker registry" ~ @any
  | "--docker-username" : "Username for Docker registry authentication" , @any | "--docker-username=" : "Username for Docker registry authentication" ~ @any
  | opt_dry_run
  | opt_field_manager2
  | "--from-file" : "Docker config file to add, as path or name=path" , @any | "--from-file=" : "Docker config file to add, as path or name=path" ~ @any
  | opt_output2
  | opt_save_config
  | opt_show_managed_fields
  | opt_template2
  | opt_validate ;

create_secret_generic_option =
    opt_allow_missing_template_keys
  | opt_append_hash
  | opt_dry_run
  | opt_field_manager2
  | "--from-env-file" : "File of key=val lines to create the secret from" , @file | "--from-env-file=" : "File of key=val lines to create the secret from" ~ @file
  | opt_from_file
  | "--from-literal" : "Specify a key and literal value to insert in secret" , @any | "--from-literal=" : "Specify a key and literal value to insert in secret" ~ @any
  | opt_output2
  | opt_save_config
  | opt_show_managed_fields
  | opt_template2
  | "--type" : "The type of secret to create" , @any | "--type=" : "The type of secret to create" ~ @any
  | opt_validate ;

create_secret_tls_option =
    opt_allow_missing_template_keys
  | opt_append_hash
  | "--cert" : "Path to PEM encoded public key certificate" , @any | "--cert=" : "Path to PEM encoded public key certificate" ~ @any
  | opt_dry_run
  | opt_field_manager2
  | "--key" : "Path to private key associated with given certificate" , @any | "--key=" : "Path to private key associated with given certificate" ~ @any
  | opt_output2
  | opt_save_config
  | opt_show_managed_fields
  | opt_template2
  | opt_validate ;

create_secret_command =
    "docker-registry" : "Create a secret for use with a Docker registry" , { create_secret_docker_registry_option | global_option | @any }
  | "generic" : "Create a secret from a local file, directory, or literal value" , { create_secret_generic_option | global_option | @any }
  | "tls" : "Create a TLS secret" , { create_secret_tls_option | global_option | @any } ;

create_service_clusterip_option =
    opt_allow_missing_template_keys
  | "--clusterip" : "Assign your own ClusterIP or set to 'None' for a 'headless' service"
  | opt_dry_run
  | opt_field_manager
  | opt_output
  | opt_save_config
  | opt_show_managed_fields
  | opt_tcp
  | opt_template
  | opt_validate ;

create_service_externalname_option =
    opt_allow_missing_template_keys
  | opt_dry_run
  | "--external-name" : "External name of service"
  | opt_field_manager
  | opt_output
  | opt_save_config
  | opt_show_managed_fields
  | opt_tcp
  | opt_template
  | opt_validate ;

create_service_loadbalancer_option =
    opt_allow_missing_template_keys
  | opt_dry_run
  | opt_field_manager
  | opt_output
  | opt_save_config
  | opt_show_managed_fields
  | opt_tcp
  | opt_template
  | opt_validate ;

create_service_nodeport_option =
    opt_allow_missing_template_keys
  | opt_dry_run
  | opt_field_manager
  | "--node-port" : "Port used to expose the service on each node in a cluster"
  | opt_output
  | opt_save_config
  | opt_show_managed_fields
  | opt_tcp
  | opt_template
  | opt_validate ;

create_service_command =
    "clusterip" : "Create a ClusterIP service" , { create_service_clusterip_option | global_option | @any }
  | "externalname" : "Create an ExternalName service" , { create_service_externalname_option | global_option | @any }
  | "loadbalancer" : "Create a LoadBalancer service" , { create_service_loadbalancer_option | global_option | @any }
  | "nodeport" : "Create a NodePort service" , { create_service_nodeport_option | global_option | @any } ;

create_token_option =
    opt_allow_missing_template_keys
  | "--audience" : "Audience of the requested token" , @any | "--audience=" : "Audience of the requested token" ~ @any
  | "--bound-object-kind" : "Kind of an object to bind the token to" , @any | "--bound-object-kind=" : "Kind of an object to bind the token to" ~ @any
  | "--bound-object-name" : "Name of an object to bind the token to" , @any | "--bound-object-name=" : "Name of an object to bind the token to" ~ @any
  | "--bound-object-uid" : "UID of an object to bind the token to" , @any | "--bound-object-uid=" : "UID of an object to bind the token to" ~ @any
  | "--duration" : "Requested lifetime of the issued token" , @any | "--duration=" : "Requested lifetime of the issued token" ~ @any
  | opt_output2
  | opt_show_managed_fields
  | opt_template2 ;

create_command =
    "clusterrole" : "Create a cluster role" , { create_clusterrole_option | global_option | @any }
  | "clusterrolebinding" : "Create a cluster role binding for a particular cluster role" , { create_clusterrolebinding_option | global_option | @any }
  | "configmap" : "Create a config map from a local file, directory or literal value" , { create_configmap_option | global_option | @any }
  | "cronjob" : "Create a cron job with the specified name" , { create_cronjob_option | global_option | @any } , [ "--" : "End of options, the command follows" , { @any } ]
  | "deployment" : "Create a deployment with the specified name" , { create_deployment_option | global_option | @any } , [ "--" : "End of options, the command follows" , { @any } ]
  | "ingress" : "Create an ingress with the specified name" , { create_ingress_option | global_option | @any }
  | "job" : "Create a job with the specified name" , { create_job_option | global_option | @any } , [ "--" : "End of options, the command follows" , { @any } ]
  | "namespace" : "Create a namespace with the specified name" , { create_namespace_option | global_option | @any }
  | "poddisruptionbudget" : "Create a pod disruption budget with the specified name" , { create_poddisruptionbudget_option | global_option | @any }
  | "priorityclass" : "Create a priority class with the specified name" , { create_priorityclass_option | global_option | @any }
  | "quota" : "Create a quota with the specified name" , { create_quota_option | global_option | @any }
  | "role" : "Create a role with single rule" , { create_role_option | global_option | @any }
  | "rolebinding" : "Create a role binding for a particular role or cluster role" , { create_rolebinding_option | global_option | @any }
  | "secret" : "Create a secret using a specified subcommand" , { global_option } , [ create_secret_command ]
  | "service" : "Create a service using a specified subcommand" , { global_option } , [ create_service_command ]
  | "serviceaccount" : "Create a service account with the specified name" , { create_namespace_option | global_option | @any }
  | "token" : "Request a service account token" , { create_token_option | global_option | @any } ;

create_option =
    opt_allow_missing_template_keys
  | opt_dry_run
  | "--edit" : "Edit the API resource before creating"
  | opt_field_manager2
  | "-f" : "Filename, directory, or URL to files to use to create the resource" , @file | "--filename" : "Filename, directory, or URL to files to use to create the resource" , @file | "--filename=" : "Filename, directory, or URL to files to use to create the resource" ~ @file
  | opt_kustomize
  | opt_output2
  | "--raw" : "Raw URI to POST to the server" , @any | "--raw=" : "Raw URI to POST to the server" ~ @any
  | opt_recursive
  | opt_save_config
  | opt_selector
  | opt_show_managed_fields
  | opt_template2
  | opt_validate
  | "--windows-line-endings" : "Only relevant if --edit=true" ;

expose_option =
    opt_allow_missing_template_keys
  | "--cluster-ip" : "ClusterIP to be assigned to the service" , @any | "--cluster-ip=" : "ClusterIP to be assigned to the service" ~ @any
  | opt_dry_run
  | "--external-ip" : "Additional external IP address to accept for the service" , @any | "--external-ip=" : "Additional external IP address to accept for the service" ~ @any
  | opt_field_manager2
  | opt_filename
  | opt_kustomize
  | "-l" : "Labels to apply to the service created by this call" , @any | "--labels" : "Labels to apply to the service created by this call" , @any | "--labels=" : "Labels to apply to the service created by this call" ~ @any
  | "--load-balancer-ip" : "IP to assign to the LoadBalancer" , @any | "--load-balancer-ip=" : "IP to assign to the LoadBalancer" ~ @any
  | opt_name
  | opt_output2
  | opt_override_type
  | opt_overrides
  | "--port" : "The port that the service should serve on" , @any | "--port=" : "The port that the service should serve on" ~ @any
  | "--protocol" : "The network protocol for the service to be created" , @any | "--protocol=" : "The network protocol for the service to be created" ~ @any
  | opt_recursive
  | opt_save_config
  | "--selector" : "A label selector to use for this service" , @any | "--selector=" : "A label selector to use for this service" ~ @any
  | "--session-affinity" : "If non-empty, set the session affinity for the service to this" , @any | "--session-affinity=" : "If non-empty, set the session affinity for the service to this" ~ @any
  | opt_show_managed_fields
  | "--target-port" : "Container port, by name or number, that receives the traffic" , @any | "--target-port=" : "Container port, by name or number, that receives the traffic" ~ @any
  | opt_template2
  | "--type" : "Service type: ClusterIP, NodePort, LoadBalancer or ExternalName" , @any | "--type=" : "Service type: ClusterIP, NodePort, LoadBalancer or ExternalName" ~ @any ;

run_option =
    opt_allow_missing_template_keys
  | "--annotations" : "Annotations to apply to the pod" , @any | "--annotations=" : "Annotations to apply to the pod" ~ @any
  | "--attach" : "Wait for the pod to start running, then attach to it"
  | opt_cascade
  | "--command" : "Use extra arguments as the container's command, not its args"
  | opt_dry_run
  | opt_env
  | "--expose" : "Create a ClusterIP service associated with the pod"
  | opt_field_manager2
  | "-f" : "To use to replace the resource" , @file | "--filename" : "To use to replace the resource" , @file | "--filename=" : "To use to replace the resource" ~ @file
  | opt_force
  | opt_grace_period
  | "--image" : "The image for the container to run" , @any | "--image=" : "The image for the container to run" ~ @any
  | opt_image_pull_policy
  | opt_kustomize2
  | "-l" : "Comma separated labels to apply to the pod" , @any | "--labels" : "Comma separated labels to apply to the pod" , @any | "--labels=" : "Comma separated labels to apply to the pod" ~ @any
  | "--leave-stdin-open" : "Leave stdin open after the first attach completes"
  | opt_output2
  | opt_override_type
  | opt_overrides
  | opt_pod_running_timeout
  | "--port" : "The port that this container exposes" , @any | "--port=" : "The port that this container exposes" ~ @any
  | "--privileged" : "Run the container in privileged mode"
  | "-q" : "Suppress prompt messages" | "--quiet" : "Suppress prompt messages"
  | opt_recursive
  | "--restart" : "The restart policy for this Pod" , @any | "--restart=" : "The restart policy for this Pod" ~ @any
  | "--rm" : "Delete the pod after it exits"
  | opt_save_config
  | opt_show_managed_fields
  | opt_stdin
  | opt_template2
  | opt_timeout
  | "-t" : "Allocate a TTY for the container in the pod" | "--tty" : "Allocate a TTY for the container in the pod"
  | opt_wait ;

set_env_option =
    opt_all
  | opt_allow_missing_template_keys
  | "-c" : "The names of containers in the selected pod templates to change" , @any | "--containers" : "The names of containers in the selected pod templates to change" , @any | "--containers=" : "The names of containers in the selected pod templates to change" ~ @any
  | opt_dry_run
  | "-e" : "Environment variable to set in each container, as key=value" , @any | "--env" : "Environment variable to set in each container, as key=value" , @any | "--env=" : "Environment variable to set in each container, as key=value" ~ @any
  | opt_field_manager2
  | "-f" : "Filename, directory, or URL to files the resource to update the env" , @file | "--filename" : "Filename, directory, or URL to files the resource to update the env" , @file | "--filename=" : "Filename, directory, or URL to files the resource to update the env" ~ @file
  | "--from" : "The name of a resource from which to inject environment variables" , @any | "--from=" : "The name of a resource from which to inject environment variables" ~ @any
  | "--keys" : "Comma-separated list of keys to import from specified resource" , @any | "--keys=" : "Comma-separated list of keys to import from specified resource" ~ @any
  | opt_kustomize
  | "--list" : "Display the environment and any changes in the standard format"
  | "--local" : "Set env will NOT contact api-server but run locally"
  | opt_output2
  | "--overwrite" : "Allow environment to be overwritten"
  | "--prefix" : "Prefix to append to variable names" , @any | "--prefix=" : "Prefix to append to variable names" ~ @any
  | opt_recursive
  | "--resolve" : "Show secret or configmap references when listing variables"
  | opt_selector
  | opt_show_managed_fields
  | opt_template2 ;

set_image_option =
    opt_all2
  | opt_allow_missing_template_keys
  | opt_dry_run
  | opt_field_manager2
  | opt_filename
  | opt_kustomize
  | "--local" : "Set image will NOT contact api-server but run locally"
  | opt_output2
  | opt_recursive
  | opt_selector
  | opt_show_managed_fields
  | opt_template2 ;

set_resources_option =
    opt_all2
  | opt_allow_missing_template_keys
  | "-c" : "Containers of the pod templates to change, wildcards allowed" , @any | "--containers" : "Containers of the pod templates to change, wildcards allowed" , @any | "--containers=" : "Containers of the pod templates to change, wildcards allowed" ~ @any
  | opt_dry_run
  | opt_field_manager2
  | opt_filename
  | opt_kustomize
  | "--limits" : "The resource requirement requests for this container" , @any | "--limits=" : "The resource requirement requests for this container" ~ @any
