  | "-f" : "The files that contain the configurations to apply" , @file | "--filename" : "The files that contain the configurations to apply" , @file | "--filename=" : "The files that contain the configurations to apply" ~ @file
  | opt_force
  | opt_force_conflicts
  | opt_grace_period
  | opt_kustomize2
