  | "stop" : "Stop a web app" , { webapp_stop_option }
  | "up" : "Create a webapp and deploy code from a local workspace to the app" , { webapp_up_option }
  | ( "auth" : "Manage webapp authentication and authorization"
  | "browse" : "Open a web app in a browser"
  | "connection" : "Commands to manage webapp connections"
  | "cors" : "Manage Cross-Origin Resource Sharing (CORS)"
  | "create-remote-connection" : "Creates a remote connection using a tcp tunnel to your web app"
  | "deleted" : "Manage deleted web apps"
  | "deployment" : "Manage web app deployments"
  | "exec" : "Open an interactive shell session or run a command in a Linux web app"
  | "hybrid-connection" : "Methods that list, add and remove hybrid-connections from webapps"
  | "identity" : "Manage web app's managed identity"
  | "list-instances" : "List all scaled out instances of a web app or web app slot"
  | "list-runtimes" : "List available built-in stacks which can be used for web apps"
  | "secure-build" : "Review open source vulnerabilities in a web app's packages"
  | "sitecontainers" : "Manage linux web apps sitecontainers"
  | "ssh" : "SSH command establishes a ssh session to the web container"
  | "traffic-routing" : "Manage traffic routing for web apps"
  | "troubleshoot" : "Diagnose common Linux web app problems"
  | "update" : "Update an existing web app"
  | "vnet-integration" : "Methods that list, add, and remove virtual network integrations"
  | "webjob" : "Allows management operations for webjobs on a web app" ) , rest
  | help ;

