(* az: Azure CLI 2.92.0, checked against `az --help`, `az <group> --help` and the
   argument definitions azure-cli loads for each command (mcr.microsoft.com/azure-cli).
   Every top-level group and command is listed. login, logout, account, group, vm, aks,
   acr, webapp, storage, keyvault, functionapp and network list all their subgroups and
   commands; the common commands of the main groups (create, list, show, delete, start,
   stop, update, ...) and of storage account/container/blob, keyvault secret, aks
   nodepool, acr repository and network vnet/subnet/nsg/rule/public-ip/nic/lb model their
   arguments: the required ones plus about a dozen of the most used (the spec format caps
   the source at 10000 tokens). Everything else takes any words. Preview and deprecated
   arguments are left out.

   Conventions:
   - Arguments come after the command. az takes `--name value` and `--name=value`;
     only the global arguments model the joined form.
   - Arguments with several values (--tags a=1 b=2) take any words that follow. *)

az = { early_global } , command | "--version" : "Show the versions of Azure CLI modules and extensions" | help ;

command =
    "account" : "Manage Azure subscription information" , [ account_command ]
  | "acr" : "Manage private registries with Azure Container Registries" , [ acr_command ]
  | "aks" : "Azure Kubernetes Service" , [ aks_command ]
  | "functionapp" : "Manage function apps" , [ functionapp_command ]
  | "group" : "Manage resource groups and template deployments" , [ group_command ]
  | "keyvault" : "Manage KeyVault keys, secrets, and certificates" , [ keyvault_command ]
  | "login" : "Log in to Azure" , { login_option }
  | "logout" : "Log out to remove access to Azure subscriptions" , { logout_option }
  | "network" : "Manage Azure Network resources" , [ network_command ]
  | "storage" : "Manage Azure Cloud Storage resources" , [ storage_command ]
  | "version" : "Show the versions of Azure CLI modules and extensions" , { version_option }
  | "vm" : "Manage Linux or Windows virtual machines" , [ vm_command ]
  | "webapp" : "Manage web apps" , [ webapp_command ]
  | ( "ad" : "Manage Microsoft Entra ID entities for Azure RBAC"
  | "advisor" : "Manage Azure Advisor"
  | "ams" : "Manage Azure Media Services resources"
  | "apim" : "Manage Azure API Management services"
  | "appconfig" : "Manage App Configurations"
  | "appservice" : "Manage Appservice"
  | "aro" : "Manage Azure Red Hat OpenShift clusters"
  | "backup" : "Manage Azure Backups"
  | "batch" : "Manage Azure Batch"
  | "bicep" : "Bicep CLI command group"
  | "billing" : "Manage Azure Billing"
  | "bot" : "Manage Microsoft Azure Bot Service"
  | "cache" : "Commands to manage CLI objects cached using the --defer argument"
  | "capacity" : "Manage capacity"
  | "cloud" : "Manage registered Azure clouds"
  | "cognitiveservices" : "Manage Azure Cognitive Services accounts"
  | "compute-fleet" : "Manage for Azure Compute Fleet"
  | "compute-recommender" : "Manage sku/zone/region recommender info for compute resources"
  | "config" : "Manage Azure CLI configuration"
  | "configure" : "Manage Azure CLI configuration"
  | "connection" : "Manage Service Connector local connections"
  | "consumption" : "Manage consumption of Azure resources"
  | "container" : "Manage Azure Container Instances"
  | "containerapp" : "Manage Azure Container Apps"
  | "cosmosdb" : "Manage Azure Cosmos DB database accounts"
  | "data-boundary" : "Data boundary operations"
  | "databoxedge" : "Manage device with databoxedge"
  | "deployment" : "Manage Azure Resource Manager template deployment at subscription"
  | "deployment-scripts" : "Manage deployment scripts at subscription or resource group scope"
  | "disk" : "Manage Azure Managed Disks"
  | "disk-access" : "Manage disk access resources"
  | "disk-encryption-set" : "Disk Encryption Set resource"
  | "dls" : "Manage Data Lake Store accounts and filesystems"
  | "dms" : "Manage Azure Data Migration Service (classic) instances"
  | "eventgrid" : "Manage Azure Event Grid topics, domains and event subscriptions"
  | "eventhubs" : "Manage Event Hub"
  | "extension" : "Manage and update CLI extensions"
  | "feature" : "Manage resource provider features"
  | "feedback" : "Send feedback to the Azure CLI Team"
  | "find" : "Ask an AI assistant for Azure CLI usage"
  | "hdinsight" : "Manage HDInsight resources"
  | "identity" : "Manage Managed Identity"
  | "image" : "Manage custom virtual machine images"
  | "interactive" : "Start interactive mode"
  | "iot" : "Manage Internet of Things (IoT) assets"
  | "lab" : "Manage azure devtest labs"
  | "lock" : "Manage Azure locks"
  | "logicapp" : "Manage logic apps"
  | "managed-cassandra" : "Azure Managed Cassandra"
  | "managedapp" : "Manage template solutions provided by ISVs"
  | "managedservices" : "Manage the registration assignments and definitions in Azure"
  | "maps" : "Manage Azure Maps"
  | "mariadb" : "Manage Azure Database for MariaDB servers"
  | "monitor" : "Manage the Azure Monitor Service"
  | "mysql" : "Manage Azure Database for MySQL servers"
  | "netappfiles" : "Manage Azure NetApp Files (ANF) Resources"
  | "policy" : "Manage resources defined and used by the Azure Policy service"
  | "postgres" : "Manage Azure Database for PostgreSQL"
  | "ppg" : "Manage Proximity Placement Groups"
  | "private-link" : "Private-link association CLI command group"
  | "provider" : "Manage resource providers"
  | "redis" : "Manage dedicated Redis caches for your Azure applications"
  | "relay" : "Manage Azure Relay namespaces, WCF relays and hybrid connections"
  | "resource" : "Manage Azure resources"
  | "resourcemanagement" : "Resourcemanagement CLI command group"
  | "rest" : "Invoke a custom request"
  | "restore-point" : "Manage restore point with res"
  | "role" : "Manage Azure role-based access control (Azure RBAC)"
  | "search" : "Manage Azure AI Search"
  | "security" : "Manage your security posture with Microsoft Defender for Cloud"
  | "servicebus" : "Manage Service Bus"
  | "sf" : "Manage and administer Azure Service Fabric clusters"
  | "sig" : "Manage shared image gallery"
  | "signalr" : "Manage Azure SignalR Service"
  | "snapshot" : "Manage point-in-time copies of managed disks and snapshots"
  | "sql" : "Manage Azure SQL Databases and Data Warehouses"
  | "sshkey" : "Manage ssh public key with vm"
  | "stack" : "Manage deployment stacks"
  | "stack-whatif" : "Preview operations on deployment stacks"
  | "staticwebapp" : "Manage static apps"
  | "survey" : "Take Azure CLI survey"
  | "synapse" : "Manage and operate Synapse Workspace, Spark Pool, SQL Pool"
  | "tag" : "Tag Management on a resource"
  | "term" : "Manage marketplace agreement with marketplaceordering"
  | "ts" : "Manage template specs at subscription or resource group scope"
  | "upgrade" : "Upgrade Azure CLI and extensions"
  | "vmss" : "Manage Virtual Machine Scale Sets" ) , rest ;

(* Global arguments every command accepts. --debug, --verbose and --only-show-errors also
   work before the command. *)
early_global =
    "--debug" : "Increase logging verbosity to show all debug logs"
  | "--verbose" : "Increase logging verbosity"
  | "--only-show-errors" : "Only show errors, suppressing warnings" ;
help = "-h" : "Show the help message" | "--help" : "Show the help message" ;
global =
    early_global | help
  | "--output" : "Output format" , output_format | "--output=" : "Output format" ~ output_format
  | "-o" : "Output format" , output_format
  | "--query" : "JMESPath query string" , @any | "--query=" : "JMESPath query string" ~ @any
  | "--subscription" : "Name or ID of the subscription" , @any
  | "--subscription=" : "Name or ID of the subscription" ~ @any ;
output_format = "json" : "JSON (default)" | "jsonc" : "Colored JSON" | "none" : "No output" | "table" : "ASCII table"
  | "tsv" : "Tab-separated values" | "yaml" : "YAML" | "yamlc" : "Colored YAML" ;
opt_ids = "--ids" : "One or more resource IDs, space separated" , @any , { @any } ;
(* Commands this spec does not model take any words. *)
rest = { @any } ;

account_get_access_token_option =
    opt_subscription
  | "--resource" : "Azure resource endpoints in Microsoft Entra v1.0" , @any
  | "--scope" : "Space-separated scopes in Microsoft Entra v2.0" , { @any }
  | "--resource-type" : "Type of well-known resource" , values_oss_rdbms_arm_aad_graph
  | ( "--tenant" : "Tenant ID for which the token is acquired" | "-t" : "Tenant ID for which the token is acquired" ) , @any
  | global ;

account_list_option =
    "--all" : "List all subscriptions from all clouds, including subscriptions"
  | "--refresh" : "Retrieve up-to-date subscriptions from server"
  | global ;

account_list_locations_option =
    "--include-extended-locations" : "Whether to include extended locations" , [ values_true_t_yes ]
  | global ;

account_set_option =
    opt_subscription
  | global ;

account_show_option =
    opt_subscription
  | global ;

account_command =
    "get-access-token" : "Get a token for utilities to access Azure" , { account_get_access_token_option }
  | "list" : "Get a list of subscriptions for the logged in account" , { account_list_option }
  | "list-locations" : "List supported regions for the current subscription" , { account_list_locations_option }
  | "set" : "Set a subscription to be the current active subscription" , { account_set_option }
  | "show" : "Get the details of a subscription" , { account_show_option }
  | ( "clear" : "Clear all subscriptions from the CLI's local cache"
  | "lock" : "Manage Azure subscription level locks"
  | "management-group" : "Manage Azure Management Groups" ) , rest
  | help ;

acr_build_option =
    ( "--registry" : "The name of the container registry" | "-r" : "The name of the container registry" ) , @any
  | ( "--image" : "The name and tag of the image using the format: '-t repo/image:tag'" | "-t" : "The name and tag of the image using the format: '-t repo/image:tag'" ) , @any
  | opt_resource_group
  | "--timeout" : "The timeout in seconds" , @any
  | "--build-arg" : "Build argument in '--build-arg name[=value]' format" , @any
  | "--secret-build-arg" : "Secret build argument in '--secret-build-arg name[=value]' format" , @any
  | ( "--file" : "The relative path of the the docker file to the source code root" | "-f" : "The relative path of the the docker file to the source code root" ) , @file
  | "--no-format" : "Indicates whether the logs should be displayed in raw format"
  | "--no-push" : "Indicates whether the image built should be pushed to the registry"
  | "--no-logs" : "Do not show logs after successfully queuing the build"
  | "--platform" : "The platform where build/task is run, Eg, 'windows' and 'linux'" , @any
  | "--target" : "The name of the target build stage" , @any
  | opt_ids
  | global ;

acr_create_option =
    ( "--name" : "The name of the container registry" | "-n" : "The name of the container registry" ) , @any
  | opt_resource_group
  | "--sku" : "The SKU of the container registry" , values_basic_standard_premium
  | ( "--location" : "Location: values from: az account list-locations" | "-l" : "Location: values from: az account list-locations" ) , @any
  | "--admin-enabled" : "Indicates whether the admin user is enabled" , [ values_true_false ]
  | opt_default_action
  | "--identity" : "Use assigned managed identity resource id or name if in the same" , @any
  | "--key-encryption-key" : "Azure Key Vault or Managed HSM key URI" , @any
  | "--public-network-enabled" : "Allow public network access for the container registry" , [ values_true_false ]
  | "--allow-trusted-services" : "Allow trusted Azure Services to access network restricted registries" , [ values_true_false ]
  | opt_tags_2
  | "--role-assignment-mode" : "Role assignment mode of the registry" , values_rbac_abac_rbac
  | opt_ids
  | global ;

acr_delete_option =
    ( "--name" : "The name of the container registry" | "-n" : "The name of the container registry" ) , @any
  | opt_resource_group
  | opt_yes
  | opt_ids
  | global ;

acr_list_option =
    opt_resource_group
  | opt_ids
  | global ;

acr_login_option =
    ( "--name" : "The name of the container registry" | "-n" : "The name of the container registry" ) , @any
  | opt_resource_group
  | opt_suffix
  | ( "--username" : "The username used to log into a container registry" | "-u" : "The username used to log into a container registry" ) , @any
  | ( "--password" : "The password used to log into a container registry" | "-p" : "The password used to log into a container registry" ) , @any
  | "--expose-token" : "Expose refresh token instead of automatically logging in through"
  | "-t" : "Expose refresh token instead of automatically logging in through"
  | opt_ids
  | global ;

acr_repository_delete_option =
    ( "--name" : "The name of the container registry" | "-n" : "The name of the container registry" ) , @any
  | opt_repository
  | ( "--image" : "The name of the image" | "-t" : "The name of the image" ) , @any
  | opt_suffix
  | ( "--username" : "The username used to log into a container registry" | "-u" : "The username used to log into a container registry" ) , @any
  | ( "--password" : "The password used to log into a container registry" | "-p" : "The password used to log into a container registry" ) , @any
  | opt_yes
  | opt_ids
  | global ;

acr_repository_list_option =
    ( "--name" : "The name of the container registry" | "-n" : "The name of the container registry" ) , @any
  | opt_top
  | opt_suffix
  | ( "--username" : "The username used to log into a container registry" | "-u" : "The username used to log into a container registry" ) , @any
  | ( "--password" : "The password used to log into a container registry" | "-p" : "The password used to log into a container registry" ) , @any
  | opt_ids
  | global ;

acr_repository_show_tags_option =
    ( "--name" : "The name of the container registry" | "-n" : "The name of the container registry" ) , @any
  | opt_repository
  | opt_top
  | "--orderby" : "Order the items in the results" , values_time_asc_time_desc
  | opt_suffix
  | ( "--username" : "The username used to log into a container registry" | "-u" : "The username used to log into a container registry" ) , @any
  | ( "--password" : "The password used to log into a container registry" | "-p" : "The password used to log into a container registry" ) , @any
  | "--detail" : "Show detailed information"
  | opt_ids
  | global ;

acr_repository_command =
    "delete" : "Delete a repository or image in an Azure Container Registry" , { acr_repository_delete_option }
  | "list" : "List repositories in an Azure Container Registry" , { acr_repository_list_option }
  | "show-tags" : "Show tags for a repository in an Azure Container Registry" , { acr_repository_show_tags_option }
  | ( "list-deleted" : "List soft-deleted repositories in an Azure Container Registry"
  | "show" : "Get the attributes of a repository or image in an Azure Container"
  | "show-manifests" : "Show manifests of a repository in an Azure Container Registry"
  | "untag" : "Untag an image in an Azure Container Registry"
  | "update" : "Update the attributes of a repository or image in an Azure Container" ) , rest
  | help ;

acr_show_option =
    ( "--name" : "The name of the container registry" | "-n" : "The name of the container registry" ) , @any
  | opt_resource_group
  | opt_ids
  | global ;

acr_command =
    "build" : "Queues a quick build, providing streaming logs for an Azure Container" , { acr_build_option }
  | "create" : "Create an Azure Container Registry" , { acr_create_option }
  | "delete" : "Deletes an Azure Container Registry" , { acr_delete_option }
  | "list" : "Lists all the container registries under the current subscription" , { acr_list_option }
  | "login" : "Log in to an Azure Container Registry through the Docker CLI" , { acr_login_option }
  | "repository" : "Manage repositories (image names) for Azure Container Registries" , [ acr_repository_command ]
  | "show" : "Get the details of an Azure Container Registry" , { acr_show_option }
  | ( "agentpool" : "Manage private Tasks agent pools with Azure Container Registries"
  | "artifact-streaming" : "Manage artifact streaming for any repositories or supported images"
  | "cache" : "Manage cache rules in Azure Container Registries"
  | "check-health" : "Gets health information on the environment and optionally a target"
  | "check-name" : "Checks if an Azure Container Registry name is valid and available"
  | "config" : "Configure policies for Azure Container Registries"
  | "connected-registry" : "Manage connected registry resources with Azure Container Registries"
  | "credential" : "Manage login credentials for Azure Container Registries"
  | "credential-set" : "Manage credential sets in Azure Container Registries"
  | "encryption" : "Manage customer-managed encryption for a container registry"
  | "helm" : "Manage helm charts for Azure Container Registries"
  | "identity" : "Manage service (managed) identities for a container registry"
  | "import" : "Imports an image to an Azure Container Registry from another"
  | "manifest" : "Manage artifact manifests in Azure Container Registries"
  | "network-rule" : "Manage network rules for Azure Container Registries"
  | "pack" : "Manage Azure Container Registry Tasks that use Cloud Native"
  | "private-endpoint-connection" : "Manage container registry private endpoint connections"
  | "private-link-resource" : "Manage registry private link resources"
  | "replication" : "Manage geo-replicated regions of Azure Container Registries"
  | "run" : "Queues a quick run providing streamed logs for an Azure Container"
  | "scope-map" : "Manage scope access maps for Azure Container Registries"
  | "show-endpoints" : "Display registry endpoints including data endpoints and regional"
  | "show-usage" : "Get the storage usage for an Azure Container Registry"
  | "task" : "Manage a collection of steps for building, testing and OS & Framework"
  | "taskrun" : "Manage taskruns using Azure Container Registries"
  | "token" : "Manage tokens for an Azure Container Registry"
  | "update" : "Update an Azure Container Registry"
  | "webhook" : "Manage webhooks for Azure Container Registries" ) , rest
  | help ;

aks_create_option =
    opt_resource_group
  | ( "--name" : "Name of the managed cluster" | "-n" : "Name of the managed cluster" ) , @any
  | "--ssh-key-value" : "Public key path or key contents to install on node VMs for SSH access" , @any
  | ( "--location" : "Location: values from: az account list-locations" | "-l" : "Location: values from: az account list-locations" ) , @any
  | ( "--kubernetes-version" : "Version of Kubernetes to use for creating the cluster, such" | "-k" : "Version of Kubernetes to use for creating the cluster, such" ) , @any
  | opt_tags_2
  | opt_generate_ssh_keys
  | opt_network_plugin
  | "--network-policy" : "Network Policy Engine to use" , @any
  | opt_tier
  | "--enable-private-cluster" : "Enable private cluster"
  | "--enable-managed-identity" : "Using a system assigned managed identity to manage cluster resource"
  | opt_enable_azure_rbac
  | opt_enable_oidc_issuer
  | "--attach-acr" : "Grant the 'acrpull' role assignment to the ACR specified by name" , @any
  | opt_enable_workload_identity
  | ( "--enable-addons" : "Enable the Kubernetes addons in a comma-separated list" | "-a" : "Enable the Kubernetes addons in a comma-separated list" ) , @any
  | opt_node_vm_size
  | "--os-sku" : "The OS SKU of the agent node pool" , values_azurelinux_azurelinux3_azurecontainerlin
  | "--vnet-subnet-id" : "The ID of a subnet in an existing VNet into which to deploy" , @any
  | "--enable-cluster-autoscaler" : "Enable cluster autoscaler, default value is false"
  | opt_min_count
  | opt_max_count
  | ( "--node-count" : "Number of nodes in the Kubernetes node pool" | "-c" : "Number of nodes in the Kubernetes node pool" ) , @any
  | opt_zones_1
  | opt_yes
  | "--no-wait" : "Do not wait for the long-running operation to finish"
  | opt_ids
  | global ;

aks_delete_option =
    opt_resource_group
  | ( "--name" : "Name of the managed cluster" | "-n" : "Name of the managed cluster" ) , @any
  | "--if-match" : "The value provided will be compared to the ETag of the managed" , @any
  | "--if-none-match" : "Set to '*' to allow deleting a cluster only if it exists" , @any
  | opt_yes
  | "--no-wait" : "Do not wait for the long-running operation to finish"
  | opt_ids
  | global ;

aks_get_credentials_option =
    opt_resource_group
  | ( "--name" : "Name of the managed cluster" | "-n" : "Name of the managed cluster" ) , @any
  | "--admin" : "Get cluster administrator credentials"
  | "-a" : "Get cluster administrator credentials"
  | ( "--file" : "Kubernetes configuration file to update" | "-f" : "Kubernetes configuration file to update" ) , @file
  | "--overwrite-existing" : "Overwrite any existing cluster entry with the same name"
  | "--context" : "If specified, overwrite the default context name" , @any
  | "--public-fqdn" : "Get private cluster credential with server address to be public fqdn"
  | "--format" : "Specify the format of the returned credential" , @any
  | opt_ids
  | global ;

aks_list_option =
    opt_resource_group
  | opt_ids
  | global ;

aks_nodepool_add_option =
    opt_resource_group
  | opt_cluster_name
  | opt_nodepool_name_1
  | ( "--kubernetes-version" : "Version of Kubernetes to use for creating the cluster, such" | "-k" : "Version of Kubernetes to use for creating the cluster, such" ) , @any
  | opt_node_vm_size
  | "--os-type" : "The OS Type: linux or Windows" , @any
  | "--os-sku" : "The OS SKU of the agent node pool" , values_azurelinux_azurelinux3_azurecontainerlin_2
  | opt_enable_cluster_autoscaler
  | opt_min_count
  | opt_max_count
  | ( "--node-count" : "Number of nodes in the Kubernetes agent pool" | "-c" : "Number of nodes in the Kubernetes agent pool" ) , @any
  | "--priority" : "The priority of the node pool" , values_regular_spot
  | "--labels" : "The node labels for the node pool" , { @any }
  | "--node-taints" : "The node taints for the node pool" , @any
  | "--mode" : "The mode for a node pool which defines a node pool's primary function" , values_system_user_gateway
  | opt_max_pods
  | opt_zones_1
  | "--no-wait" : "Do not wait for the long-running operation to finish"
  | opt_ids
  | global ;

aks_nodepool_delete_option =
    opt_resource_group
  | opt_cluster_name
  | opt_nodepool_name_1
  | "--if-match" : "The value provided will be compared to the ETag of the node" , @any
  | "--ignore-pdb" : "Delete an existing nodepool without considering Pod Disruption Budget"
  | "-i" : "Delete an existing nodepool without considering Pod Disruption Budget"
  | "--no-wait" : "Do not wait for the long-running operation to finish"
  | opt_ids
  | global ;

aks_nodepool_list_option =
    opt_resource_group
  | opt_cluster_name
  | opt_ids
  | global ;

aks_nodepool_scale_option =
    opt_resource_group
  | opt_cluster_name
  | opt_nodepool_name_1
  | ( "--node-count" : "Number of nodes in the Kubernetes node pool" | "-c" : "Number of nodes in the Kubernetes node pool" ) , @any
  | "--no-wait" : "Do not wait for the long-running operation to finish"
  | opt_ids
  | global ;

aks_nodepool_command =
    "add" : "Add a node pool to the managed Kubernetes cluster" , { aks_nodepool_add_option }
  | "delete" : "Delete the agent pool in the managed Kubernetes cluster" , { aks_nodepool_delete_option }
  | "list" : "List node pools in the managed Kubernetes cluster" , { aks_nodepool_list_option }
  | "scale" : "Scale the node pool in a managed Kubernetes cluster" , { aks_nodepool_scale_option }
  | ( "auto-scale" : "Commands to manage nodepool virtualMachinesProfile.scale.autoscale"
  | "delete-machines" : "Delete specific machines in an agentpool for a managed cluster"
  | "get-rollback-versions" : "Get the available rollback versions for an agent pool of the managed"
  | "get-upgrades" : "Get the available upgrade versions for an agent pool of the managed"
  | "manual-scale" : "Commands to manage nodepool virtualMachinesProfile.scale.manual"
  | "operation-abort" : "Abort last running operation on nodepool"
  | "rollback" : "Rollback an agent pool to the most recently used configuration (N-1)"
  | "show" : "Show the details for a node pool in the managed Kubernetes cluster"
  | "snapshot" : "Commands to manage nodepool snapshots"
  | "start" : "Start stopped agent pool in the managed Kubernetes cluster"
  | "stop" : "Stop running agent pool in the managed Kubernetes cluster"
  | "update" : "Update a node pool properties"
  | "upgrade" : "Upgrade the node pool in a managed Kubernetes cluster"
  | "wait" : "Wait for a node pool to reach a desired state" ) , rest
  | help ;

aks_scale_option =
    opt_resource_group
  | ( "--name" : "Name of the managed cluster" | "-n" : "Name of the managed cluster" ) , @any
  | ( "--node-count" : "Number of nodes in the Kubernetes node pool" | "-c" : "Number of nodes in the Kubernetes node pool" ) , @any
  | opt_nodepool_name_2
  | "--no-wait" : "Do not wait for the long-running operation to finish"
  | opt_ids
  | global ;

aks_show_option =
    opt_resource_group
  | ( "--name" : "Name of the managed cluster" | "-n" : "Name of the managed cluster" ) , @any
  | opt_ids
  | global ;

aks_start_option =
    opt_resource_group
  | ( "--name" : "Name of the managed cluster" | "-n" : "Name of the managed cluster" ) , @any
  | "--no-wait" : "Do not wait for the long-running operation to finish"
  | opt_ids
  | global ;

aks_stop_option =
    opt_resource_group
