@PACKAGE_INIT@

# Sources are portable; the compiled archive and its diagnostics layout are not.
# Consumers rebuild BMIs locally with the matching compiler/configuration.
if(NOT CMAKE_BUILD_TYPE STREQUAL "@CMAKE_BUILD_TYPE@")
  message(FATAL_ERROR "This telar-base archive was built as @CMAKE_BUILD_TYPE@; configure the consumer with that build type or rebuild the package")
endif()
if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "@CMAKE_CXX_COMPILER_ID@" OR
   NOT CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL "@CMAKE_CXX_COMPILER_VERSION@")
  message(FATAL_ERROR "This telar-base archive requires @CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@; rebuild it for your toolchain")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/telar-base-targets.cmake")
check_required_components(telar-base)
