# clang-tidy 23.1.5 crashes (SIGSEGV) in unchecked-optional-access on module
# units that import std; re-enable it once the pinned LLVM fixes it.
InheritParentConfig: false
Checks: >-
  -*,
  clang-analyzer-*,
  bugprone-*,
  -bugprone-unchecked-optional-access,
  performance-*,
  portability-*,
  modernize-*,
  -modernize-use-trailing-return-type
WarningsAsErrors: '*'
HeaderFilterRegex: '.*'
ExcludeHeaderFilterRegex: '(^|/)(out|build[^/]*|cmake-build[^/]*|vendor|third_party|generated)/'
SystemHeaders: false
FormatStyle: file
