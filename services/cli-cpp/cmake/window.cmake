if(NOT TARGET telar-config)
  add_subdirectory("${CMAKE_CURRENT_LIST_DIR}/../../../dlls/telar-config" "${CMAKE_BINARY_DIR}/telar-config")
endif()
if(NOT TARGET ghostty-vt)
  set(GHOSTTY_VT_ROOT "" CACHE PATH "Installed libghostty-vt prefix for configuration icon validation")
  find_path(GHOSTTY_VT_INCLUDE_DIR ghostty/vt.h HINTS "${GHOSTTY_VT_ROOT}/include" REQUIRED)
  find_library(GHOSTTY_VT_LIBRARY NAMES libghostty-vt.a HINTS "${GHOSTTY_VT_ROOT}/lib" REQUIRED)
  add_library(ghostty-vt UNKNOWN IMPORTED)
  set_target_properties(ghostty-vt PROPERTIES IMPORTED_LOCATION "${GHOSTTY_VT_LIBRARY}" INTERFACE_INCLUDE_DIRECTORIES "${GHOSTTY_VT_INCLUDE_DIR}")
endif()
file(READ "${CMAKE_CURRENT_LIST_DIR}/../config/bootstrap.lua" TELAR_WINDOW_CONFIG_BOOTSTRAP)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/../config/bootstrap.lua")
configure_file("${CMAKE_CURRENT_LIST_DIR}/../config/bootstrap.hpp.in" "${CMAKE_CURRENT_BINARY_DIR}/generated/window_config_bootstrap.hpp" @ONLY)
target_sources(telar PRIVATE window.cpp)
add_executable(telar-config-check config_check_main.cpp config_check.cpp)
target_include_directories(telar-config-check PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated")
target_link_libraries(telar-config-check PRIVATE cli-core telar::config ghostty-vt)
set_target_properties(telar-config-check PROPERTIES RUNTIME_OUTPUT_DIRECTORY "$<TARGET_FILE_DIR:telar>")
add_dependencies(telar telar-config-check)
install(TARGETS telar-config-check RUNTIME DESTINATION bin)
