function(read_integration_asset output path)
  set(source "${CMAKE_CURRENT_SOURCE_DIR}/../../src/cli/${path}")
  file(READ "${source}" contents)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
  set(${output} "${contents}" PARENT_SCOPE)
endfunction()

read_integration_asset(TELAR_PI_INTEGRATION integration/pi.ts)
read_integration_asset(TELAR_OPENCODE_INTEGRATION integration/opencode.ts)
read_integration_asset(TELAR_AGENT_SKILL skill/telar.md)
read_integration_asset(TELAR_COORDINATOR_SKILL skill/coordinator.md)
configure_file(integration/assets.hpp.in "${CMAKE_CURRENT_BINARY_DIR}/generated/integration_assets.hpp" @ONLY)
