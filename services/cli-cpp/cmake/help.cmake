# Embeds help/*.txt, the texts `telar --help` and `telar FAMILY [COMMAND] --help` print:
# help/telar.txt is the root, help/FAMILY.txt a family and help/FAMILY/COMMAND.txt a command.
file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/../../../VERSION" telar_repository_version LIMIT_COUNT 1)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/../../../VERSION")
set(TELAR_VERSION "${telar_repository_version}" CACHE STRING "Version telar --version and the root help print")
set(help_directory "${CMAKE_CURRENT_SOURCE_DIR}/help")
file(GLOB_RECURSE help_files RELATIVE "${help_directory}" CONFIGURE_DEPENDS "${help_directory}/*.txt")
list(SORT help_files)
set(help_delimiter "TelarHelp")
set(TELAR_HELP_ENTRIES "")
foreach(help_file IN LISTS help_files)
  file(READ "${help_directory}/${help_file}" help_text)
  string(REPLACE "@TELAR_VERSION@" "${TELAR_VERSION}" help_text "${help_text}")
  string(FIND "${help_text}" ")${help_delimiter}\"" delimiter_found)
  if(NOT delimiter_found EQUAL -1)
    message(FATAL_ERROR "${help_file} contains the raw string delimiter ${help_delimiter}")
  endif()

  string(REGEX REPLACE "\\.txt$" "" help_topic "${help_file}")
  if(help_topic STREQUAL "telar")
    set(help_family "")
    set(help_command "")
  elseif(help_topic MATCHES "^([a-z-]+)/([a-z-]+)$")
    set(help_family "${CMAKE_MATCH_1}")
    set(help_command "${CMAKE_MATCH_2}")
  elseif(help_topic MATCHES "^[a-z-]+$")
    set(help_family "${help_topic}")
    set(help_command "")
  else()
    message(FATAL_ERROR "Unexpected help file ${help_file}")
  endif()

  string(APPEND TELAR_HELP_ENTRIES "    HelpText{.family = \"${help_family}\", .command = \"${help_command}\", .text = R\"${help_delimiter}(${help_text})${help_delimiter}\"},\n")
endforeach()

configure_file(help_texts.hpp.in "${CMAKE_CURRENT_BINARY_DIR}/generated/help_texts.hpp" @ONLY)
