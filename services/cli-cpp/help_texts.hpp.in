#pragma once

#include <array>
#include <string_view>

namespace telar::runtime::cli {

// One help text: the root has no family, a family no command.
struct HelpText {
  std::string_view family;
  std::string_view command;
  std::string_view text;
};

inline constexpr std::string_view version = "@TELAR_VERSION@";

inline constexpr std::array help_texts{
@TELAR_HELP_ENTRIES@};

}
