InheritParentConfig: false
Checks: >-
  *,
  -abseil-*,
  -altera-*,
  -android-*,
  -boost-*,
  -fuchsia-*,
  -google-*,
  -linuxkernel-*,
  -llvm-*,
  -llvmlibc-*,
  -modernize-use-equals-default,
  -modernize-use-trailing-return-type,
  -mpi-*,
  -objc-*,
  -openmp-*,
  -zircon-*
ExtraArgs:
  - -Weverything
  - -Wno-c++98-compat
  - -Wno-c++98-compat-pedantic
  - -Wno-c++11-compat
  - -Wno-c++14-compat
  - -Wno-c++17-compat
  - -Wno-c++20-compat
WarningsAsErrors: ''
HeaderFilterRegex: '(^|/)(services/runtime-cpp|dlls/telar-(base|lua|platform|plugins|config))/'
ExcludeHeaderFilterRegex: '(^|/)(dependencies|generated|out[^/]*|tests|third_party|vendor)/'
SystemHeaders: false
