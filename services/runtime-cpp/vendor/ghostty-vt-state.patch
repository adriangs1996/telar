+pub fn page_bytes(terminal_: Terminal, out_bytes: ?*usize) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    const output = out_bytes orelse return .invalid_value;
+    var total: usize = 0;
+    for (std.enums.values(ScreenSet.Key)) |key| {
+        if (wrapper.terminal.screens.get(key)) |screen| {
+            total +|= screen.pages.page_size;
+        }
+    }
+
+    output.* = total;
+    return .success;
+}
