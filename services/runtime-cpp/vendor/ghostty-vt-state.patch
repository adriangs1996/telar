 }
 
+pub fn grid_ref_cells(ref: *const CGridRef, out: *cell_c.CellsView) callconv(lib.calling_conv) Result {
+    const pin = ref.toPin() orelse return .invalid_value;
+    const terminal_page = pin.node.page();
+    if (pin.y >= terminal_page.size.rows or pin.x >= terminal_page.size.cols) {
+        return .invalid_value;
+    }
+
+    const cells = terminal_page.getCells(terminal_page.getRow(pin.y));
+    out.* = .{
+        .ptr = @ptrCast(cells.ptr),
+        .len = cells.len,
+    };
+    return .success;
+}
+
+const GraphemeBatch = extern struct {
+    points: ?[*]u32,
+    capacity: usize,
+    length: usize,
+    consumed_columns: usize,
+};
+
+pub fn grid_ref_grapheme_batch(ref: *const CGridRef, columns_: ?[*]const u16, count: usize, out: *GraphemeBatch) callconv(lib.calling_conv) Result {
+    out.length = 0;
+    out.consumed_columns = 0;
+    const pin = ref.toPin() orelse return .invalid_value;
+    const terminal_page = pin.node.page();
+    if (pin.y >= terminal_page.size.rows or pin.x >= terminal_page.size.cols) {
+        return .invalid_value;
+    }
+    if (count == 0) {
+        return .success;
+    }
+    if (out.capacity != 0 and out.points == null) {
+        return .invalid_value;
+    }
+
+    const columns = (columns_ orelse return .invalid_value)[0..count];
+    const points_ = out.points;
+    const capacity = out.capacity;
+    const cells = terminal_page.getCells(terminal_page.getRow(pin.y));
+    var length: usize = 0;
+    for (columns, 0..) |column, index| {
+        if (column >= cells.len) {
+            return .invalid_value;
+        }
+        const cell = &cells[column];
+        if (cell.hasGrapheme()) {
+            const extra = terminal_page.lookupGrapheme(cell) orelse return .invalid_value;
+            if (extra.len > capacity - length) {
+                out.length = length;
+                out.consumed_columns = index;
+                return .out_of_space;
+            }
+            if (extra.len != 0) {
+                const points = points_ orelse return .out_of_space;
+                const vector_lanes = 4;
+                var point_index: usize = 0;
+                while (extra.len - point_index >= vector_lanes) : (point_index += vector_lanes) {
+                    const values: @Vector(vector_lanes, u21) = extra[point_index..][0..vector_lanes].*;
+                    const normalized: @Vector(vector_lanes, u32) = values;
+                    points[length + point_index ..][0..vector_lanes].* = normalized;
+                }
+
+                for (extra[point_index..], point_index..) |codepoint, tail_index| {
+                    points[length + tail_index] = codepoint;
+                }
+                length += extra.len;
+            }
+        }
+    }
+
+    out.length = length;
+    out.consumed_columns = count;
+    return .success;
+}
