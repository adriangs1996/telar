+pub fn grid_ref_hyperlink(ref: *const CGridRef, uri: *lib.String, explicit_id: *lib.String, implicit_id: *u64) callconv(lib.calling_conv) Result {
+    const pin = ref.toPin() orelse return .invalid_value;
+    const terminal_page = pin.node.page();
+    const cell = pin.rowAndCell().cell;
+    const id = terminal_page.lookupHyperlink(cell) orelse return .no_value;
+    const entry = terminal_page.hyperlink_set.get(terminal_page.memory, id);
+    const bytes = entry.uri.slice(terminal_page.memory);
+    uri.* = .{ .ptr = bytes.ptr, .len = bytes.len };
+
+    switch (entry.id) {
+        .implicit => |value| {
+            explicit_id.* = .{ .ptr = "", .len = 0 };
+            implicit_id.* = value;
+        },
+        .explicit => |value| {
+            const text = value.slice(terminal_page.memory);
+            explicit_id.* = .{ .ptr = text.ptr, .len = text.len };
+            implicit_id.* = 0;
+        },
+    }
+
+    return .success;
+}
