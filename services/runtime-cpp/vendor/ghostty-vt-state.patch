+test "page bytes include both screens without changing the viewport" {
+    var terminal: Terminal = null;
+    try testing.expectEqual(Result.success, new(&lib.alloc.test_allocator, &terminal, 80, 24));
+    defer free(terminal);
+
+    var allocated: usize = 0;
+    try testing.expectEqual(Result.invalid_value, page_bytes(null, &allocated));
+    try testing.expectEqual(Result.invalid_value, page_bytes(terminal, null));
+    try testing.expectEqual(Result.success, page_bytes(terminal, &allocated));
+    const primary = terminal.?.terminal.screens.get(.primary).?;
+    try testing.expectEqual(primary.pages.page_size, allocated);
+    try testing.expect(allocated > 0);
+
+    const alternate = "\x1b[?1049h";
+    vt_write(terminal, alternate.ptr, alternate.len);
+    const active = terminal.?.terminal.screens.active;
+    const alternate_bytes = active.pages.page_size;
+    try testing.expectEqual(Result.success, page_bytes(terminal, &allocated));
+    try testing.expectEqual(primary.pages.page_size + alternate_bytes, allocated);
+    try testing.expectEqual(active, terminal.?.terminal.screens.active);
+}
