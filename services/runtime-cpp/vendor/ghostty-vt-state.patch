+pub const ImageInsert = extern struct {
+    size: usize,
+    image_id: u32,
+    width: u32,
+    height: u32,
+    format: ImageFormat,
+    data: ?[*]const u8,
+    data_len: usize,
+};
+
+pub fn image_insert(terminal_: terminal_c.Terminal, image: *const ImageInsert) callconv(lib.calling_conv) Result {
+    if (comptime !build_options.kitty_graphics) return .no_value;
+    const wrapper = terminal_ orelse return .invalid_value;
+    if (image.size != @sizeOf(ImageInsert) or image.image_id == 0 or image.width == 0 or image.height == 0 or image.data_len == 0) return .invalid_value;
+    if (image.format != .rgb and image.format != .rgba) return .invalid_value;
+    const data = image.data orelse return .invalid_value;
+    const terminal = wrapper.terminal;
+    const screen = terminal.screens.active;
+    screen.kitty_images.addImage(wrapper.io.io(), terminal.gpa(), screen, .{
+        .id = image.image_id,
+        .width = image.width,
+        .height = image.height,
+        .format = image.format,
+        .data = .{ .complete = data[0..image.data_len] },
+    }) catch return .out_of_memory;
+    return .success;
+}
+
+pub fn image_iterator_free(iter_: ImageIterator) callconv(lib.calling_conv) void {
+    if (comptime !build_options.kitty_graphics) return;
+    const iterator = iter_ orelse return;
+    iterator.alloc.destroy(iterator);
+}
+
+pub fn image_next(iter_: ImageIterator) callconv(lib.calling_conv) ImageHandle {
+    if (comptime !build_options.kitty_graphics) return null;
+    const iterator = iter_ orelse return null;
+    const entry = iterator.inner.next() orelse return null;
+    return entry.value_ptr;
+}
+
+pub fn loading_abort(terminal_: terminal_c.Terminal) callconv(lib.calling_conv) Result {
+    if (comptime !build_options.kitty_graphics) return .no_value;
+    const wrapper = terminal_ orelse return .invalid_value;
+    const storage = &wrapper.terminal.screens.active.kitty_images;
+    const loading = storage.loading orelse return .no_value;
+    loading.destroy(wrapper.terminal.gpa());
+    storage.loading = null;
+    return .success;
+}
+
+pub fn image_ids(graphics_: KittyGraphics, ids: ?[*]u32, capacity: usize, count: *usize) callconv(lib.calling_conv) Result {
+    if (comptime !build_options.kitty_graphics) return .no_value;
+    count.* = graphics_.images.count();
+    const output = ids orelse return if (capacity == 0) .success else .invalid_value;
+    var iterator = graphics_.images.keyIterator();
+    var index: usize = 0;
+    while (index < capacity) : (index += 1) {
+        const key = iterator.next() orelse break;
+        output[index] = key.*;
+    }
+    return .success;
+}
+
+pub fn image_remove(terminal_: terminal_c.Terminal, image_id: u32) callconv(lib.calling_conv) Result {
+    if (comptime !build_options.kitty_graphics) return .no_value;
+    const wrapper = terminal_ orelse return .invalid_value;
+    const terminal = wrapper.terminal;
+    terminal.screens.active.kitty_images.delete(wrapper.io.io(), terminal.gpa(), terminal, .{ .id = .{ .image_id = image_id, .placement_id = 0, .delete = true } });
+    return .success;
+}
+
+pub fn placement_remove(iter_: PlacementIterator, terminal_: terminal_c.Terminal) callconv(lib.calling_conv) Result {
+    if (comptime !build_options.kitty_graphics) return .no_value;
+    const wrapper = terminal_ orelse return .invalid_value;
+    const iter = iter_ orelse return .invalid_value;
+    const entry = iter.entry orelse return .invalid_value;
+    const screen = wrapper.terminal.screens.active;
+    const storage = &screen.kitty_images;
+    const image = storage.images.getPtr(entry.key_ptr.image_id) orelse return .invalid_value;
+    entry.value_ptr.deinit(screen);
+    image.metadata.placement_count -= 1;
+    storage.placements.removeByPtr(entry.key_ptr);
+    storage.markMutated(wrapper.io.io());
+    iter.entry = null;
+    return .success;
+}
